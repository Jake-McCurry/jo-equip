{
  "name": "@workspace/discipleship-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "pnpm run validate:knowing-god && node scripts/check-book-gate-parity.mjs && astro build && node scripts/apply-external-link-nofollow.mjs && node scripts/build-sitemaps.mjs",
    "serve": "astro preview --host 0.0.0.0",
    "typecheck": "astro check",
    "test:nofollow": "node --test scripts/external-link-policy.test.mjs",
    "test:knowing-god": "node --test scripts/knowing-god-regressions.test.mjs",
    "generate:knowing-god": "python3 scripts/generate-knowing-god.py",
    "validate:knowing-god": "python3 scripts/generate-knowing-god.py --validate-only && pnpm run test:knowing-god"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "5.0.3",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro": "6.1.10",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro-pagefind": "^1.8.6",
    "entities": "6.0.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.34.5"
  }
}
