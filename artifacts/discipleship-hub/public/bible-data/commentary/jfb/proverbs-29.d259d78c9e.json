{"e":[[20029001,20029001,[["p",["Pr 29:1-27",0,20029001,20029027],"."],["p",["1. hardeneth ... neck--",2],"obstinately refuses counsel (",["2Ki 17:14",0,12017014],"; ",["Ne 9:16",0,16009016],")."],["p",["destroyed--",2],"literally, \"shivered\" or \"utterly broken to pieces.\""],["p",["without remedy--",2],"literally, \"without healing\" or repairing."]]],[20029002,20029002,[["p","2. (Compare ",["Pr 11:10",0,20011010],"; ",["28:28",0,20028028],")."],["p",["in authority--",2],"(Compare Margin), increased in power."]]],[20029003,20029003,[["p","3. (Compare ",["Pr 4:6",0,20004006],", ",["7",0,20004007],"; ",["10:1",0,20010001],", &c.)."]]],[20029004,20029004,[["p",["4. by judgment--",2],"that is, righteous decisions, opposed to those procured by gifts (compare ",["Pr 28:21",0,20028021],"), by which good government is perverted."],["p",["land--",2],"for nation."]]],[20029005,20029005,[["p","5. (Compare ",["Pr 26:28",0,20026028],")."],["p",["spreadeth ... feet--",2],"By misleading him as to his real character, the flatterer brings him to evil, prepared by himself or others."]]],[20029006,20029006,[["p",["6. In--",2],"or, \"By\""],["p",["the transgression--",2],"he is brought into difficulty (",["Pr 12:13",0,20012013],"), but the righteous go on prospering, and so sing or rejoice."]]],[20029007,20029007,[["p",["7. considereth--",2],"literally, \"knows,\" as ",["Psa 1:6",0,19001006],"."],["p",["the cause--",2],"that is, in courts of justice (compare ",["Pr 29:14",0,20029014],"). The voluntary neglect of it by the wicked (",["Pr 28:27",0,20028027],") occasions oppression."]]],[20029008,20029008,[["p",["8. Scornful men--",2],"those who contemptuously disregard God's law."],["p",["bring--",2],"(Compare Margin), kindle strife."],["p",["turn away wrath--",2],"that is, \"abate wrath.\""]]],[20029009,20029009,[["p",["9. contendeth--",2],"that is, in law."],["p",["whether ... laugh--",2],"The fool, whether angry or good-humored, is unsettled; or referring the words to the wise man, the sense is, that all his efforts, severe or gentle, are unavailing to pacify the fool."]]],[20029010,20029010,[["p",["10. bloodthirsty--",2],"(Compare Margin), murderers (",["Psa 5:6",0,19005006],"; ",["26:9",0,19026009],")."],["p",["hate, &c.--",2],"(",["Pr 1:11",0,20001011],"; ",["Ge 3:4",0,1003004],")."],["p",["seek ... soul--",2],"that is, to preserve it."]]],[20029011,20029011,[["p","11. (Compare ",["Pr 12:16",0,20012016],"; ",["16:32",0,20016032],")."],["p",["mind--",2],"or, \"spirit,\" for anger or any ill passion which the righteous restrain."]]],[20029012,20029012,[["p","12. His servants imitate him."]]],[20029013,20029013,[["p","13. (Compare ",["Pr 22:2",0,20022002],")."],["p",["deceitful man--",2],"literally, \"man of vexations,\" an exactor."],["p",["the Lord ... their eyes--",2],"sustains their lives (",["1Sa 14:27",0,9014027],"; ",["Psa 13:3",0,19013003],"); that is, both depend on Him, and He will do justice."]]],[20029014,20029014,[["p","14. (Compare ",["Pr 20:28",0,20020028],"; ",["25:5",0,20025005],"). Such is the character of the King of kings (",["Psa 72:4",0,19072004],", ",["12",0,19072012],")."]]],[20029015,20029015,[["p","15. (Compare ",["Pr 13:24",0,20013024],"; ",["23:13",0,20023013],")."]]],[20029016,20029016,[["p","16. (Compare ",["Pr 29:2",0,20029002],", ",["12",0,20029012],"; ",["Psa 12:1-8",0,19012001,19012008],")."],["p",["shall see ... fall--",2],"and triumph in it (Psa 37:34-38; 58:",["10, 11",0,19010011],")."]]],[20029017,20029017,[["p","17. (Compare ",["Pr 29:3",0,20029003],", ",["15",0,20029015],"; ",["Pr 19:18",0,20019018],")."],["p",["give thee rest--",2],"peace and quiet (compare ",["Pr 29:9",0,20029009],")."]]],[20029018,20029018,[["p",["18. no vision--",2],"instruction in God's truth, which was by prophets, through visions (",["1Sa 3:1",0,9003001],")."],["p",["people perish--",2],"(Compare Margin), are deprived of moral restraints."],["p",["keepeth the law--",2],"has, and observes, instruction (",["Pr 14:11",0,20014011],", ",["34",0,20014034],"; ",["Psa 19:11",0,19019011],")."]]],[20029019,20029019,[["p",["19. A servant--",2],"who lacks good principle."],["p",["corrected--",2],"or discovered."],["p",["will not answer--",2],"that is, will not obey."]]],[20029020,20029020,[["p","20. (Compare ",["Pr 21:5",0,20021005],")."],["p",["hasty in ... words?--",2],"implying self-conceit (",["Pr 26:12",0,20026012],")."]]],[20029021,20029021,[["p",["21. become his son--",2],"assume the place and privileges of one."]]],[20029022,20029022,[["p","22. (Compare ",["Pr 15:18",0,20015018],"). Such are delighted by discord and violence."]]],[20029023,20029023,[["p","23. (Compare ",["Pr 16:18",0,20016018],"; ",["18:12",0,20018012],")."],["p",["honour ... spirit--",2],"or, \"such shall lay hold on honor\" (",["Pr 11:16",0,20011016],")."]]],[20029024,20029024,[["p",["24. hateth ... soul--",2],"(Compare ",["Pr 8:36",0,20008036],")."],["p",["heareth cursing--",2],"(",["Le 5:1",0,3005001],"), risks the punishment, rather than reveal truth."]]],[20029025,20029025,[["p",["25. The fear ... snare--",2],"involves men in difficulty (compare ",["Pr 29:6",0,20029006],")."],["p",["shall be safe--",2],"(Compare Margin; ",["Pr 18:10",0,20018010],")."]]],[20029026,20029026,[["p","26. (Compare Margin; ",["Psa 27:8",0,19027008],"). God alone will and can do exact justice."]]],[20029027,20029027,[["p","27. (Compare ",["Pr 3:32",0,20003032],"). On last clause, compare ",["Pr 29:16",0,20029016],"; ",["Psa 37:12",0,19037012],"."]]]]}