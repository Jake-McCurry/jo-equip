{"e":[[19145001,19145002,[["h",["Psa 145:1-21",0,19145001,19145021],". A Psalm of praise to God for His mighty, righteous, and gracious government of all men, and of His humble and suffering people in particular."],["p","1-2. (Compare ",["Psa 30:1",0,19030001],")."],["p",["bless thy name--",2],"celebrate Thy perfections (",["Psa 5:11",0,19005011],"). God is addressed as king, alluding to His government of men."]]],[19145003,19145003,[["p","3. (Compare ",["Psa 18:3",0,19018003],"; ",["48:1",0,19048001],")."],["p",["greatness--",2],"as displayed in His works."]]],[19145004,19145004,[["p",["4. shall declare--",2],"literally, \"they shall declare,\" that is, all generations."]]],[19145005,19145005,[["p",["5. I will speak--",2],"or, \"muse\" (",["Psa 77:12",0,19077012],"; ",["119:15",0,19119015],")."],["p",["thy wondrous works--",2],"or, \"words of thy wonders,\" that is, which described them (",["Psa 105:27",0,19105027],", Margin)."]]],[19145006,19145006,[["p",["6. terrible acts--",2],"which produce dread or fear."]]],[19145007,19145007,[["p",["7. memory--",2],"(",["Psa 6:5",0,19006005],"), remembrance, or what causes to be remembered."],["p",["righteousness--",2],"as in ",["Psa 143:1",0,19143001],", goodness according to covenant engagement."]]],[19145008,19145009,[["p","8-9. (Compare ",["Psa 103:8",0,19103008],"; ",["111:4",0,19111004],")."],["p",["over all, &c.--",2],"rests on all His works."]]],[19145010,19145010,[["p",["10. bless--",2],"as in ",["Psa 145:1",0,19145001],", to praise with reverence, more than merely to praise."]]],[19145011,19145012,[["p","11-12. The declaration of God's glory is for the extension of His knowledge and perfections in the world."]]],[19145013,19145013,[["p","13. (Compare ",["Da 4:3",0,27004003],", ",["34",0,27004034],")."]]],[19145014,19145014,[["p","14. (Compare ",["Psa 37:17",0,19037017],"; ",["54:4",0,19054004],")."]]],[19145015,19145016,[["p",["15-16. eyes of ... thee--",2],"or, look with expecting faith (",["Psa 104:27",0,19104027],", ",["28",0,19104028],")."]]],[19145017,19145017,[["p",["17. holy ... works--",2],"literally, \"merciful\" or \"kind, goodness\" (",["Psa 144:2",0,19144002],") is the corresponding noun."],["p",["righteous--",2],"in a similar relation of meaning to \"righteousness\" (",["Psa 145:7",0,19145007],")."]]],[19145018,19145019,[["p","18-19. (Compare ",["Psa 34:7",0,19034007],", ",["10",0,19034010],")."]]],[19145020,19145020,[["p","20. Those who fear Him (",["Psa 145:19",0,19145019],") are those who are here said to love Him."]]],[19145021,19145021,[["p","21. (Compare ",["Psa 33:21",0,19033021],")."],["p",["all flesh--",2],"(",["Psa 65:2",0,19065002],"). The Psalm ends, as it began, with ascriptions of praise, in which the pious will ever delight to join."]]]]}