{"e":[[19054001,19054001,[["h",["Psa 54:1-7",0,19054001,19054007],". See on ",["Psa 4:1",0,19004001],", title; ",["Psa 32:1",0,19032001],", title; for the history, see ",["1Sa 23:19",0,9023019],", ",["29",0,9023029],"; ",["26:1-25",0,9026001,9026025],". After an earnest cry for help, the Psalmist promises praise in the assurance of a hearing."],["p",["1. by thy name--",2],"(",["Psa 5:11",0,19005011],"), specially, power."],["p",["judge me--",2],"as in ",["Psa 7:8",0,19007008],"; ",["26:1",0,19026001],"."]]],[19054002,19054002,[["p","2. (Compare ",["Psa 4:1",0,19004001],"; ",["5:1",0,19005001],")."]]],[19054003,19054003,[["p",["3. strangers--",2],"perhaps Ziphites."],["p",["oppressors--",2],"literally, \"terrible ones\" (",["Is 13:11",0,23013011],"; ",["25:3",0,23025003],"). Such were Saul and his army."],["p",["not set ... them--",2],"acted as atheists, without God's fear (compare ",["Psa 16:8",0,19016008],")."]]],[19054004,19054004,[["p","4. (Compare ",["Psa 30:10",0,19030010],")."],["p",["with them--",2],"on their side, and for me (compare ",["Psa 46:11",0,19046011],")."]]],[19054005,19054005,[["p",["5. He shall ... evil--",2],"or, \"Evil shall return on\" (",["Psa 7:16",0,19007016],") my enemies or watchers, that is, to do me evil (",["Psa 6:7",0,19006007],")."],["p",["in thy truth--",2],"Thy verified promise."]]],[19054006,19054006,[["p",["6. I will freely, &c.--",2],"or, present a freewill offering (",["Le 7:16",0,3007016],"; ",["Nu 15:3",0,4015003],")."]]],[19054007,19054007,[["p",["7. mine eye ... desire--",2],"(compare ",["Psa 59:10",0,19059010],"; ",["112:8",0,19112008],"), expresses satisfaction in beholding the overthrow of his enemies as those of God, without implying any selfish or unholy feeling (compare ",["Psa 52:6",0,19052006],", ",["7",0,19052007],")."]]]]}