{"e":[[19080001,19080002,[["h",["Psa 80:1-19",0,19080001,19080019],". Shoshannim--\"Lilies\" (see on ",["Psa 45:1",0,19045001],", title). Eduth--Testimony, referring to the topic as a testimony of God to His people (compare ",["Psa 19:7",0,19019007],"). This Psalm probably relates to the captivity of the ten tribes, as the former to that of Judah. Its complaint is aggravated by the contrast of former prosperity, and the prayer for relief occurs as a refrain through the Psalm."],["p",["1-2. Joseph--",2],"for Ephraim (",["1Ch 7:20-29",0,13007020,13007029],"; ",["Psa 78:67",0,19078067],"; ",["Re 7:8",0,66007008],"), for Israel."],["p",["Shepherd--",2],"(Compare ",["Ge 49:24",0,1049024],")."],["p",["leadest, &c.--",2],"(",["Psa 77:20",0,19077020],")."],["p",["dwellest ... cherubim--",2],"(",["Ex 25:20",0,2025020],"); the place of God's visible glory, whence He communed with the people (",["He 9:5",0,58009005],")."],["p",["shine forth--",2],"appear (",["Psa 50:2",0,19050002],"; ",["94:1",0,19094001],")."]]],[19080003,19080003,[["p",["3. Turn us--",2],"that is, from captivity."],["p",["thy face to shine--",2],"(",["Nu 6:25",0,4006025],")."]]],[19080004,19080004,[["p",["4. be angry--",2],"(Compare Margin.)"]]],[19080005,19080005,[["p",["5. bread of tears--",2],"still an Eastern figure for affliction."]]],[19080006,19080006,[["p",["6. strife--",2],"object or cause of (",["Is 9:11",0,23009011],"). On last clause compare ",["Psa 79:4",0,19079004],"; ",["Eze 36:4",0,26036004],"."]]],[19080008,19080011,[["p",["8-11. brought--",2],"or, \"plucked up,\" as by roots, to be replanted."],["p",["a vine--",2],"(",["Psa 78:47",0,19078047],"). The figure (",["Is 16:8",0,23016008],") represents the flourishing state of Israel, as predicted (",["Ge 28:14",0,1028014],"), and verified (",["1Ki 4:20-25",0,11004020,11004025],")."]]],[19080012,19080012,[["p",["12. hedges--",2],"(",["Is 5:5",0,23005005],")."]]],[19080013,19080013,[["p",["13. The boar--",2],"may represent the ravaging Assyrian and"],["p",["the wild beast--",2],"other heathen."]]],[19080014,19080015,[["p",["14-15. visit this vine--",2],"favorably (",["Psa 8:4",0,19008004],")."]]],[19080016,19080016,[["p",["16. it--",2],"the \"vine\" or"],["p",["they--",2],"the \"people\" are suffering from Thy displeasure."]]],[19080017,19080017,[["p",["17. thy hand ... upon--",2],"that is, strengthen (",["Ezr 7:6",0,15007006],"; ",["8:22",0,15008022],")."],["p",["man of ... hand--",2],"may allude to Benjamin (",["Ge 35:18",0,1035018],"). The terms in the latter clause correspond with those of ",["Psa 80:15",0,19080015],", from \"and the branch,\" &c., literally, and confirm the exposition given above."]]],[19080018,19080018,[["p","18. We need quickening grace (",["Psa 71:20",0,19071020],"; ",["119:25",0,19119025],") to persevere in Thy right worship (",["Ge 4:26",0,1004026],"; ",["Ro 10:11",0,45010011],")."]]],[19080019,19080019,[["p","19. (Compare ",["Psa 80:3",0,19080003],", \"O God\"; ",["Psa 80:7",0,19080007],", \"O God of hosts\")."]]]]}