---
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <nav class="bst-toc not-prose" aria-labelledby="bst-toc-title">
    <details open>
      <summary>
        <span id="bst-toc-title" class="bst-toc__title">Table of Contents</span>
        <span class="bst-toc__toggle" aria-hidden="true">
          <span class="bst-toc__hide">Hide</span><span class="bst-toc__show">Show</span>
        </span>
      </summary>
      <ul class="bst-toc__list">
        {items.map((item) => (
          <li>
            <a href={`#${item.id}`}>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<style>
  .bst-toc {
    margin: 1.75rem 0 2rem;
    background: #f3f5f7;
    border: 1px solid #d9dfe5;
    border-left: 4px solid var(--color-brand, #0095ff);
    border-radius: 10px;
    font-family: var(--font-sans);
    color: var(--color-text, #003a66);
  }
  .bst-toc details { margin: 0; padding: 0; }
  .bst-toc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    border-radius: 8px;
  }
  .bst-toc summary::-webkit-details-marker { display: none; }
  .bst-toc summary::marker { content: ""; }
  .bst-toc__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .bst-toc__toggle {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text, #003a66);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bst-toc__show { display: none; }
  .bst-toc details:not([open]) .bst-toc__show { display: inline; }
  .bst-toc details:not([open]) .bst-toc__hide { display: none; }
  .bst-toc .bst-toc__list {
    list-style: none;
    margin: 0;
    padding: 0 1.25rem 1.1rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 2rem;
  }
  .bst-toc .bst-toc__list li {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bst-toc .bst-toc__list li::before,
  .bst-toc .bst-toc__list li::marker { content: none; }
  .bst-toc .bst-toc__list a {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 500;
    color: var(--color-text, #003a66);
    text-decoration: none;
  }
  .bst-toc .bst-toc__list a svg { flex: none; margin-top: 0.2rem; color: var(--color-brand, #0095ff); }
  .bst-toc .bst-toc__list a:hover span { text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 768px) {
    .bst-toc .bst-toc__list { grid-template-columns: 1fr 1fr; }
  }
</style>
