---
import { Download, ChevronLeft, ChevronRight } from "lucide-react";
import { getBookCover } from "@/data/bookCovers";
import type { Book } from "@/data/books";
import BookThumbnail from "@/components/BookThumbnail.astro";

interface Props {
  title: string;
  books: Book[];
}

const { title, books } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;
---
<div class="book-carousel-section">
  <div class="flex items-end justify-between mb-4 md:mb-5">
    <h2 class="text-2xl md:text-3xl font-semibold" style="color:var(--color-structure);">{title}</h2>
    <div class="hidden sm:flex items-center gap-2">
      <button type="button" class="carousel-prev w-9 h-9 flex items-center justify-center rounded border bg-white transition-colors hover:bg-slate-50 disabled:opacity-30 disabled:cursor-not-allowed" style="border-color:var(--color-border); color:var(--color-text);" aria-label={`Scroll ${title} left`}>
        <ChevronLeft className="w-5 h-5" />
      </button>
      <button type="button" class="carousel-next w-9 h-9 flex items-center justify-center rounded border bg-white transition-colors hover:bg-slate-50 disabled:opacity-30 disabled:cursor-not-allowed" style="border-color:var(--color-border); color:var(--color-text);" aria-label={`Scroll ${title} right`}>
        <ChevronRight className="w-5 h-5" />
      </button>
    </div>
  </div>
  
  <div class="relative">
    <div class="carousel-track flex gap-4 md:gap-5 overflow-x-auto pb-2 snap-x snap-mandatory focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-brand)]" tabindex="0" role="region" aria-label={`${title} books`}>
      {books.map(book => {
        const cover = getBookCover(book.id);
        const isConcordance = book.id === "knowing-god";
        const cardTitle = isConcordance ? "Knowing God / Concordance" : book.title;
        const detailsHref = isConcordance ? "/knowing-god" : `/books/${book.id}`;
        const detailsLabel = isConcordance ? "View Digital Version" : "Details";
        return (
          <article id={book.id} class="book-card shrink-0 w-[220px] md:w-[240px] snap-start flex flex-col border rounded-lg bg-white overflow-hidden transition-shadow hover:shadow-md scroll-mt-24" style="border-color:var(--color-border);">
            <div class="book-cover-area">
                <a
                  href={join(book.pdf)}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-title={book.title}
                  data-pdf-action="open"
                  aria-label={`Open ${book.title} PDF`}
                   class="book-thumbnail-link rounded transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
                  style="outline-color:var(--color-brand);"
                >
                  <BookThumbnail cover={cover} title={book.title} />
                </a>
            </div>
            <div class="book-card-info px-4 py-3 border-t flex flex-col grow bg-white" style="border-color:var(--color-border);">
              <h3 class="font-semibold text-[15px] leading-snug mb-3 grow text-center" title={cardTitle}>
                <a
                  class="book-title-link inline-flex w-full items-center justify-center gap-1.5 rounded underline underline-offset-2 hover:opacity-80"
                  href={join(book.pdf)}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-title={book.title}
                  data-pdf-action="open"
                  aria-label={`${cardTitle} — open PDF in a new tab`}
                  style="color:var(--color-hero);"
                >
                  <span class="min-w-0">{cardTitle}</span>
                  <Download className="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
                </a>
              </h3>
              <div class="flex mt-auto">
                <a
                  href={join(detailsHref)}
                  class="text-xs font-medium transition-colors hover:opacity-75 w-full pt-2 border-t text-center mt-1"
                  style="color:var(--color-muted-foreground); border-color:var(--color-border);"
                  aria-label={isConcordance ? `View digital version of ${cardTitle}` : `View details for ${book.title}`}
                >
                  {detailsLabel}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</div>

<script>
  function setupCarousels() {
    const carousels = document.querySelectorAll('.book-carousel-section');
    carousels.forEach(section => {
      const track = section.querySelector('.carousel-track') as HTMLElement;
      const prevBtn = section.querySelector('.carousel-prev') as HTMLButtonElement;
      const nextBtn = section.querySelector('.carousel-next') as HTMLButtonElement;
      
      if (!track || track.dataset.carouselReady === 'true') return;
      track.dataset.carouselReady = 'true';
      
      const updateButtons = () => {
        if (prevBtn) {
          prevBtn.disabled = track.scrollLeft <= 5;
        }
        if (nextBtn) {
          // Allow 5px margin of error
          nextBtn.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 5;
        }
      };

      track.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateButtons);
      });
      
      setTimeout(updateButtons, 100);
      window.addEventListener('resize', updateButtons);

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          const scrollAmount = track.clientWidth * 0.75;
          track.scrollBy({ left: -scrollAmount, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const scrollAmount = track.clientWidth * 0.75;
          track.scrollBy({ left: scrollAmount, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        });
      }
    });
  }

  document.addEventListener('astro:page-load', setupCarousels);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCarousels);
  } else {
    setupCarousels();
  }
</script>

<style>
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .carousel-track {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .book-cover-area {
    display: grid;
    place-items: center;
    padding: 0.75rem;
    background: #fff;
  }
  .book-thumbnail-link {
    display: block;
    width: 100%;
    max-width: 180px;
  }
  @media (max-width: 767px) {
    /* Two full cards + two 1rem gaps + half of the next card. */
    .book-card {
      width: calc(40% - 0.8rem);
    }
    .book-cover-area {
      padding: 0.5rem;
    }
    .book-card-info {
      padding: 0.625rem;
    }
    .book-card-info h3 {
      font-size: 13px;
      margin-bottom: 0.75rem;
    }
  }
</style>
