---
import { Image } from "astro:assets";
import logoSrc from "@/assets/jol-logo-white.png";
import { Search as SearchIcon } from "lucide-react";
import HeaderReadingTools from "./HeaderReadingTools.astro";
interface Props { navColor?: string; tagline?: string; }
const { navColor = "#0095ff", tagline } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

const navLinks = [
  { name: "Discipleship", path: "/discipleship" },
  { name: "Categories", path: "/categories" },
  { name: "Playlists", path: "/playlists" },
  { name: "Books", path: "/books" },
  { name: "Bible", path: "/bible" },
  { name: "More", path: "/more" },
];

// Active-state detection — strip the base prefix from current path first
const rawPath = Astro.url.pathname;
const stripBase = (p: string) => {
  const b = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  if (b && p.startsWith(b)) return p.slice(b.length) || "/";
  return p;
};
const currentPath = stripBase(rawPath);

function isActive(linkPath: string) {
  return linkPath === "/" ? currentPath === "/" : currentPath.startsWith(linkPath);
}

const navLinksWithActive = navLinks.map(l => ({ ...l, active: isActive(l.path) }));

// The hamburger menu (all breakpoints) lists the primary links and adds
// Contact at the bottom. /welcome is kept as a page but not linked (Aug 2026).
---
    <header class="equip-header sticky top-0 z-50 w-full" style={`background-color:${navColor};border-bottom:1px solid rgba(255,255,255,0.08);`}>
      <div class="container mx-auto px-4 md:px-6 flex items-center justify-between gap-2 py-4 md:py-5 relative">

        <a href={join("/")} class="flex items-center gap-2 sm:gap-3 md:gap-5 hover:opacity-90 transition-opacity min-w-0">
          {/* fetchpriority=high tells the browser this is the LCP candidate
              and to prioritize it over the in-viewport channel art photos. */}
          <Image src={logoSrc} alt="JesusOnline" widths={[200, 400]} sizes="200px" format="webp" quality={85} class="h-7 sm:h-8 md:h-10 w-auto" loading="eager" fetchpriority="high" />
          <span class:list={["min-w-0", tagline && "flex flex-col xl:flex-row xl:items-center xl:gap-5"]}>
            <span class="text-white font-bold text-lg sm:text-xl tracking-wide whitespace-nowrap" style="font-family:var(--font-sans);">
              JO EQUIP
            </span>
            {tagline && <span class="text-white text-xs sm:text-sm xl:text-base font-medium leading-snug">{tagline}</span>}
          </span>
        </a>

        {/* Utilities + hamburger — the same compact cluster at every breakpoint.
            All primary destinations live in the dropdown panel. */}
        <div class="flex items-center gap-0 sm:gap-1 flex-shrink-0">
          <a
            href={join("/search")}
            class="inline-flex items-center justify-center w-10 h-10 rounded transition-colors hover:bg-white/10"
            style="color:#ffffff;"
            aria-label="Search the library"
            title="Search"
          >
            <SearchIcon className="w-5 h-5" />
          </a>
          <HeaderReadingTools />
          <button
            id="mobile-nav-trigger"
            type="button"
            class="inline-flex items-center justify-center w-10 h-10 rounded text-white hover:bg-white/10"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
          >
            <svg id="mobile-nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
            <svg id="mobile-nav-icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      {/* Menu panel — full width on small screens, right-aligned dropdown from md up. */}
      <nav
        id="mobile-nav-panel"
        aria-label="Primary"
        class="equip-menu absolute top-full right-0 left-0 md:left-auto md:right-6 md:w-80 md:rounded-b-lg flex-col z-40 hidden data-[open=true]:flex shadow-lg overflow-y-auto"
        style={`background-color:#ffffff;border-top:3px solid ${navColor};max-height:calc(100dvh - 100%);`}
      >
        {navLinksWithActive.map(link => (
          <a
            href={join(link.path)}
            aria-current={link.active ? "page" : undefined}
            class="text-base font-medium py-3.5 px-6 transition-colors hover:bg-[var(--color-surface-soft)]"
            style={`color:var(--color-text);border-bottom:1px solid var(--color-border-soft);${link.active ? "background-color:var(--color-surface-soft);border-left:3px solid var(--color-accent);padding-left:calc(1.5rem - 3px);font-weight:700;" : ""}`}
          >
            {link.name}
          </a>
        ))}
        <a
          href="mailto:pastorjon@jesusonline.com"
          class="text-base font-medium py-3.5 px-6 transition-colors hover:bg-[var(--color-surface-soft)]"
          style="color:var(--color-text);"
        >
          Contact
        </a>
      </nav>
    </header>
    <style>
      /* White/Blue500 meets the kit's large-bold text threshold at 19px/700.
         Focus must contrast with the blue surface, not disappear into it. */
      .equip-header :is(a, button):focus-visible { outline-color: #fff; }
      #mobile-nav-panel a:focus-visible { outline-color: var(--color-focus); outline-offset: -3px; }
      :global(html.equip-menu-locked), :global(html.equip-menu-locked body) { overflow: hidden; }
    </style>

    <script is:inline>
      (function () {
        var trigger = document.getElementById("mobile-nav-trigger");
        var panel = document.getElementById("mobile-nav-panel");
        var iconOpen = document.getElementById("mobile-nav-icon-open");
        var iconClose = document.getElementById("mobile-nav-icon-close");
        if (!trigger || !panel) return;
        // Scroll lock via a class on <html> (not inline body styles) so it
        // can't clobber or be clobbered by other code, and is always released.
        var LOCK = "equip-menu-locked";
        function isOpen() { return panel.dataset.open === "true"; }
        function setOpen(open, restoreFocus) {
          panel.dataset.open = open ? "true" : "false";
          trigger.setAttribute("aria-expanded", open ? "true" : "false");
          trigger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          if (iconOpen && iconClose) {
            iconOpen.style.display = open ? "none" : "";
            iconClose.style.display = open ? "" : "none";
          }
          document.documentElement.classList.toggle(LOCK, open);
          if (open) {
            var firstLink = panel.querySelector("a[href]");
            if (firstLink) firstLink.focus();
          } else if (restoreFocus) {
            trigger.focus();
          }
        }
        setOpen(false, false);
        trigger.addEventListener("click", function () { setOpen(!isOpen(), isOpen()); });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && isOpen()) { e.preventDefault(); setOpen(false, true); }
        });
        // Outside click/tap closes (without stealing focus from what was clicked).
        document.addEventListener("pointerdown", function (e) {
          if (!isOpen()) return;
          if (panel.contains(e.target) || trigger.contains(e.target)) return;
          setOpen(false, false);
        });
        // Tabbing out of the menu closes it.
        panel.addEventListener("focusout", function (e) {
          var to = e.relatedTarget;
          if (isOpen() && to && !panel.contains(to) && to !== trigger) setOpen(false, false);
        });
        panel.addEventListener("click", function (e) {
          if (e.target.closest && e.target.closest("a")) setOpen(false, false);
        });
        // Always release the lock when leaving / restoring from bfcache.
        window.addEventListener("pagehide", function () { if (isOpen()) setOpen(false, false); });
        window.addEventListener("pageshow", function () { if (!isOpen()) document.documentElement.classList.remove(LOCK); });
      })();
    </script>
