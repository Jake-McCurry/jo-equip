---
import MakeMultiplySignupForm from "@/components/MakeMultiplySignupForm.astro";

interface Props {
  accent?: string;
}
const { accent = "#7a3a8a" } = Astro.props;

const features = [
  {
    title: "Insights from Pastor Jon",
    body: "Biblical wisdom and pastoral reflections to refresh your soul.",
  },
  {
    title: "JO EQUIP Spotlight",
    body: "New and featured resources from the hub.",
  },
  {
    title: "Practical Strategies",
    body: "Actionable ways to integrate JesusOnline tools for personal discipleship and church growth.",
  },
];
---
<div class="max-w-3xl mx-auto">
  <p class="text-base leading-relaxed" style="color:#374151;">
    Subscribe to the free <strong style="color:#0b3c5d;">Making and Multiplying Disciples Newsletter</strong> —
    your monthly source of hope, insight, and practical equipping. Each issue features:
  </p>
  <ul class="mt-4 space-y-2 pl-5 list-disc" style="color:#374151;">
    {features.map((f) => (
      <li class="text-base leading-relaxed">
        <strong style="color:#0b3c5d;">{f.title}</strong> — {f.body}
      </li>
    ))}
  </ul>

  {/* Partnership callout */}
  <div class="mt-10 rounded p-6 md:p-7" style={`background-color:${accent}0a;border:1px solid ${accent}33;`}>
    <p class="text-base leading-relaxed font-semibold" style={`color:${accent};`}>
      Sign up today and receive encouragement and resources that honor your time and multiply your ministry!
    </p>
  </div>

  {/* Sign-up form (shared Mailchimp POST form) */}
  <div class="mt-10">
    <MakeMultiplySignupForm accent={accent} />
  </div>
</div>
