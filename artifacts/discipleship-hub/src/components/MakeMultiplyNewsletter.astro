---
interface Props {
  accent?: string;
}
const { accent = "#7a3a8a" } = Astro.props;

const features = [
  {
    title: "Insights from Pastor Jon",
    body: "Biblical wisdom and pastoral reflections to refresh your soul.",
  },
  {
    title: "JO EQUIP Spotlight",
    body: "New and featured resources from the hub.",
  },
  {
    title: "Practical Strategies",
    body: "Actionable ways to integrate JesusOnline tools for personal discipleship and church growth.",
  },
  {
    title: "Ways to Engage",
    body: "Share your story or review, submit prayer requests, see lives reached online, learn how your church can grow, and request personal coaching.",
  },
];

// Mailchimp audience: jesusonline.us1. The form posts directly (no third-party
// script needed). Merge fields on this audience: EMAIL, FNAME (First Name),
// CHURCH (Church/Ministry), COUNTRY, and MMERGE8 (Gender dropdown).
const MC_ACTION =
  "https://jesusonline.us1.list-manage.com/subscribe/post?u=c02949f5de137184b156da9bc&id=e06ba0649d&f_id=00bb87e5f0";
const MC_HONEYPOT = "b_c02949f5de137184b156da9bc_e06ba0649d";
---
<div class="max-w-3xl mx-auto">
  <p class="text-base leading-relaxed" style="color:#374151;">
    Subscribe to the free <strong style="color:#002f55;">Making and Multiplying Disciples Newsletter</strong> —
    your monthly source of hope, insight, and practical equipping. Each issue features:
  </p>
  <ul class="mt-4 space-y-2 pl-5 list-disc" style="color:#374151;">
    {features.map((f) => (
      <li class="text-base leading-relaxed">
        <strong style="color:#002f55;">{f.title}</strong> — {f.body}
      </li>
    ))}
  </ul>

  {/* Partnership callout */}
  <div class="mt-10 rounded p-6 md:p-7" style={`background-color:${accent}0a;border:1px solid ${accent}33;`}>
    <p class="text-base leading-relaxed" style="color:#002f55;">
      This isn't just another newsletter — it's a monthly partnership that strengthens your calling,
      equips your leaders, and amplifies your Great Commission impact.
    </p>
    <p class="text-base leading-relaxed mt-3 font-semibold" style={`color:${accent};`}>
      Sign up today and receive encouragement and resources that honor your time and multiply your ministry!
    </p>
  </div>

  {/* Sign-up form (Mailchimp POST) */}
  <div
    id="signup"
    class="mt-10 bg-white border rounded p-6 md:p-8"
    style={`border-color:var(--color-border);border-top:4px solid ${accent};`}
  >
    <h2 class="text-xl mb-1" style="color:#002f55;">Free Sign Up</h2>
    <p class="text-sm mb-6" style="color:var(--color-muted-foreground);">Free. No spam. Unsubscribe anytime.</p>

    <form
      action={MC_ACTION}
      method="post"
      target="_blank"
      class="space-y-4"
    >
      <div>
        <label for="mm-email" class="block text-sm font-medium mb-1.5" style="color:#002f55;">
          Email <span style="color:#de5b00;">*</span>
        </label>
        <input
          type="email"
          name="EMAIL"
          id="mm-email"
          required
          autocomplete="email"
          class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
          style="border-color:var(--color-border);color:#002f55;"
        />
      </div>

      <div>
        <label for="mm-fname" class="block text-sm font-medium mb-1.5" style="color:#002f55;">
          First Name <span style="color:#de5b00;">*</span>
        </label>
        <input
          type="text"
          name="FNAME"
          id="mm-fname"
          required
          autocomplete="given-name"
          class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
          style="border-color:var(--color-border);color:#002f55;"
        />
      </div>

      <div>
        <label for="mm-church" class="block text-sm font-medium mb-1.5" style="color:#002f55;">
          Church/Ministry <span style="color:#de5b00;">*</span>
        </label>
        <input
          type="text"
          name="CHURCH"
          id="mm-church"
          required
          autocomplete="organization"
          class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
          style="border-color:var(--color-border);color:#002f55;"
        />
      </div>

      <div>
        <label for="mm-country" class="block text-sm font-medium mb-1.5" style="color:#002f55;">
          Country
        </label>
        <input
          type="text"
          name="COUNTRY"
          id="mm-country"
          autocomplete="country-name"
          class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
          style="border-color:var(--color-border);color:#002f55;"
        />
      </div>

      <div>
        <label for="mm-gender" class="block text-sm font-medium mb-1.5" style="color:#002f55;">
          Gender
        </label>
        <select
          name="MMERGE8"
          id="mm-gender"
          class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2 bg-white"
          style="border-color:var(--color-border);color:#002f55;"
        >
          <option value=""></option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
        </select>
      </div>

      {/* Mailchimp audience tag */}
      <input type="hidden" name="tags" value="5798198" />

      {/* Bot-prevention honeypot — do not remove */}
      <div aria-hidden="true" style="position:absolute;left:-5000px;">
        <input type="text" name={MC_HONEYPOT} tabindex="-1" value="" />
      </div>

      <button
        type="submit"
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded font-semibold text-sm transition-all hover:shadow-md"
        style={`background-color:${accent};color:#ffffff;`}
      >
        Free Sign Up
      </button>
    </form>

    <p class="text-xs mt-4" style="color:var(--color-muted-foreground);">
      Prefer email? Write to
      <a href="mailto:equip@jesusonline.com" class="font-semibold hover:underline" style="color:#de5b00;">equip@jesusonline.com</a>
      and we'll add you to the list.
    </p>
  </div>
</div>
