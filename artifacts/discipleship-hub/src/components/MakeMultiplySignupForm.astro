---
/* Shared Mailchimp signup form for the Making & Multiplying Disciples
 * newsletter. Used on /newsletter and the church channel newsletter
 * sub-topic page (via MakeMultiplyNewsletter.astro) so the two forms
 * never drift apart.
 *
 * Submits via Mailchimp's JSONP endpoint (post-json) so we can confirm the
 * signup succeeded before redirecting to the /thank-you page (instead of
 * navigating to Mailchimp's response page) — same pattern as
 * /register-church, but this form's own f_id=00bb87e5f0. */
interface Props {
  accent?: string;
}
const { accent = "#6B2D7B" } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;
const THANK_YOU = join("/thank-you");

// Mailchimp audience: jesusonline.us1. Merge fields on this audience:
// EMAIL, FNAME (First Name), CHURCH (Church/Ministry), COUNTRY, and
// MMERGE8 (Gender dropdown).
const MC_POST_JSON =
  "https://jesusonline.us1.list-manage.com/subscribe/post-json?u=c02949f5de137184b156da9bc&id=e06ba0649d&f_id=00bb87e5f0";
const MC_HONEYPOT = "b_c02949f5de137184b156da9bc_e06ba0649d";
---
<div
  id="signup"
  class="bg-white border rounded p-6 md:p-8 text-left"
  style={`border-color:var(--color-border);border-top:4px solid ${accent};`}
>
  <h2 class="text-xl mb-1" style="color:#0b3c5d;">Free Sign Up</h2>
  <p class="text-sm mb-6" style="color:var(--color-muted-foreground);">Enter your email below to start receiving the free monthly newsletter.</p>

  <form id="mm-form" class="space-y-4" novalidate>
    <div>
      <label for="mm-email" class="block text-sm font-medium mb-1.5" style="color:#0b3c5d;">
        Email <span style="color:#de5b00;">*</span>
      </label>
      <input
        type="email"
        name="EMAIL"
        id="mm-email"
        required
        autocomplete="email"
        class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
        style="border-color:var(--color-border);color:#0b3c5d;"
      />
    </div>

    <div>
      <label for="mm-fname" class="block text-sm font-medium mb-1.5" style="color:#0b3c5d;">
        First Name <span style="color:#de5b00;">*</span>
      </label>
      <input
        type="text"
        name="FNAME"
        id="mm-fname"
        required
        autocomplete="given-name"
        class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
        style="border-color:var(--color-border);color:#0b3c5d;"
      />
    </div>

    <div>
      <label for="mm-church" class="block text-sm font-medium mb-1.5" style="color:#0b3c5d;">
        Church/Ministry
      </label>
      <input
        type="text"
        name="CHURCH"
        id="mm-church"
        autocomplete="organization"
        class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
        style="border-color:var(--color-border);color:#0b3c5d;"
      />
    </div>

    {/* COUNTRY is reported automatically from the visitor's IP (Cloudflare
        geolocation via /api/geo) — no visible field. Empty if unavailable. */}
    <input type="hidden" name="COUNTRY" id="mm-country" value="" />

    {/* Mailchimp audience tag */}
    <input type="hidden" name="tags" value="5798198" />

    {/* Bot-prevention honeypot — do not remove */}
    <div aria-hidden="true" style="position:absolute;left:-5000px;">
      <input type="text" name={MC_HONEYPOT} tabindex="-1" value="" />
    </div>

    <p id="mm-error" class="hidden text-sm font-medium" style="color:#b91c1c;" role="alert"></p>

    <button
      type="submit"
      id="mm-submit"
      class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded font-semibold text-sm transition-all hover:shadow-md"
      style={`background-color:${accent};color:#ffffff;`}
    >
      Free Sign Up
    </button>

    <p class="text-xs text-center" style="color:var(--color-muted-foreground);">
      We respect your privacy. Unsubscribe anytime.
    </p>
  </form>
</div>

<script define:vars={{ MC_POST_JSON, THANK_YOU }}>
  const form = document.getElementById("mm-form");

  /* Fill hidden COUNTRY from the visitor's IP (Cloudflare geolocation).
   * Only works on the live site (the Worker serves /api/geo); anywhere
   * else this fails silently and COUNTRY is submitted empty. */
  (async () => {
    try {
      const res = await fetch("/api/geo", { signal: AbortSignal.timeout(4000) });
      if (!res.ok) return;
      const { country } = await res.json();
      if (!country) return;
      let name = country;
      try {
        name = new Intl.DisplayNames(["en"], { type: "region" }).of(country) || country;
      } catch {}
      document.getElementById("mm-country").value = name;
    } catch {}
  })();
  const submitBtn = document.getElementById("mm-submit");
  const errorEl = document.getElementById("mm-error");

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");

    if (!form.reportValidity()) return;

    submitBtn.disabled = true;
    submitBtn.style.opacity = "0.6";

    /* Mailchimp only accepts cross-origin signups via JSONP. */
    const params = new URLSearchParams(new FormData(form));
    const cb = "mmMailchimpCb" + Date.now();
    const script = document.createElement("script");
    let settled = false;

    function finish() {
      settled = true;
      delete window[cb];
      script.remove();
      submitBtn.disabled = false;
      submitBtn.style.opacity = "";
    }

    window[cb] = (res) => {
      finish();
      if (res && res.result === "success") {
        form.reset();
        // Send the new subscriber to the dedicated thank-you page.
        window.location.href = THANK_YOU;
      } else {
        const msg = (res && res.msg ? String(res.msg) : "Something went wrong. Please try again.")
          .replace(/<[^>]*>/g, "")
          .replace(/^\d+\s*-\s*/, "");
        errorEl.textContent = msg;
        errorEl.classList.remove("hidden");
      }
    };

    script.src = MC_POST_JSON + "&" + params.toString() + "&c=" + cb;
    script.onerror = () => {
      if (settled) return;
      finish();
      errorEl.textContent = "Something went wrong. Please check your connection and try again.";
      errorEl.classList.remove("hidden");
    };
    document.body.appendChild(script);
  });
</script>
