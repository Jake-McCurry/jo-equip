---
import { Image } from "astro:assets";
import leadResurrectionImg from "@/assets/lead-them/jesus-resurrection-and-you.jpg";
import leadGiftHeavenImg from "@/assets/lead-them/the-gift-of-heaven.jpg";
import leadRelevantImg from "@/assets/lead-them/is-jesus-relevant-to-you.jpg";
import { Play, ArrowRight, Users2, BookOpen, Smartphone, Star } from "lucide-react";
import { books } from "@/data/books";
import { getBookCover } from "@/data/bookCovers";
import { playlists, playlistThumbnail } from "@/data/playlists";

/* Shared layout for the JO EQUIP persona landing pages
   (/pastors, /home-church-leaders, /chaplains, /missionaries).
   Content per the JO_EQUIP_<persona>_Page docs (Aug 2026). */

interface Article {
  title: string;
  text: string;
  href: string; // site-relative, no trailing slash
}

interface Topic {
  name: string;
  href: string;
}

interface Faq {
  question: string;
  answer: string[];
}

interface Props {
  heading: string;
  intro: string[]; // paragraphs
  articles: Article[];
  booksNote: string;
  bookIds: string[];
  topics: Topic[];
  playlistsNote: string;
  playlistIds: string[];
  closing: string[]; // paragraphs
  faqs?: Faq[];
}

const { heading, intro, articles, booksNote, bookIds, topics, playlistsNote, playlistIds, closing, faqs = [] } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

const featuredBooks = bookIds
  .map(id => books.find(b => b.id === id))
  .filter((b): b is (typeof books)[number] => Boolean(b));

const featuredPlaylists = playlistIds
  .map(id => playlists.find(p => p.id === id))
  .filter((p): p is (typeof playlists)[number] => Boolean(p));

/* "Lead Them to Christ" — shared bottom section on all four persona pages,
   per the Lead_Them_to_Christ docx (Aug 2026). Mirrors the Share Jesus →
   Lead Them to Christ topic (channels.ts). */
const leadThemVideos = [
  {
    title: "Jesus\u2019 Resurrection and You",
    watch: "https://jesusonline.com/receive-jesus/jesus-resurrection-and-you/",
    read: join("/categories/church/lead-them-to-christ/share-christ-jesus-resurrection-and-you"),
    external: true,
    image: leadResurrectionImg,
  },
  {
    title: "The Gift of Heaven",
    watch: "https://jesusonline.com/receive-jesus/the-gift-of-heaven/",
    read: join("/categories/church/lead-them-to-christ/share-christ-the-gift-of-heaven"),
    external: true,
    image: leadGiftHeavenImg,
  },
  {
    title: "Is Jesus Relevant To You?",
    watch: join("/video/e0jMauxD1Y0"),
    read: join("/categories/church/lead-them-to-christ/share-christ-is-jesus-relevant-to-you"),
    external: false,
    image: leadRelevantImg,
  },
];

const quickLinks = [
  { title: "Reviews", subtitle: "From Pastors and Leaders", href: join("/reviews"), icon: Star, external: false },
  { title: "About", subtitle: "JesusOnline Ministries", href: join("/about"), icon: Users2, external: false },
  { title: "Beliefs", subtitle: "Statement of Faith", href: join("/beliefs"), icon: BookOpen, external: false },
  { title: "JO APP", subtitle: "Growing in Christ", href: "https://app.jesusonline.com", icon: Smartphone, external: true },
];
---
{/* Heading + intro */}
<section class="bg-white">
  <div class="container mx-auto px-4 py-12 md:py-16 max-w-4xl">
    <h1 class="text-2xl md:text-3xl mb-4" style="color:#0b3c5d;">{heading}</h1>
    <div class="h-0.5 w-12 mb-7" style="background-color:#de5b00;"></div>
    {intro.map(p => (
      <p class="text-lg leading-relaxed mb-5 last:mb-0" style="color:#374151;" set:html={p} />
    ))}
    <p class="text-sm font-semibold tracking-wide uppercase mt-8" style="color:#0b3c5d;">
      Featured Resources by Type:
      <a href="#articles" class="font-normal hover:underline" style="color:#de5b00;">Articles</a> <span style="color:#de5b00;">&bull;</span>
      <a href="#topics" class="font-normal hover:underline" style="color:#de5b00;">Topics</a> <span style="color:#de5b00;">&bull;</span>
      <a href="#books" class="font-normal hover:underline" style="color:#de5b00;">Books</a> <span style="color:#de5b00;">&bull;</span>
      <a href="#playlists" class="font-normal hover:underline" style="color:#de5b00;">Playlists</a>
    </p>
  </div>
</section>

{/* Articles */}
<section id="articles" class="py-10 md:py-14 scroll-mt-20" style="background-color:#e6f2fa;">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl md:text-3xl font-semibold mb-6" style="color:#0b3c5d;">Articles</h2>
    <ul class="flex flex-col gap-4">
      {articles.map(a => (
        <li class="bg-white border rounded px-6 py-5" style="border-color:var(--color-border);border-left:4px solid #0083de;">
          <p class="text-[15px] md:text-base leading-relaxed" style="color:#374151;">
            <strong class="font-semibold" style="color:#0b3c5d;">{a.title}:</strong>{" "}{a.text}{" "}
            <a href={join(a.href)} class="whitespace-nowrap hover:underline" style="color:#de5b00;">[more]</a>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* Books */}
<section id="books" class="py-10 md:py-14 bg-white scroll-mt-20">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl md:text-3xl font-semibold mb-2" style="color:#0b3c5d;">Books</h2>
    <p class="text-[15px] md:text-base leading-relaxed mb-6" style="color:#374151;">{booksNote}</p>
    <div class="flex gap-4 md:gap-5 overflow-x-auto pb-2 md:grid md:overflow-visible md:grid-cols-4 lg:grid-cols-8">
      {featuredBooks.map(b => {
        const cover = getBookCover(b.id);
        return (
          <a href={join(`/books/${b.id}`)} class="group shrink-0 w-[calc((100vw-5rem)/3.5)] max-w-[130px] md:w-auto md:max-w-none">
            <div class="border rounded overflow-hidden bg-white transition-shadow group-hover:shadow-md" style="border-color:var(--color-border);">
              {cover ? (
                <Image src={cover} alt={b.title} width={260} class="w-full aspect-[3/4] object-cover" />
              ) : (
                <div class="aspect-[3/4] flex items-center justify-center" style="background-color:#e6f2fa;">
                  <BookOpen className="w-8 h-8" style={{ color: "#94a3b8" }} />
                </div>
              )}
            </div>
            <p class="mt-2 text-xs leading-snug font-medium group-hover:underline" style="color:#0b3c5d;">{b.title}</p>
          </a>
        );
      })}
      {/* "More" tile → all books */}
      <a href={join("/books")} class="group shrink-0 w-[calc((100vw-5rem)/3.5)] max-w-[130px] md:w-auto md:max-w-none">
        <div class="aspect-[3/4] border-2 border-dashed rounded flex flex-col items-center justify-center gap-2 transition-colors group-hover:border-solid" style="border-color:#0083de;background-color:#e6f2fa;">
          <ArrowRight className="w-6 h-6" style={{ color: "#0083de" }} />
          <span class="text-sm font-semibold" style="color:#0083de;">More</span>
        </div>
        <p class="mt-2 text-xs leading-snug font-medium group-hover:underline" style="color:#0b3c5d;">All free books</p>
      </a>
    </div>
  </div>
</section>

{/* Topics */}
<section id="topics" class="py-10 md:py-14 scroll-mt-20" style="background-color:#e6f2fa;">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl md:text-3xl font-semibold mb-2" style="color:#0b3c5d;">Topics</h2>
    <p class="text-sm mb-6" style="color:#6b7280;">Categories &amp; Series</p>
    <div class="flex flex-wrap gap-3">
      {topics.map(t => (
        <a
          href={join(t.href)}
          class="topic-chip inline-flex items-center gap-2 bg-white border rounded-full px-5 py-2.5 text-sm font-medium transition-colors"
        >
          {t.name}
        </a>
      ))}
    </div>
  </div>
</section>

{/* Playlists */}
<section id="playlists" class="py-10 md:py-14 bg-white scroll-mt-20">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl md:text-3xl font-semibold mb-2" style="color:#0b3c5d;">Playlists</h2>
    <p class="text-[15px] md:text-base leading-relaxed mb-6" style="color:#374151;">{playlistsNote}</p>
    <div class="flex gap-4 md:gap-5 overflow-x-auto pb-2 md:grid md:overflow-visible md:grid-cols-3 lg:grid-cols-4">
      {featuredPlaylists.map(p => {
        const thumb = playlistThumbnail(p);
        return (
          <a href={join(`/playlist/${p.id}`)} class="group shrink-0 w-[calc((100vw-4rem)/2.5)] max-w-[220px] md:w-auto md:max-w-none">
            <div class="relative border rounded overflow-hidden bg-white transition-shadow group-hover:shadow-md" style="border-color:var(--color-border);">
              <div class="relative aspect-video bg-slate-100 overflow-hidden">
                {thumb && (
                  <img src={thumb} alt={p.title} loading="lazy" width="320" height="180" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
                )}
                <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/15 transition-colors">
                  <div class="w-11 h-11 rounded-full flex items-center justify-center transition-all duration-200 scale-90 opacity-0 group-hover:opacity-100 group-hover:scale-100" style="background-color:rgba(255,255,255,0.95);">
                    <Play className="w-5 h-5 ml-0.5" style={{ color: "#de5b00", fill: "#de5b00" }} />
                  </div>
                </div>
              </div>
            </div>
            <p class="mt-2 text-xs leading-snug font-medium group-hover:underline" style="color:#0b3c5d;">{p.title}</p>
          </a>
        );
      })}
      {/* "More" tile → all playlists */}
      <a href={join("/playlists")} class="group shrink-0 w-[calc((100vw-4rem)/2.5)] max-w-[220px] md:w-auto md:max-w-none">
        <div class="aspect-video border-2 border-dashed rounded flex flex-col items-center justify-center gap-1.5 transition-colors group-hover:border-solid" style="border-color:#0083de;background-color:#e6f2fa;">
          <ArrowRight className="w-6 h-6" style={{ color: "#0083de" }} />
          <span class="text-sm font-semibold" style="color:#0083de;">More</span>
        </div>
        <p class="mt-2 text-xs leading-snug font-medium group-hover:underline" style="color:#0b3c5d;">All playlists</p>
      </a>
    </div>
  </div>
</section>

{/* Closing */}
<section class="py-10 md:py-12" style="background-color:#e6f2fa;">
  <div class="container mx-auto px-4 max-w-4xl">
    {closing.map(p => (
      <p class="text-[15px] md:text-base leading-relaxed mb-5 last:mb-0" style="color:#374151;">{p}</p>
    ))}
  </div>
</section>

{/* Frequently asked questions — supplied only where the persona has FAQ copy. */}
{faqs.length > 0 && (
  <section id="faqs" class="py-10 md:py-14 bg-white scroll-mt-20">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-semibold mb-2" style="color:#0b3c5d;">Frequently Asked Questions</h2>
      <p class="text-[15px] md:text-base leading-relaxed mb-6" style="color:#374151;">
        Answers to common questions about free discipleship resources for pastors.
      </p>
      <div class="border-t" style="border-color:var(--color-border);">
        {faqs.map(faq => (
          <details class="group border-b" style="border-color:var(--color-border);">
            <summary class="flex items-center justify-between gap-5 cursor-pointer py-4 text-[15px] md:text-base font-semibold list-none" style="color:#0b3c5d;">
              <span>{faq.question}</span>
              <span aria-hidden="true" class="shrink-0 text-2xl leading-none transition-transform duration-200 group-open:rotate-45" style="color:#de5b00;">+</span>
            </summary>
            <div class="pb-5 pr-8">
              {faq.answer.map(answer => (
                <p class="text-[15px] md:text-base leading-relaxed mb-3 last:mb-0" style="color:#374151;">{answer}</p>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

{/* Lead Them to Christ */}
<section id="lead-them-to-christ" class="py-10 md:py-14 bg-white scroll-mt-20">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl md:text-3xl font-semibold mb-4" style="color:#0b3c5d;">Lead Them to Christ</h2>
    <p class="text-[15px] md:text-base leading-relaxed mb-6" style="color:#374151;">
      Share the gospel with someone using one of these JO EQUIP videos. Many believers struggle
      with finding the right words when sharing the good news. These clear, approximately
      10-minute videos explain the gospel and end with a prayer of salvation.
    </p>
    <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-5 mb-6">
      {leadThemVideos.map(v => (
        <li class="bg-white border rounded flex flex-col overflow-hidden" style="border-color:var(--color-border);border-top:4px solid #0083de;">
          <p class="font-semibold text-[15px] md:text-base leading-snug px-4 pt-4 pb-3" style="color:#0b3c5d;">{v.title}</p>
          <a
            href={v.watch}
            target={v.external ? "_blank" : undefined}
            rel={v.external ? "noopener noreferrer" : undefined}
            aria-label={`Watch video: ${v.title}`}
            class="block transition-opacity hover:opacity-85"
          >
            <Image
              src={v.image}
              alt={`${v.title} video`}
              widths={[320, 640]}
              sizes="(min-width: 640px) 300px, 90vw"
              format="webp"
              quality={80}
              class="w-full aspect-video object-cover"
              loading="lazy"
            />
          </a>
          <p class="text-sm md:text-[15px] px-4 py-3.5 mt-auto">
            <a
              href={v.watch}
              target={v.external ? "_blank" : undefined}
              rel={v.external ? "noopener noreferrer" : undefined}
              class="hover:underline whitespace-nowrap"
              style="color:#de5b00;"
            >Watch video</a>
            {" "}<span style="color:#9ca3af;">&middot;</span>{" "}
            <a href={v.read} class="hover:underline whitespace-nowrap" style="color:#de5b00;">Read instructions</a>
          </p>
        </li>
      ))}
    </ul>
    <p class="text-[15px] md:text-base leading-relaxed" style="color:#374151;">
      Each video can be watched together with a friend, family member, or neighbor. Afterward,
      simply ask if it made sense and whether they would like to respond to the invitation.
      Then walk with them in the first steps of their new life in Christ using the free
      <a href="https://app.jesusonline.com" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color:#de5b00;">JO App</a>
      and <a href={join("/books/adventure-of-living-with-jesus")} class="italic hover:underline" style="color:#de5b00;">The Adventure of Living with Jesus</a>.
    </p>
  </div>
</section>

<style>
  .topic-chip {
    border-color: #0083de;
    color: #0b3c5d;
  }
  .topic-chip:hover,
  .topic-chip:focus-visible {
    background-color: #0083de;
    color: #ffffff;
    outline: none;
  }
</style>

{/* Quick links — Reviews · About · Beliefs · JO APP */}
<section style="background-color:#0083de;">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 divide-white/15 sm:gap-y-px lg:divide-x lg:divide-white/15">
      {quickLinks.map(link => {
        const Icon = link.icon;
        return (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="group flex items-center justify-start lg:justify-center gap-4 py-5 px-6 transition-colors hover:bg-white/5"
          >
            <div class="w-11 h-11 rounded shrink-0 flex items-center justify-center" style="background-color:rgba(255,255,255,0.18);">
              <Icon className="w-5 h-5" style={{ color: "#ffffff" }} />
            </div>
            <div class="text-left">
              <div class="text-lg md:text-xl font-semibold text-white leading-tight tracking-wide group-hover:underline" style='font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'>{link.title}</div>
              <div class="text-[11px] mt-1 font-medium tracking-widest uppercase" style="color:rgba(255,255,255,0.8);">{link.subtitle}</div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
