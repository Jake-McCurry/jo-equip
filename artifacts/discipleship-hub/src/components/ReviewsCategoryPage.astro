---
/**
 * Shared body for the four Reviews pages (one per category).
 *
 * Layout per the July 2026 refinements doc:
 *   1. Page header
 *   2. Review-category options (links to the four pages)
 *   3. "Share your review to encourage others." link — deliberately placed
 *      BELOW the options and ABOVE the category title so every visitor
 *      scrolls past the invitation on every category page.
 *   4. The active category's reviews
 *   5. Share Your Review card linking to the /reviews/share form
 */
import { Mail } from "lucide-react";
import { reviewCategories } from "@/data/reviews";

interface Props {
  activeId: string;
}

const { activeId } = Astro.props;
const active = reviewCategories.find(c => c.id === activeId);
if (!active) throw new Error(`Unknown review category: ${activeId}`);

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

/** General lives at /reviews; the other categories at /reviews/<id>. */
const categoryPath = (id: string) => (id === "general" ? "/reviews" : `/reviews/${id}`);
const sharePath = join(`/reviews/share?category=${activeId}`);
---
<div class="container mx-auto px-4 py-12 md:py-16">
  <div class="max-w-3xl mb-10">
    <div class="text-xs font-semibold tracking-widest uppercase mb-3" style="color:#0083de;">From Pastors and Leaders</div>
    <h1 class="text-4xl md:text-5xl mb-4" style="color:#0b3c5d;">Reviews</h1>
    <div class="h-0.5 w-12 mb-5" style="background-color:#de5b00;"></div>
    <p class="leading-relaxed text-lg" style="color:var(--color-muted-foreground);">
      For many years, pastors, evangelists, and missionaries around the world
      have used these JesusOnline articles and videos to clearly present the
      Gospel, answer tough questions, and disciple people into a vibrant
      relationship with Christ. Hear what they're saying.
    </p>
  </div>

  {/* Category options */}
  <nav aria-label="Review categories" class="flex flex-wrap gap-2 mb-8">
    {reviewCategories.map(cat => (
      <a
        href={join(categoryPath(cat.id))}
        aria-current={cat.id === activeId ? "page" : undefined}
        class="text-sm font-semibold px-4 py-2 border rounded transition-colors hover:shadow-sm"
        style={
          cat.id === activeId
            ? "color:#ffffff;background-color:#0b3c5d;border-color:#0b3c5d;border-left:3px solid #de5b00;"
            : "color:#0b3c5d;background-color:#ffffff;border-color:var(--color-border);border-left:3px solid #de5b00;"
        }
      >
        {cat.name}
      </a>
    ))}
  </nav>

  {/* Share invitation — always between the options and the category title. */}
  <p class="mb-10">
    <a href={sharePath} class="underline underline-offset-4 hover:opacity-80 transition-opacity" style="color:#de5b00;">
      Share your review to encourage <span class="whitespace-nowrap">others.<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline-block align-[-2px] ml-1.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
    </a>
  </p>

  <div class="max-w-5xl">
    <section>
      <h2 class="text-2xl md:text-3xl mb-1" style="color:#0b3c5d;">{active.name}</h2>
      <div class="h-0.5 w-10 mb-6" style="background-color:#de5b00;"></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {active.reviews.map(r => (
          <figure
            class="bg-white border rounded px-5 py-5 flex flex-col"
            style="border-color:var(--color-border);border-left:4px solid #de5b00;"
          >
            <blockquote class="text-[15px] leading-relaxed flex-grow" style="color:#374151;">
              &ldquo;{r.quote}&rdquo;
            </blockquote>
            <figcaption class="mt-4 text-sm font-semibold" style="color:#0b3c5d;">
              &mdash;{r.author}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>

  <div class="max-w-3xl mt-16">
    <div class="bg-white border rounded p-8 text-center" style="border-color:var(--color-border);border-top:4px solid #de5b00;">
      <div class="w-12 h-12 mx-auto rounded-full flex items-center justify-center mb-4" style="background-color:rgba(0,131,222,0.1);">
        <Mail className="w-6 h-6" style={{ color: "#0083de" }} />
      </div>
      <h2 class="text-2xl mb-2" style="color:#0b3c5d;">Share Your Review</h2>
      <p class="text-base leading-relaxed mb-6 max-w-xl mx-auto" style="color:var(--color-muted-foreground);">
        Share your story to encourage others. How has JO EQUIP helped you?
        We'd love to hear from you.
      </p>
      <a
        href={sharePath}
        class="inline-flex items-center px-6 py-3 font-semibold rounded text-white transition-colors"
        style="background-color:#0083de;"
      >
        <Mail className="w-4 h-4 mr-2" />
        Share your review
      </a>
    </div>

    <div class="text-center mt-8">
      <a href={join("/")} class="text-sm hover:underline" style="color:#de5b00;">
        &larr; Back to home
      </a>
    </div>
  </div>
</div>
