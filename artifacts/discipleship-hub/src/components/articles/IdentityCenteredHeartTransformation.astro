---
import Layout from "@/layouts/Layout.astro";
import { ArrowRight, Download, Sparkles } from "lucide-react";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";
import type { SubTopic, Channel } from "@/data/channels";

interface Props {
  article: any;
  sub: SubTopic;
  channel: Channel;
  heroTitle: { main: string; paren: string | null };
  nextArticle?: { id: string; title: string };
  pdfHref?: string | null;
  joAppArticleUrl?: string | null;
  articleJsonLd: any;
  metaTitle: string;
  metaDescription: string;
}

const {
  article,
  sub,
  channel,
  heroTitle,
  nextArticle,
  pdfHref,
  joAppArticleUrl,
  articleJsonLd,
  metaTitle,
  metaDescription
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) => (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

function splitTitle(t: string): { main: string; paren: string | null } {
  const m = t.match(/^(.*?)\s*(\([^)]*\))\s*$/);
  return m ? { main: m[1], paren: m[2] } : { main: t, paren: null };
}

// Group blocks by H2
const groups: { title: string; h2: any; blocks: any[] }[] = [];
let currentGroup = { title: "Intro", h2: null, blocks: [] as any[] };
for (const b of article.blocks) {
  if (b.type === "h2") {
    groups.push(currentGroup);
    currentGroup = { title: b.text, h2: b, blocks: [] };
  } else {
    currentGroup.blocks.push(b);
  }
}
groups.push(currentGroup);

const preparedGroups = groups.map((group) => {
  const title = group.title;
  const isIntro = title === "Intro";
  const isFourComponents = title === "Four Key Components";

  return {
    ...group,
    isIntro,
    isFourComponents,
  };
});

---

<Layout title={metaTitle} description={metaDescription}>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "Categories", url: "/categories" },
      { name: channel.shortName, url: `/categories/${channel.id}` },
      { name: sub.name, url: `/categories/${channel.id}/${sub.id}` },
      { name: article.title, url: `/categories/${channel.id}/${sub.id}/${article.id}` },
    ]} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
  </Fragment>

  <header class="relative bg-slate-900 text-white overflow-hidden pb-16 pt-20 md:pb-24 md:pt-32" style={`background: ${channel.gradient};`}>
    <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.1) 0, rgba(255,255,255,0.1) 1px, transparent 1px, transparent 20px);"></div>
    <div class="absolute -right-40 -top-40 w-96 h-96 bg-white opacity-5 rounded-full blur-3xl"></div>
    <div class="absolute -left-20 bottom-0 w-72 h-72 bg-white opacity-5 rounded-full blur-3xl"></div>
    
    <div class="container mx-auto px-4 md:px-6 relative z-10 max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-white/90 text-xs font-bold uppercase tracking-widest mb-6 backdrop-blur-sm border border-white/20">
        <Sparkles className="w-3 h-3" />
        {splitTitle(sub.name).main}
      </div>
      
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-semibold tracking-tight leading-[1.1] mb-6 text-white text-balance">
        {heroTitle.main}
      </h1>
      
      {heroTitle.paren && (
        <p class="text-xl md:text-2xl text-white/80 font-light mb-8">
          {heroTitle.paren}
        </p>
      )}
    </div>
  </header>

  <div class="bg-slate-50/50">
    <div class="container mx-auto px-4 py-6 max-w-4xl">
      <div class="flex items-center justify-between gap-4 flex-wrap border-b border-slate-200 pb-6 mb-8">
        <nav class="flex items-center text-sm font-medium flex-wrap gap-2 text-slate-500">
          <a href={join("/categories")} class="transition-colors hover:text-slate-900">Categories</a>
          <span class="text-slate-300">/</span>
          <a href={join(`/categories/${channel.id}`)} class="transition-colors hover:text-slate-900">{channel.shortName}</a>
          <span class="text-slate-300">/</span>
          <a href={join(`/categories/${channel.id}/${sub.id}`)} class="transition-colors hover:text-slate-900">{splitTitle(sub.name).main}</a>
        </nav>
        {pdfHref && (
          <a href={pdfHref} download data-track-title={article.title} class="inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-full border-2 transition-colors hover:text-white" style={`color:${channel.accentColor};border-color:${channel.accentColor};`} onmouseover={`this.style.backgroundColor='${channel.accentColor}';`} onmouseout="this.style.backgroundColor='transparent';">
            <Download className="w-4 h-4" /> Download PDF
          </a>
        )}
      </div>

      <article class="space-y-20 pb-20 mt-12">
        {preparedGroups.map((group) => (
          <Fragment>
            {group.isIntro && (
              <section class="max-w-3xl mx-auto prose-p:text-lg prose-p:leading-relaxed prose-p:text-slate-700 space-y-6">
                {group.blocks.map((b: any, i: number) => (
                  <Fragment>
                    {i === 0 && b.type === "p" ? (
                      <p class="text-2xl md:text-3xl text-slate-900 font-medium leading-snug mb-10 text-balance" set:html={b.html} />
                    ) : b.type === "ul" ? (
                      <div class="grid sm:grid-cols-2 gap-4 my-10 not-prose">
                        {b.items.map((item: string, idx: number) => (
                          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm relative overflow-hidden group">
                            <div class={`absolute top-0 left-0 w-1 h-full ${idx === 0 ? 'bg-slate-300' : 'bg-[#0095ff]'}`}></div>
                            <p class="text-slate-700 font-medium leading-relaxed" set:html={item}></p>
                          </div>
                        ))}
                      </div>
                    ) : b.type === "p" ? (
                      <p set:html={b.html} />
                    ) : b.type === "ol" ? (
                      <ol class="list-decimal pl-6 space-y-2">{b.items.map((item: string) => <li set:html={item} />)}</ol>
                    ) : null}
                  </Fragment>
                ))}
              </section>
            )}

            {group.isFourComponents && (
              <section class="max-w-4xl mx-auto bg-slate-900 rounded-3xl p-8 md:p-12 shadow-xl text-white my-16">
                <h2 class="text-3xl md:text-4xl font-semibold mb-10 text-center" style="color:#ffffff;">{group.title}</h2>
                {group.blocks.map((b: any) => (
                  <Fragment>
                    {b.type === "ol" ? (
                      <div class="grid sm:grid-cols-2 gap-6 mb-10">
                        {b.items.map((item: string, idx: number) => {
                           const match = item.match(/<strong>(.*?)<\/strong>\s*:?\s*(.*)/);
                            const title = match ? match[1] : `Component ${idx + 1}`;
                           const body = match ? match[2] : item;
                           return (
                             <div class="bg-white/10 border border-white/10 rounded-2xl p-6 backdrop-blur-sm flex flex-col gap-3">
                               <div class="flex items-center gap-3">
                                  <div class="flex items-center justify-center w-8 h-8 rounded-full bg-white/20 text-white font-bold text-sm">
                                    {idx + 1}
                                  </div>
                                   <h3 class="text-xl font-semibold" style="color:#ffffff;" set:html={title}></h3>
                               </div>
                                <p class="leading-relaxed text-sm md:text-base" style="color:#f8fafc;" set:html={body}></p>
                             </div>
                           );
                        })}
                      </div>
                    ) : b.type === "p" ? (
                       <p class="text-center text-white/90 max-w-2xl mx-auto text-lg leading-relaxed mb-6" set:html={b.html} />
                    ) : null}
                  </Fragment>
                ))}
              </section>
            )}

            {!group.isIntro && !group.isFourComponents && (
              <section class="max-w-3xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-semibold text-slate-900 mb-8 pb-3 border-b-2 border-slate-200">{group.title}</h2>
                <div class="space-y-6 text-slate-700 text-lg leading-relaxed">
                  {group.blocks.map((b: any) => (
                    <Fragment>
                      {b.type === "p" ? (
                        <p set:html={b.html} />
                      ) : b.type === "h3" ? (
                        <h3 class={`text-2xl font-semibold text-slate-900 pt-8 ${/^\d+\./.test(b.text) ? "mt-12 border-t border-slate-200" : "mt-8"}`}>{b.text}</h3>
                      ) : b.type === "ul" ? (
                        <ul class="space-y-3 my-7 pl-6 border-l-4 border-slate-200">
                          {b.items.map((item: string) => <li class="pl-2" set:html={item} />)}
                        </ul>
                      ) : b.type === "ol" ? (
                        <ol class="space-y-3 my-7 pl-8 list-decimal marker:font-semibold">
                          {b.items.map((item: string) => <li class="pl-2" set:html={item} />)}
                        </ol>
                      ) : b.type === "table" ? (
                        <div class="overflow-x-auto my-8 rounded-2xl border border-slate-200 bg-white shadow-sm">
                          <table class="w-full border-collapse text-left text-base">
                            <thead class="bg-slate-900 text-white">
                              <tr>
                                {b.headers.map((header: string) => <th scope="col" class="px-5 py-4 font-semibold" style="color:#ffffff;" set:html={header} />)}
                              </tr>
                            </thead>
                            <tbody>
                              {b.rows.map((row: string[], rowIndex: number) => (
                                <tr class={rowIndex % 2 ? "bg-slate-50" : "bg-white"}>
                                  {row.map((cell: string) => <td class="px-5 py-4 align-top border-t border-slate-200" set:html={cell} />)}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      ) : null}
                    </Fragment>
                  ))}
                </div>
              </section>
            )}
          </Fragment>
        ))}
      </article>

      <div class="max-w-3xl mx-auto border-t border-slate-200 pt-12 pb-16">
        {nextArticle && nextArticle.id !== article.id && (
          <a href={join(`/categories/${channel.id}/${sub.id}/${nextArticle.id}`)} class="group block p-8 rounded-3xl border-2 transition-all hover:shadow-md" style={`border-color:${channel.accentColor};background-color:${channel.accentColor}06;`}>
            <div class="flex items-center justify-between gap-6">
              <div>
                <div class="text-xs font-bold uppercase tracking-widest mb-2" style={`color:${channel.accentColor};`}>Next Article</div>
                <h3 class="text-2xl font-semibold group-hover:underline text-slate-900">{nextArticle.title}</h3>
                <p class="text-slate-500 mt-2">Continue exploring {sub.name}</p>
              </div>
              <div class="shrink-0 w-14 h-14 rounded-full flex items-center justify-center transition-transform group-hover:translate-x-2 shadow-sm" style={`background-color:${channel.accentColor};`}>
                <ArrowRight className="w-6 h-6 text-white" />
              </div>
            </div>
          </a>
        )}

        {joAppArticleUrl && (
          <div class="mt-8 text-center">
            <a
              href={joAppArticleUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full border-2 px-8 py-3.5 text-sm font-semibold transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
              style={`color:${channel.accentColor};border-color:${channel.accentColor};outline-color:${channel.accentColor};`}
              onmouseover={`this.style.backgroundColor='${channel.accentColor}';`}
              onmouseout="this.style.backgroundColor='transparent';"
            >
              Find this article on the JO App
            </a>
          </div>
        )}
      </div>

    </div>
  </div>
</Layout>
