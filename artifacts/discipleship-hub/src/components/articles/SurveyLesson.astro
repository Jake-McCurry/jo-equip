---
/**
 * Web-only reformat shared by EVERY Survey of the Bible lesson (OT + NT).
 * Renders the EXISTING source blocks in source order (no rewritten wording);
 * structure is detected by ./surveyLesson.ts. Gated in [articleId].astro to
 * church / survey-of-the-bible-ot|nt. Genesis is the approved reference.
 */
import type { ArticleBlock } from "@/data/bcgArticles";
import { buildSurveyLesson, splitNote, surveyToc, type Body } from "./surveyLesson";
import { linkSurveyScripture, surveyBookContext } from "./surveyScriptureLinks";
import ScripturePreview from "./ScripturePreview.astro";

interface Props { blocks: ArticleBlock[]; accent: string; base: string; articleId: string; title: string }
const { blocks, accent, base, articleId, title } = Astro.props;
const book = surveyBookContext(title);
const link = (html: string) => linkSurveyScripture(html, base, book);
const nodes = buildSurveyLesson(blocks as never, articleId);
const toc = surveyToc(nodes);
const compactToc = toc.length > 8;
const plainLen = (h: string) => h.replace(/<[^>]+>/g, "").length;
---
<article class="gen" style={`--gen-accent:${accent};`}>
  {nodes.map((n, idx) => {
    if (n.kind === "intro") return n.html ? (
      <section class="gen-intro" aria-label={n.label.replace(/[.:]$/, "")}>
        <p class="gen-intro-label">{n.label.replace(/[.:]$/, "")}<span class="sr-only">{n.label.slice(-1)}</span></p>
        <p class="gen-intro-text" set:html={link(n.html)} />
      </section>
    ) : (
      <p class="gen-intro-label gen-kicker">{n.label.replace(/[.:]$/, "")}<span class="sr-only">{n.label.slice(-1)}</span></p>
    );
    if (n.kind === "credit") return <p class="gen-credit" set:html={n.html} />;
    const body = (items: Body[]) => items.map(b => {
      if (b.kind === "h3") return <h3 class="gen-h3">{b.marker && <span class="gen-marker">{b.marker}</span>} <span set:html={b.html} /></h3>;
      if (b.kind === "p") {
        const { main, note } = splitNote(b.html);
        return (
          <div class="gen-para">
            <p set:html={link(main)} />
            {note !== null && <aside class="gen-note" aria-label="Note"><span class="gen-note-label">Note:</span> <span set:html={link(note)} /></aside>}
          </div>
        );
      }
      if (b.kind === "ul") return (
        <ul class="gen-bullets">{b.items.map(i => <li><span class="gen-dot" aria-hidden="true"></span><div class="gen-point"><p set:html={link(i)} /></div></li>)}</ul>
      );
      return (
        <ol class="gen-points">
          {b.items.map((item, i) => {
            const { main, note } = splitNote(item);
            return (
              <li>
                <span class="gen-num" aria-hidden="true">{i + 1}.</span>
                <div class="gen-point">
                  <p set:html={link(main)} />
                  {note !== null && (
                    <aside class="gen-note" aria-label="Note">
                      <span class="gen-note-label">Note:</span> <span set:html={link(note)} />
                    </aside>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      );
    });
    const tocBlock = toc.length > 0 && (idx === nodes.findIndex(x => x.kind === "section" || x.kind === "discussion")) && (
      compactToc ? (
        <nav class="gen-toc gen-toc--compact" aria-label="On this page">
          <details>
            <summary><span class="gen-toc-label">On this page</span> <span class="gen-toc-count">{toc.length} sections</span></summary>
            <ul>{toc.map(t => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
          </details>
        </nav>
      ) : (
        <nav class="gen-toc" aria-label="On this page">
          <p class="gen-toc-label">On this page</p>
          <ul>{toc.map(t => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
        </nav>
      )
    );
    if (n.kind === "loose") return <div class="gen-loose">{body(n.body)}</div>;
    if (n.kind === "discussion") return (
      <Fragment>
        {tocBlock}
        <section class="gen-discussion" id={n.id} aria-labelledby={`${n.id}-h`}>
          <h2 id={`${n.id}-h`} class="gen-h2"><span>{n.heading}</span></h2>
          {n.html && <p class="gen-disc-intro" set:html={link(n.html)} />}
          {body(n.body)}
        </section>
      </Fragment>
    );
    const long = plainLen(n.title) > 90;
    return (
      <Fragment>
        {tocBlock}
        <section class:list={["gen-section", { "gen-section--overview": n.tone === "overview" }]} id={n.id} aria-labelledby={`${n.id}-h`}>
          {n.range && n.rangeFirst && <p class="gen-range">{n.range}</p>}
          <h2 id={`${n.id}-h`} class:list={["gen-h2", { "gen-h2--long": long }]}>
            {n.marker && <span class="gen-marker">{n.marker}</span>} <span set:html={n.title} />
          </h2>
          {n.range && !n.rangeFirst && <p class="gen-range">{n.range}</p>}
          {n.lead && <p class="gen-lead" set:html={link(n.lead)} />}
          {body(n.body)}
        </section>
      </Fragment>
    );
  })}
</article>
<ScripturePreview />

<style>
  .gen { color: #1f2937; font-size: 1.0625rem; line-height: 1.75; max-width: 40rem; margin-inline: auto; }
  .gen :global(a) { color: var(--gen-accent); text-decoration: underline; text-underline-offset: 2px; }
  .gen :global(a:hover) { text-decoration-thickness: 2px; }
  .gen :global(a.scripture-ref) { text-decoration-style: dotted; white-space: nowrap; font-weight: 500; }
  .gen :global(a.scripture-ref:hover) { text-decoration-style: solid; }
  .gen :global(a:focus-visible) { outline: 2px solid var(--gen-accent); outline-offset: 2px; border-radius: 2px; }

  .gen-intro {
    border-left: 4px solid var(--gen-accent);
    background: color-mix(in srgb, var(--gen-accent) 7%, transparent);
    border-radius: 0 6px 6px 0;
    padding: 1.15rem 1.35rem 1.25rem;
  }
  .gen-intro-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gen-accent); margin: 0 0 0.35rem; }
  .gen-kicker { margin: 0; }
  .gen-intro-text { margin: 0; font-size: 1.125rem; line-height: 1.7; color: var(--color-text); }

  .gen-toc { margin-top: 1.75rem; }
  .gen-toc-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #6b7280; margin: 0 0 0.6rem; }
  .gen-toc ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .gen-toc a {
    display: inline-block; font-size: 0.875rem; line-height: 1.3; padding: 0.4rem 0.75rem; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--gen-accent) 30%, transparent);
    color: var(--gen-accent); text-decoration: none; transition: background-color .15s ease;
  }
  .gen-toc a:hover { background: color-mix(in srgb, var(--gen-accent) 9%, transparent); text-decoration: none; }
  .gen-toc--compact details { border: 1px solid color-mix(in srgb, var(--gen-accent) 22%, transparent); border-radius: 8px; padding: 0.7rem 0.95rem; }
  .gen-toc--compact summary { cursor: pointer; display: flex; align-items: baseline; gap: 0.6rem; list-style-position: inside; }
  .gen-toc--compact summary .gen-toc-label { margin: 0; color: var(--gen-accent); }
  .gen-toc-count { font-size: 0.8125rem; color: #6b7280; }
  .gen-toc--compact ul { margin-top: 0.8rem; gap: 0.35rem; }
  .gen-toc--compact a { font-size: 0.8125rem; padding: 0.3rem 0.65rem; }
  .gen-toc--compact summary:focus-visible { outline: 2px solid var(--gen-accent); outline-offset: 3px; border-radius: 4px; }

  .gen-section { margin-top: 2.75rem; padding-top: 2.25rem; border-top: 1px solid #e7e2ee; scroll-margin-top: 7rem; }
  .gen-section--overview {
    border-top: 0; padding: 1.4rem 1.35rem 1.5rem; border-radius: 0 6px 6px 0;
    border-left: 4px solid var(--gen-accent);
    background: color-mix(in srgb, var(--gen-accent) 7%, transparent);
  }
  .gen-range { margin: 0 0 0.35rem; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280; }
  .gen-h2 + .gen-range { margin: 0.35rem 0 0; }
  .gen-h2 { margin: 0; font-size: 1.75rem; line-height: 1.25; font-weight: 600; color: var(--color-text); }
  .gen-h2--long { font-size: 1.3rem; line-height: 1.4; }
  .gen-section--overview .gen-h2 { font-size: 1.4rem; }
  .gen-marker { color: var(--gen-accent); font-weight: 700; margin-right: 0.2rem; }
  .gen-h3 { margin: 1.75rem 0 0; font-size: 1.15rem; line-height: 1.35; font-weight: 600; color: var(--color-text); }
  .gen-lead { margin: 0.9rem 0 0; }
  .gen-para { margin-top: 1rem; }
  .gen-para p { margin: 0; }
  .gen-loose > :first-child { margin-top: 0; }

  .gen-points { list-style: none; padding: 0; margin: 1.35rem 0 0; }
  .gen-points > li { display: grid; grid-template-columns: 2.1rem 1fr; gap: 0 0.25rem; margin-top: 1.15rem; }
  .gen-points > li:first-child { margin-top: 0; }
  .gen-num { font-weight: 700; color: var(--gen-accent); font-variant-numeric: tabular-nums; text-align: right; padding-right: 0.55rem; }
  .gen-point p { margin: 0; }
  .gen-bullets { list-style: none; padding: 0; margin: 1.1rem 0 0 2.35rem; }
  .gen-bullets > li { display: grid; grid-template-columns: 1.1rem 1fr; margin-top: 0.75rem; }
  .gen-dot { width: 6px; height: 6px; margin-top: 0.7rem; border-radius: 50%; background: color-mix(in srgb, var(--gen-accent) 70%, transparent); }

  .gen-note {
    margin-top: 0.85rem; padding: 0.8rem 1rem; font-size: 0.98rem; line-height: 1.7;
    border-left: 3px solid color-mix(in srgb, var(--gen-accent) 55%, transparent);
    background: color-mix(in srgb, var(--gen-accent) 5%, transparent); border-radius: 0 4px 4px 0;
  }
  .gen-note-label { font-weight: 700; color: var(--gen-accent); }

  .gen-discussion {
    margin-top: 3rem; padding: 1.75rem 1.5rem 1.9rem; border-radius: 8px; scroll-margin-top: 7rem;
    background: color-mix(in srgb, var(--gen-accent) 6%, #faf8fc);
    border: 1px solid color-mix(in srgb, var(--gen-accent) 18%, transparent);
  }
  .gen-discussion .gen-h2 { font-size: 1.5rem; }
  .gen-disc-intro { margin: 0.75rem 0 0; color: #374151; font-style: italic; }
  .gen-discussion .gen-point :global(strong) { font-weight: inherit; }

  .gen-credit { margin-top: 2.5rem; font-size: 0.9rem; color: #6b7280; }

  @media (max-width: 640px) {
    .gen-h2 { font-size: 1.45rem; }
    .gen-h2--long { font-size: 1.2rem; }
    .gen-points > li { grid-template-columns: 1.75rem 1fr; }
    .gen-bullets { margin-left: 2rem; }
    .gen-discussion { padding: 1.35rem 1rem 1.5rem; }
    .gen-section--overview { padding: 1.15rem 1rem 1.25rem; }
  }
</style>
