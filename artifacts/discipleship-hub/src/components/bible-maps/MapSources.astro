---
/* Source and license credits for pages that use the Bible maps / timeline data.
   Keep in step with scripts/data/bible-search-sources.md. */
interface Props { uses: ("openbible" | "naturalearth" | "theographic" | "easton" | "journeys")[] }
const { uses } = Astro.props;
const ext = { target: "_blank", rel: "noopener noreferrer" };
---
<section class="bmp-sources" aria-labelledby="bmp-sources-h">
  <h2 id="bmp-sources-h">Sources and licenses</h2>
  <ul>
    {uses.includes("openbible") && (
      <li>
        Place identifications, coordinates and confidence scores: <a href="https://www.openbible.info/geo/" {...ext}>OpenBible.info Bible Geocoding Data</a>,
        licensed <a href="https://creativecommons.org/licenses/by/4.0/" {...ext}>CC BY 4.0</a>. Scores show how strongly current scholarship supports each identification.
      </li>
    )}
    {uses.includes("theographic") && (
      <li>
        Events, dates, people and event locations: <a href="https://theographic.netlify.app/" {...ext}>Theographic Bible Metadata</a> by Robert Rouse,
        licensed <a href="https://creativecommons.org/licenses/by-sa/4.0/" {...ext}>CC BY-SA 4.0</a>. The timeline adapts this data (grouping into eras and
        linking verses); the adapted timeline data is shared under the same license.
      </li>
    )}
    {uses.includes("easton") && (
      <li>Dictionary article: <em>Easton&rsquo;s Bible Dictionary</em> by M. G. Easton (1897, public domain), as distributed with Theographic Bible Metadata (<a href="https://creativecommons.org/licenses/by-sa/4.0/" {...ext}>CC BY-SA 4.0</a>).</li>
    )}
    {uses.includes("journeys") && (
      <li>
        Journey routes: drawn by JO EQUIP from the places Scripture names, in the order the cited verses give them, using the OpenBible.info locations above.
        Lines between stops show the general direction of travel, not exact roads or sea lanes; routes marked as debated (such as the Exodus) follow one traditional proposal.
      </li>
    )}
    {uses.includes("naturalearth") && (
      <li>Base map: coastlines, lakes and rivers from <a href="https://www.naturalearthdata.com/" {...ext}>Natural Earth</a> (public domain). They are modern, not ancient.</li>
      <li>
        Terrain shading and elevation colors: drawn by JO EQUIP from <a href="https://registry.opendata.aws/terrain-tiles/" {...ext}>Terrain Tiles on AWS</a>,
        which combine public-domain elevation data including SRTM (NASA/USGS), GMTED2010 (USGS) and ETOPO1 (NOAA), with EU-DEM
        (produced using Copernicus data and information funded by the European Union).
      </li>
    )}
  </ul>
  <p>All of this data is hosted on JO EQUIP; the maps make no requests to outside map services.</p>
</section>
