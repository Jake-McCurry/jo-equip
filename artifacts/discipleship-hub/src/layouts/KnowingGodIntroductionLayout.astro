---
import "@/styles/global.css";
import "@/styles/knowing-god-theme.css";
import EquipHeader from "@/components/EquipHeader.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const join = (path: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + path;
const pageTitle = `${title} | Knowing God Topical Bible | JO EQUIP`;
const canonicalUrl = `https://equip.jesusonline.com${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={join("/favicon.svg")} />
    <link rel="apple-touch-icon" href={join("/favicon.svg")} />
    <meta name="theme-color" content="#003A66" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://equip.jesusonline.com/opengraph.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="kg-intro-body flex flex-col min-h-screen">
    <div class="kg-equip-navigation">
      <EquipHeader />
    </div>
    <div class="kg-warm-theme kg-intro-theme-wrapper flex-1">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  .kg-equip-navigation { display: contents; }
  @media print { .kg-equip-navigation { display: none; } }
  .kg-intro-theme-wrapper {
    background: var(--color-surface, #FFFDFB);
    color: var(--color-text, #003A66);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .kg-intro-body {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--color-surface, #FFFDFB);
    color: var(--color-text, #003A66);
    font-family: var(--font-sans, 'Source Sans 3', system-ui, sans-serif);
    font-size: 16px;
  }
  .kg-intro-eyebrow {
    display: block;
    font-family: var(--font-sans, 'Source Sans 3', system-ui, sans-serif);
    font-size: .75rem; /* ~12px */
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .kg-intro-main {
    max-width: 1040px;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }
  .kg-intro-breadcrumbs {
    margin-bottom: 2.2rem;
    color: var(--color-text-muted, #2E5A7A);
    font-family: var(--font-sans, 'Source Sans 3', system-ui, sans-serif);
    font-size: .75rem;
  }
  .kg-intro-breadcrumbs a { color: var(--color-hero, #006BB3); }
  .kg-intro-eyebrow { color: var(--color-action-warm, #C45100); }
  .kg-intro-title {
    max-width: 850px;
    margin: .6rem 0 1rem;
    color: var(--color-hero, #006BB3);
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: .98;
  }
  .kg-intro-lede {
    max-width: 760px;
    margin: 0;
    color: var(--color-text-muted, #2E5A7A);
    font-family: var(--font-sans, 'Source Sans 3', system-ui, sans-serif);
    font-size: clamp(1.1rem, 2.3vw, 1.35rem);
    font-style: italic;
    line-height: 1.6;
  }
  @media (max-width: 620px) {
    .kg-intro-main { padding-top: 2rem; }
  }
</style>
