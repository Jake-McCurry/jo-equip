---
import "@/styles/global.css";
import { Image } from "astro:assets";
import logoSrc from "@/assets/jol-logo-white.png";
import EquipHeader from "@/components/EquipHeader.astro";

interface Props {
  title?: string;
  description?: string;
  /** Override the OG/Twitter image. May be site-relative or an absolute URL. */
  image?: string;
  /** Alt text for the OG/Twitter image. Defaults to the site tagline. */
  imageAlt?: string;
  /** Override the header/nav blue (used to trial new brand colors per-page). */
  navColor?: string;
  /** Open Graph content type; video watch pages use "video.other". */
  ogType?: "website" | "article" | "video.other";
}

const {
  title = "JO EQUIP · Ministry Resources Hub",
  description = "A free digital library of practical discipleship tools for pastors and ministry leaders.",
  image = "/opengraph.jpg",
  imageAlt = "JO EQUIP — Ministry Resources Hub",
  navColor = "#0095ff",
  ogType = "website",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

// Active-state detection — strip the base prefix from current path first
const rawPath = Astro.url.pathname;
const stripBase = (p: string) => {
  const b = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  if (b && p.startsWith(b)) return p.slice(b.length) || "/";
  return p;
};
const currentPath = stripBase(rawPath);

const year = new Date().getFullYear();

// Canonical URL — always points at the production site, base-prefix-free.
// This is what we want indexed regardless of dev/preview hosts.
const SITE = "https://equip.jesusonline.com";
const canonicalPath = currentPath === "/" ? "/" : currentPath.replace(/\/$/, "");
const canonicalUrl = SITE + canonicalPath;
const absoluteImage = /^https?:\/\//i.test(image) ? image : SITE + image;

// GTM container ID — public identifier, safe to commit.
// Gated on PROD so dev/preview builds don't pollute analytics.
const GTM_ID = "GTM-PKJQNCS";
const gtmEnabled = import.meta.env.PROD;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={join("/favicon.svg")} />
    <link rel="apple-touch-icon" href={join("/favicon.svg")} />
    <meta name="theme-color" content="#0095ff" />

    {/* Early-connection hints — get DNS+TLS done before scripts request these origins.
        These don't initiate downloads; they just warm the connection so when GTM
        injects its tags, GA4 fires, or YouTube thumbnails load, those requests
        skip ~100–300 ms of handshake latency. */}
    {gtmEnabled && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
      </>
    )}
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://app.jesusonline.com" />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="JO EQUIP · Ministry Resources Hub" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {/* Width/height hints only apply to the default 1200×630 site OG.
        For per-page overrides (e.g. book covers), let crawlers detect dims
        on their own rather than lying about them. */}
    {image === "/opengraph.jpg" && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    {/* Twitter / X card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Per-page additions (e.g. JSON-LD) */}
    <slot name="head" />

    {/* Google Tag Manager + Crazy Egg — production-only so dev builds don't
        pollute analytics. Both run on the MAIN THREAD (GTM was previously
        routed through Partytown, which hid the container from Tag Assistant /
        GTM Preview mode / third-party scanners — do NOT re-wrap in Partytown),
        but their network load is DEFERRED until the browser is idle after the
        `load` event (requestIdleCallback, 3s fallback timeout). On mobile,
        GTM + its container tags + Crazy Egg cost ~4s of main-thread time; the
        deferral moves that off the critical path (PSI mobile ~59 → ~90,
        July 2026). The dataLayer is initialized immediately so any events
        pushed before GTM loads are queued, and the injected GTM bootstrap is
        the official snippet verbatim, so Tag Assistant still detects it once
        loaded. Trade-off (accepted): visitors who bounce within the first
        ~1–3s may not be counted, and session recordings start a beat later.
        Crazy Egg account script: 0010/0959. */}
    {gtmEnabled && (
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];(function(){var loaded=false;function loadTags(){if(loaded)return;loaded=true;(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');var ce=document.createElement('script');ce.async=true;ce.src='https://script.crazyegg.com/pages/scripts/0010/0959.js';document.head.appendChild(ce);}function onIdle(){if('requestIdleCallback'in window){requestIdleCallback(loadTags,{timeout:3000});}else{setTimeout(loadTags,1500);}}if(document.readyState==='complete'){onIdle();}else{window.addEventListener('load',onIdle);}})();`} />
    )}
  </head>
  <body class="min-h-[100dvh] flex flex-col">

    {/* Skip-to-main-content link for keyboard users (visually hidden until focused). */}
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    {/* GTM noscript fallback */}
    {gtmEnabled && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}

    {/* Header */}
    <EquipHeader navColor={navColor} />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    {/* Footer */}
    <footer class="pt-12 pb-8" style="background-color:#002f55;">
      <div class="container mx-auto px-4 md:px-6">
        <div class="flex flex-col md:flex-row justify-between items-start gap-10 pb-10" style="border-bottom:1px solid rgba(255,255,255,0.12);">
          <div class="max-w-xs">
            <div class="flex items-center gap-3 mb-2">
              <Image src={logoSrc} alt="JesusOnline" widths={[150, 300]} sizes="150px" format="webp" quality={85} class="h-6 w-auto" loading="lazy" />
              <span class="font-semibold text-base tracking-wide" style="color:#ffffff;">JO EQUIP</span>
            </div>
            <div class="mb-4">
              <span class="text-[10px] font-medium tracking-widest uppercase" style="color:rgba(255,255,255,0.55);">
                Ministry Resources Hub
              </span>
            </div>
            <p class="text-sm leading-relaxed mb-3" style="color:rgba(255,255,255,0.75);">
              A free digital library of practical discipleship tools for pastors and leaders for enhanced ministry impact.
            </p>
            <p class="text-xs" style="color:rgba(255,255,255,0.6);">
              equip.jesusonline.com
            </p>
          </div>

          <div class="flex gap-12 text-sm">
            <div class="flex flex-col gap-3">
              <h4 class="font-semibold text-sm" style="color:#ffffff;">Explore</h4>
              <a href={join("/categories")} class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">Categories</a>
              <a href={join("/playlists")} class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">Playlists</a>
              <a href={join("/books")} class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">Books</a>
              <a href={join("/listen")} class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">Listen</a>
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="font-semibold text-sm" style="color:#ffffff;">Organization</h4>
              <a href="https://jesusonlineministries.org" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">JesusOnlineMinistries.org</a>
              <a href={join("/about")} class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">About</a>
              <a href={join("/beliefs")} class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">Beliefs</a>
              <a href={join("/newsletter")} class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">Newsletter</a>
              <a href="mailto:equip@jesusonline.com" class="transition-colors hover:text-white" style="color:rgba(255,255,255,0.75);">equip@jesusonline.com</a>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs" style="color:rgba(255,255,255,0.7);">
          <p class="md:max-w-2xl md:text-left text-center">&copy; {year} JesusOnline Ministries. Site design and original JesusOnline content are protected by copyright. Third-party resources remain the property of their respective copyright owners and are used under license or permission.</p>
          <div class="flex gap-5">
            <a href={join("/sitemap")} class="hover:text-white transition-colors">Sitemap</a>
            <a href="https://jesusonlineministries.org/privacy-policy/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Privacy Policy</a>
          </div>
        </div>
      </div>
    </footer>

    {/* PDF action tracking → GTM dataLayer. PDF links default to a
        `pdf_download` event, while links explicitly marked as opens use
        `pdf_open`. The /books Open button calls window.__trackPdfOpen because
        it opens the PDF through JavaScript rather than a plain anchor. Both
        paths share one normalization function so parameters are identical.
        Canonical per-file key: pdf_path (resolved pathname, no query/hash,
        casing preserved). GTM can trigger separate GA4 events for `pdf_open`
        and `pdf_download`, mapping pdf_path / file_name / file_extension /
        file_title / file_category / link_url. */}
    <script is:inline set:html={`(function(){
      function push(eventName, url, title, category){
        try {
          /* Resolve to an absolute URL so relative hrefs, query strings and
             fragments all normalize the same way. Path casing is preserved. */
          var resolved = new URL(url || "", window.location.href);
          var path = resolved.pathname;
          var file = path.split("/").filter(Boolean).pop() || "";
          var extMatch = file.match(/\\.([a-z0-9]+)$/i);
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: eventName,
            pdf_path: path,
            file_name: file,
            file_extension: extMatch ? extMatch[1].toLowerCase() : "",
            file_title: (title || file.replace(/\\.pdf$/i, "")).trim().slice(0, 100),
            file_category: category,
            link_url: resolved.href
          });
        } catch (_e) { /* never break the click */ }
      }
      window.__trackPdfDownload = function(url, title, category){
        push("pdf_download", url, title, category);
      };
      window.__trackPdfOpen = function(url, title, category){
        push("pdf_open", url, title, category);
      };
      function onClick(e){
        /* Keep the two listeners strictly disjoint so no interaction can
           push twice: "click" handles primary button only; "auxclick"
           handles middle-click only (right-click never opens the PDF). */
        if (e.type === "click" && e.button !== 0) return;
        if (e.type === "auxclick" && e.button !== 1) return;
        var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
        if (!a || !a.href) return;
        /* Qualify on the RESOLVED URL's pathname (matches how GA4 Enhanced
           Measurement decides), not the raw href attribute. */
        var path;
        try { path = new URL(a.href, window.location.href).pathname; }
        catch (_e) { return; }
        if (!/\\.pdf$/i.test(path)) return;
        var category = /\\/books\\//.test(path) ? "book" : "article";
        var title = (a.getAttribute("data-track-title") || a.getAttribute("aria-label") || a.textContent || "").trim();
        /* Generic labels ("PDF", "Download PDF") aren't useful — fall back to
           the page's H1 so the event still says WHICH document it was. */
        if (title.length < 8 || /^(download|view|open|get)?\\s*(the\\s*)?pdf$/i.test(title)) {
          var h1 = document.querySelector("h1");
          title = (h1 && h1.textContent ? h1.textContent : title).trim();
        }
        var action = a.getAttribute("data-pdf-action") === "open" ? "pdf_open" : "pdf_download";
        push(action, a.href, title, category);
      }
      document.addEventListener("click", onClick, true);
      document.addEventListener("auxclick", onClick, true);
    })();`} />
  </body>
</html>
