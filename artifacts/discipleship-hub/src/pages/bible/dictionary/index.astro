---
import Layout from "@/layouts/Layout.astro";
import DictionarySources from "@/components/bible-dictionary/DictionarySources.astro";
import { dictEntries } from "@/data/bible-dictionary";
import "@/components/bible-maps/bible-maps.css";

const baseUrl = import.meta.env.BASE_URL;
const join = (path: string) => (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + path;
const letters = new Map<string, typeof dictEntries>();
for (const e of [...dictEntries].sort((a, b) => a.title.localeCompare(b.title, "en", { sensitivity: "base" }))) {
  const l = e.slug[0].toUpperCase();
  letters.set(l, [...(letters.get(l) ?? []), e]);
}
const fold = (s: string) => s.normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/æ/g, "ae").replace(/[’']/g, "");
const count = dictEntries.length.toLocaleString("en-US");
---
<Layout
  title="Easton’s Bible Dictionary A–Z: People, Places and Terms · JO EQUIP"
  description={`Search ${count} articles from Easton’s Bible Dictionary (1897) on the people, places, customs and teachings of the Bible, with every reference linked to the King James Version.`}
>
  <div class="bmp-main bmp-narrow">
    <nav class="bmp-crumbs" aria-label="Breadcrumb">
      <a href={join("/bible")}>Bible</a> <span aria-hidden="true">/</span>
      <a href={join("/bible/resources")}>Bible Resources</a> <span aria-hidden="true">/</span> Bible Dictionary
    </nav>
    <p class="bmp-eyebrow">Study Tools</p>
    <h1 class="bmp-title">Easton’s Bible Dictionary</h1>
    <p class="bmp-lede">
      {count} short articles on the people, places, customs and teachings of the Bible, from M. G. Easton’s <em>Illustrated Bible Dictionary</em> (1897).
      Every Bible reference opens in the <a class="bmp-link" href={join("/bible")}>online Bible</a>, where the Dictionary tab lists the entries for the chapter you are reading.
    </p>

    <section class="bmp-section" aria-labelledby="az-h">
      <h2 id="az-h">Find an entry</h2>
      <label for="dict-q" class="dict-label">Search the dictionary</label>
      <input id="dict-q" class="dict-search" type="search" autocomplete="off" spellcheck="false" placeholder="For example: Bethel" />
      <fieldset class="dict-mode">
        <legend>Search in</legend>
        <label><input type="radio" name="dict-mode" value="names" checked /> Entry names</label>
        <label><input type="radio" name="dict-mode" value="text" /> Full text of the articles</label>
      </fieldset>
      <p id="dict-status" class="dict-status" role="status" aria-live="polite"></p>
      <button id="dict-to-text" class="dict-switch" type="button" hidden></button>
      <div id="dict-text" hidden>
        <ol id="dict-results" class="dict-results"></ol>
        <button id="dict-more" class="dict-switch" type="button" hidden>Show more results</button>
      </div>
      <ul id="dict-az" class="bmp-az" aria-label="Jump to a letter">
        {[...letters.keys()].map(l => <li><a href={`#letter-${l.toLowerCase()}`}>{l}</a></li>)}
      </ul>
      <div id="dict-list">
        {[...letters].map(([l, list]) => (
          <div class="dict-letter" data-letter>
            <h3 id={`letter-${l.toLowerCase()}`}>{l} <small style="font-weight:400">({list.length})</small></h3>
            <ul class="bmp-az-list">
              {list.map(e => <li data-k={fold(e.title)}><a href={join(`/bible/dictionary/${e.slug}`)}>{e.title}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <DictionarySources />
  </div>
</Layout>

<script>
  import { dictSearchHref } from "@/components/bible-dictionary/dictionary-data";
  import { dictSearchTerms, dictSnippet, foldText, prepareDictSearch, searchDict, type DictSearchDoc, type DictSearchHit, type DictSearchRow } from "@/components/bible-dictionary/dictionary-search";

  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  const searchUrl = dictSearchHref(import.meta.env.BASE_URL);
  const input = document.getElementById("dict-q") as HTMLInputElement | null;
  const status = document.getElementById("dict-status");
  const toText = document.getElementById("dict-to-text") as HTMLButtonElement | null;
  const textBox = document.getElementById("dict-text");
  const results = document.getElementById("dict-results");
  const more = document.getElementById("dict-more") as HTMLButtonElement | null;
  const list = document.getElementById("dict-list");
  const az = document.getElementById("dict-az");
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="dict-mode"]')];
  const groups = [...document.querySelectorAll<HTMLElement>("#dict-list [data-letter]")];
  const fold = (s: string) => s.normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/æ/g, "ae").replace(/[’']/g, "").trim();
  const quoted = () => `“${input?.value.trim() ?? ""}”`;
  const say = (msg: string) => { if (status) status.textContent = msg; };
  const mode = () => (radios.find(r => r.checked)?.value === "text" ? "text" : "names");

  // ---------- Entry names (filters the A–Z list) ----------
  const runNames = () => {
    const q = fold(input?.value ?? "");
    let shown = 0;
    for (const g of groups) {
      let n = 0;
      for (const li of g.querySelectorAll<HTMLElement>("li[data-k]")) {
        const k = li.dataset.k ?? "";
        const hit = !q || k.split(/[\s,-]+/).some(w => w.startsWith(q)) || (q.length > 2 && k.includes(q));
        li.hidden = !hit;
        if (hit) n++;
      }
      g.hidden = n === 0;
      shown += n;
    }
    say(q ? (shown ? `${shown} ${shown === 1 ? "entry name matches" : "entry names match"} ${quoted()}.` : `No entry name matches ${quoted()}.`) : "");
    if (toText) {
      toText.hidden = q.length < 3;
      toText.textContent = `Search the full text of the articles for ${quoted()}`;
    }
  };

  // ---------- Full text (fetched only when first needed) ----------
  let rows: DictSearchDoc[] | null = null;
  let loading: Promise<void> | null = null;
  const loadText = () => {
    loading ??= fetch(searchUrl)
      .then(res => {
        if (!res.ok) throw new Error(`status ${res.status}`);
        return res.json() as Promise<DictSearchRow[]>;
      })
      .then(data => { rows = prepareDictSearch(data); })
      .catch(err => { loading = null; throw err; });
    return loading;
  };
  const PAGE = 50;
  let hits: DictSearchHit[] = [];
  let terms: string[] = [];
  let shownCount = 0;

  function snippet(h: DictSearchHit): Node[] {
    return dictSnippet(h.text, terms).map(([t, mark]) => {
      if (!mark) return document.createTextNode(t);
      const mk = document.createElement("mark");
      mk.textContent = t;
      return mk;
    });
  }

  function renderMore() {
    if (!results || !more) return;
    const frag = document.createDocumentFragment();
    for (const h of hits.slice(shownCount, shownCount + PAGE)) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `${base}/bible/dictionary/${h.slug}`;
      a.textContent = h.title;
      const p = document.createElement("p");
      p.append(...snippet(h));
      li.append(a, p);
      frag.append(li);
    }
    results.append(frag);
    shownCount = Math.min(hits.length, shownCount + PAGE);
    more.hidden = shownCount >= hits.length;
    more.textContent = `Show ${Math.min(PAGE, hits.length - shownCount)} more results`;
  }

  let runId = 0;
  async function runText() {
    const id = ++runId;
    const raw = input?.value.trim() ?? "";
    terms = foldText(raw).split(/\s+/).filter(Boolean);
    if (results) results.textContent = "";
    if (more) more.hidden = true;
    hits = [];
    shownCount = 0;
    if (!terms.length) { say("Type a word or phrase to search inside all the articles."); return; }
    const searchTerms = dictSearchTerms(raw);
    if (!searchTerms) { say("Type at least 3 letters to search inside the articles."); return; }
    if (!rows) {
      say("Loading the full text of the dictionary…");
      try { await loadText(); } catch (err) {
        if (id === runId) say(`The full text could not be loaded (${(err as Error).message}). Check your connection and try again.`);
        return;
      }
      if (id !== runId) return;
    }
    hits = searchDict(rows!, searchTerms);
    say(hits.length
      ? `${hits.length.toLocaleString("en-US")} ${hits.length === 1 ? "article mentions" : "articles mention"} ${quoted()}${hits.length > PAGE ? ", best matches first" : ""}.`
      : `No article mentions ${quoted()}.`);
    renderMore();
  }

  // ---------- Wiring ----------
  let timer = 0;
  const syncUrl = () => {
    const u = new URL(window.location.href);
    const q = input?.value.trim() ?? "";
    if (q) u.searchParams.set("q", q); else u.searchParams.delete("q");
    if (mode() === "text") u.searchParams.set("in", "text"); else u.searchParams.delete("in");
    history.replaceState(history.state, "", u);
  };
  const run = () => {
    const text = mode() === "text";
    if (list) list.hidden = text;
    if (az) az.hidden = text;
    if (textBox) textBox.hidden = !text;
    if (input) input.placeholder = text ? "For example: Tell Amarna" : "For example: Bethel";
    if (text) { if (toText) toText.hidden = true; void runText(); } else runNames();
  };
  input?.addEventListener("input", () => {
    clearTimeout(timer);
    if (mode() === "names") run(); // instant on the in-page list
    timer = window.setTimeout(() => { if (mode() === "text") run(); syncUrl(); }, 200);
  });
  for (const r of radios) r.addEventListener("change", () => { run(); syncUrl(); });
  toText?.addEventListener("click", () => {
    const r = radios.find(x => x.value === "text");
    if (r) r.checked = true;
    run(); syncUrl();
    input?.focus();
  });
  more?.addEventListener("click", renderMore);
  const params = new URLSearchParams(window.location.search);
  const initial = params.get("q");
  if (params.get("in") === "text") { const r = radios.find(x => x.value === "text"); if (r) r.checked = true; }
  if (input && initial) input.value = initial;
  if (initial || mode() === "text") run();
</script>

<style>
  .dict-label { display: block; margin-bottom: .35rem; font-weight: 700; }
  .dict-search { width: 100%; max-width: 32rem; min-height: 2.75rem; padding: .5rem .75rem; border: 1px solid var(--color-border-control, #7aa7c7); border-radius: 4px; font: inherit; font-size: 1.05rem; background: #fff; }
  .dict-search:focus-visible { outline: 2px solid var(--color-hero, #006bb3); outline-offset: 1px; }
  .dict-status { min-height: 1.5rem; margin: .5rem 0 .75rem; color: var(--color-text-muted, #2e5a7a); font-weight: 600; }
  .dict-mode { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.25rem; margin: .5rem 0 0; padding: 0; border: 0; }
  .dict-mode legend { float: left; margin-right: .25rem; padding: 0; font-weight: 700; }
  .dict-mode label { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.75rem; cursor: pointer; }
  .dict-mode input { width: 1.1rem; height: 1.1rem; accent-color: var(--color-hero, #006bb3); }
  .dict-switch { margin: 0 0 1rem; min-height: 2.75rem; padding: .4rem .9rem; border: 1px solid var(--color-hero, #006bb3); border-radius: 4px; background: #fff; color: var(--color-hero, #006bb3); font: inherit; font-weight: 700; text-align: left; cursor: pointer; }
  .dict-switch:hover { background: #eef5fb; }
  .dict-results { margin: 0 0 1rem; padding: 0; list-style: none; }
  .dict-results :global(li) { padding: .7rem 0; border-bottom: 1px solid var(--color-border, #d6e4ef); }
  .dict-results :global(a) { color: var(--color-hero, #006bb3); font-weight: 700; font-size: 1.05rem; text-decoration: none; }
  .dict-results :global(a):hover { text-decoration: underline; }
  .dict-results :global(p) { margin: .25rem 0 0; line-height: 1.5; }
  .dict-results :global(mark) { background: #fff1a8; color: inherit; padding: 0 .05em; }
</style>
