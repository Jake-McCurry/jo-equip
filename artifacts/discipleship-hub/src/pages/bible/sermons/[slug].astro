---
import Layout from "@/layouts/Layout.astro";
import SermonSources from "@/components/sermons/SermonSources.astro";
import { readerHref, refText } from "@/components/bible-maps/maps-data";
import { dateLabel, loadSermonBody, PREACHERS, sermons, sermonsBy, type Sermon } from "@/data/sermons";
import "@/components/bible-maps/bible-maps.css";

export function getStaticPaths() {
  // Previous/next stay within the same preacher's series.
  return sermons.map(sermon => {
    const list = sermonsBy(sermon.preacher);
    const i = list.indexOf(sermon);
    return { params: { slug: sermon.slug }, props: { sermon, prev: list[i - 1] ?? null, next: list[i + 1] ?? null } };
  });
}

const { sermon, prev, next } = Astro.props as { sermon: Sermon; prev: Sermon | null; next: Sermon | null };
const blocks = await loadSermonBody(sermon.slug);
const baseUrl = import.meta.env.BASE_URL;
const join = (path: string) => (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + path;
const preacher = PREACHERS[sermon.preacher];
const refs = sermon.refs.map(([from, to]) => ({ label: refText(from, to), href: readerHref(baseUrl, from, "kjv") }));
const refLabel = refs.map(r => r.label).join("; ");
const when = sermon.date && !sermon.occasion ? `${sermon.service ? `${sermon.service}, ` : ""}${dateLabel(sermon.date)}` : null;
const versionName = sermon.textVersion ?? "King James Version";
const minutes = Math.max(1, Math.round(sermon.words / 200));
const eyebrow = sermon.preacher === "maclaren"
  ? `${sermon.series} · The Book of ${sermon.part ?? ""} (${sermon.published})`
  : `Sermon No. ${sermon.number} · ${sermon.series}${(sermon.preacher === "wesley" && sermon.published !== 1771) || sermon.preacher === "whitefield" ? ` (${sermon.published})` : ""}`;
const volumeLabel = sermon.preacher === "maclaren" ? `The Book of ${sermon.part}`
  : (sermon.preacher === "wesley" && sermon.published === 1771) || sermon.preacher === "whitefield" ? `Works, Volume ${sermon.volume}` : `Volume ${sermon.volume}`;
const description = `“${sermon.title}”, sermon No. ${sermon.number} by ${preacher.name}${refLabel ? ` on ${refLabel}` : ""}${sermon.date ? `, preached ${dateLabel(sermon.date)}` : ""}. Full text from the ${sermon.series}, checked against the original printing.`;
---
<Layout title={`${sermon.title}${refLabel ? ` (${refs[0].label})` : ""}: ${preacher.name} Sermon · JO EQUIP`} description={description}>
  <article class="bmp-main bmp-narrow">
    <nav class="bmp-crumbs" aria-label="Breadcrumb">
      <a href={join("/bible/resources")}>Bible Resources</a> <span aria-hidden="true">/</span>
      <a href={join("/bible/sermons")}>Classic Sermons</a> <span aria-hidden="true">/</span> No. {sermon.number}
    </nav>
    <p class="bmp-eyebrow">{eyebrow}</p>
    <h1 class="bmp-title">{sermon.title}</h1>
    <p class="bmp-sub">By {preacher.name}</p>
    {sermon.occasion && <p class="srm-meta"><span>{sermon.occasion}</span></p>}
    <p class="srm-meta">
      {when ? <span>Preached {when}</span> : <span>Published {sermon.published}</span>}
      <span>{volumeLabel}</span>
      <span>About {minutes} minutes to read</span>
    </p>

    {sermon.quote && (
      <blockquote class="srm-text">
        <p>{sermon.quote}</p>
        {refs.length > 0 && (
          <p class="srm-ref">
            {refs.map((r, i) => <>{i > 0 && "; "}<a href={r.href}>{r.label}</a></>)}
            {" "}<small>({versionName}{sermon.textVersion ? "; the link opens the King James Version" : ""})</small>
          </p>
        )}
      </blockquote>
    )}
    {sermon.note && <p class="srm-note"><strong>Note:</strong> {sermon.note}</p>}

    <div class="srm-body">
      {blocks.map(b =>
        "p" in b ? <p>{b.p}</p>
        : "h" in b ? <h2>{b.h}</h2>
        : <blockquote><p>{b.q.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p></blockquote>
      )}
    </div>

    <nav class="srm-pager" aria-label="More sermons">
      {prev ? <a class="bmp-link" href={join(`/bible/sermons/${prev.slug}`)}>← No. {prev.number}: {prev.title}</a> : <span />}
      {next && <a class="bmp-link" href={join(`/bible/sermons/${next.slug}`)}>No. {next.number}: {next.title} →</a>}
    </nav>
    <p><a class="bmp-link" href={join("/bible/sermons")}>All classic sermons by Bible book</a> · <a class="bmp-link" href={join(`/bible/sermons#${sermon.preacher}`)}>All sermons by {preacher.name}</a></p>

    <SermonSources sermon={sermon} />
  </article>
</Layout>
