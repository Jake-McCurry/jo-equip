---
import Layout from "@/layouts/Layout.astro";
import { Book as BookIcon } from "lucide-react";
import { books } from "@/data/books";
import { bookCategories } from "@/data/bookCategories";
import BooksCarousel from "@/components/BooksCarousel.astro";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;
const bookDeepLinks = Object.fromEntries(
  books.map(book => [book.id, { pdf: join(book.pdf), title: book.title }]),
);

const categoryOrderedBooks = bookCategories.flatMap(c => c.books);

/* JSON-LD: a CollectionPage that contains an ItemList of Book entries.
   Each Book is marked free + downloadable so Google can show it in
   structured book results (and understand we offer free resources). */
const SITE = "https://equip.jesusonline.com";
const booksJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE}/books#collection`,
  "name": "Free Christian Discipleship Books (PDF) | JO EQUIP",
  "url": `${SITE}/books`,
  "isPartOf": { "@id": `${SITE}/#website` },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": categoryOrderedBooks.length,
    "itemListElement": categoryOrderedBooks.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "Book",
        "@id": `${SITE}/books/${b.id}#book`,
        "name": b.title,
        ...(b.description ? { "description": b.description } : {}),
        ...(b.subtitle ? { "alternativeHeadline": b.subtitle } : {}),
        ...(b.author ? { "author": { "@type": "Person", "name": b.author } } : {}),
        "publisher": { "@id": "https://jesusonlineministries.org/#org" },
        "image": `${SITE}${b.cover}`,
        "url": `${SITE}/books/${b.id}`,
        "bookFormat": "https://schema.org/EBook",
        "inLanguage": "en",
        "isAccessibleForFree": true,
        "workExample": {
          "@type": "Book",
          "bookFormat": "https://schema.org/EBook",
          "encodingFormat": "application/pdf",
          "url": `${SITE}${b.pdf}`,
          "isAccessibleForFree": true,
          "inLanguage": "en",
          "potentialAction": {
            "@type": "ReadAction",
            "target": `${SITE}${b.pdf}`,
            "actionStatus": "https://schema.org/PotentialActionStatus",
          },
        },
      },
    })),
  },
};
---
<Layout
  title="Free Christian Discipleship Books (PDF) | JO EQUIP"
  description="Download free PDF books on discipleship, evangelism, evidence for Jesus, prayer and Christian growth for pastors, ministry leaders and believers."
>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "Books", url: "/books" },
    ]} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(booksJsonLd)} />
  </Fragment>
  <div class="container mx-auto px-4 py-12 md:py-16">
    <div class="max-w-3xl mb-12">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-9 h-9 rounded flex items-center justify-center" style="background-color:rgba(222,91,0,0.1);">
          <BookIcon className="w-5 h-5" style={{ color: "var(--color-accent)" }} />
        </div>
        <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--color-accent);">Reading Library</span>
      </div>
      <h1 class="text-4xl md:text-5xl mb-4" style="color:var(--color-structure);">Books</h1>
      <div class="h-0.5 w-12 mb-5" style="background-color:var(--color-accent);"></div>
      <p class="leading-relaxed text-lg" style="color:var(--color-muted-foreground);">
        Read these free books online — open any of them in a new tab, then download to keep or share.
      </p>
    </div>

    {/* Spacing belongs to this stack, not to individual carousel margins. */}
    <div class="book-carousel-stack flex flex-col gap-4 md:gap-5">
      {bookCategories.map(category => (
        <BooksCarousel title={category.title} books={category.books} />
      ))}
    </div>
  </div>

  <script define:vars={{ bookDeepLinks }}>
    (function () {
      /* Email capture removed (Aug 2026): books are free to download with no
         sign-up. The capture system is preserved in src/retired-pages/ in
         case it comes back. */

      // Open the book PDF in a new tab so visitors can read it in the browser
      // and download it themselves if they want. `allowSameTabFallback` is
      // used for the deep-link auto-trigger, where the open happens on page
      // load (no user gesture) and may be blocked by a popup blocker — in
      // that case we navigate the current tab so the visitor still reaches
      // the book.
      function openBook(url, allowSameTabFallback, title) {
        // Report this as an open—not a download—when the PDF viewer launches.
        try {
          if (window.__trackPdfOpen) window.__trackPdfOpen(url, title, "book");
        } catch (_e) { /* ignore */ }
        let win = null;
        try { win = window.open(url, "_blank"); } catch (_e) { win = null; }
        if (win) {
          try { win.opener = null; } catch (_e) { /* ignore */ }
        } else if (allowSameTabFallback) {
          window.location.href = url;
        }
      }

      // Shared entry point: every visitor opens the PDF directly.
      function requestBook(url, title, isDeepLink) {
        if (!url) return;
        openBook(url, !!isDeepLink, title);
      }

      // Deep-link: /books?download=<book-id> auto-scrolls to the matching card
      // and opens its PDF. Title and cover links work natively without JavaScript.
      try {
        const params = new URLSearchParams(window.location.search);
        const wanted = params.get("download");
        if (wanted) {
          const card = document.getElementById(wanted);
          const catalogBook = Object.prototype.hasOwnProperty.call(bookDeepLinks, wanted)
            ? bookDeepLinks[wanted]
            : null;
          if (card) {
            try { card.scrollIntoView({ behavior: "smooth", block: "center", inline: "center" }); } catch (_e) { /* ignore */ }
          }
          if (catalogBook) {
            // Defer until the scroll begins. Catalog lookup also preserves
            // deep links to intentionally unlisted books.
            setTimeout(function () {
              requestBook(catalogBook.pdf, catalogBook.title, true);
            }, 250);
          }
        }
      } catch (_e) { /* ignore */ }
    })();
  </script>
</Layout>
