---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import { ArrowLeft, BookOpen, Download, RotateCcw } from "lucide-react";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";
import BookBlocks from "@/components/adventure-book/BookBlocks.astro";
import { books } from "@/data/books";
import { getBookCover } from "@/data/bookCovers";
import { webBooks, readingLabel, type WebBook } from "@/data/web-books";
import "@/components/adventure-book/reader.css";

export function getStaticPaths() {
  return webBooks.map(wb => ({ params: { id: wb.id }, props: { wb } }));
}

const { wb } = Astro.props as { wb: WebBook };
const book = books.find(b => b.id === wb.id)!;
const cover = getBookCover(wb.id);
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
const join = (p: string) => base + p;
const first = wb.readings[0];
const resumeMap = Object.fromEntries(wb.readings.map(r => [r.slug, readingLabel(r)]));
const total = wb.readings.length;
---
<Layout
  title={`Read ${wb.title} Online · JO EQUIP`}
  description={`Read ${wb.title} online, reading by reading, with Scripture links and a private reflection space. The free PDF remains available.`}
  image={book.cover}
  imageAlt={`${wb.title} — book cover`}
>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "Books", url: "/books" },
      { name: wb.title, url: `/books/${wb.id}` },
      { name: "Read online", url: wb.readBase },
    ]} />
  </Fragment>

  <div class="container mx-auto px-4 py-10 md:py-14 max-w-5xl" id="adv-intro" data-store={wb.storeKey}>
    <a href={join("/books")} class="inline-flex items-center gap-2 text-sm font-medium mb-8 hover:opacity-75 transition-opacity" style="color:var(--color-hero);">
      <ArrowLeft className="w-4 h-4" /> Back to all books
    </a>

    <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-8 md:gap-12 items-start">
      <div class="flex justify-center md:justify-start">
        {cover && (
          <Image src={cover} alt={`${wb.title} book cover`} widths={[240, 480]} sizes="(min-width: 768px) 240px, 70vw" class="w-full max-w-[240px] h-auto rounded shadow-lg" loading="eager" />
        )}
      </div>
      <div>
        <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--color-accent);">Read online · Web edition</span>
        <h1 class="text-3xl md:text-5xl mt-3 mb-3 leading-tight" style="color:var(--color-structure);">{wb.title}</h1>
        {book.subtitle && <p class="text-lg md:text-xl mb-5" style="color:var(--color-text);">{book.subtitle}</p>}
        <div class="h-0.5 w-12 mb-6" style="background-color:var(--color-accent);"></div>
        <p class="text-sm mb-3" style="color:var(--color-muted-foreground);">
          {total} readings · about {wb.totalMinutes} minutes in total · the full text of the current PDF edition ({wb.sourcePages} pages)
        </p>
        {wb.note && <p class="text-sm mb-6" style="color:var(--color-muted-foreground);">{wb.note}</p>}

        <div class="flex flex-wrap gap-3 items-center mt-4">
          <a href={join(`${wb.readBase}/${first.slug}`)} class="inline-flex items-center gap-2 px-6 py-3 rounded font-semibold text-white text-base transition-opacity hover:opacity-90" style="background-color:var(--color-action-warm);">
            <BookOpen className="w-4 h-4" /> Start reading
          </a>
          <a href={join(`/books?download=${wb.id}`)} class="inline-flex items-center gap-2 px-5 py-3 rounded border font-semibold text-base transition-colors hover:bg-white" style="border-color:var(--color-border-control); color:var(--color-hero);">
            <Download className="w-4 h-4" /> Read PDF
          </a>
        </div>

        <p data-resume hidden data-base={join(wb.readBase)} data-readings={JSON.stringify(resumeMap)} class="mt-5 text-base">
          <a href={join(wb.readBase)} class="inline-flex items-center gap-2 font-semibold underline underline-offset-4" style="color:var(--color-hero);">
            <RotateCcw className="w-4 h-4" /> Resume: <span data-resume-title></span>
          </a>
          <span class="block text-xs mt-1" style="color:var(--color-muted-foreground);">Remembered in this browser only.</span>
        </p>
      </div>
    </div>

    <section class="mt-14 md:mt-16" aria-labelledby="contents-heading">
      <h2 id="contents-heading" class="text-2xl md:text-3xl mb-2" style="color:var(--color-structure);">Contents</h2>
      <ol class="rd-contents border-t" style="border-color:var(--color-border);">
        {wb.readings.map(r => (
          <li>
            <a href={join(`${wb.readBase}/${r.slug}`)}>
              <span class="num" aria-hidden="true">{r.label ?? "·"}</span>
              <span>
                {r.part && <span class="block text-xs uppercase tracking-wider" style="color:var(--color-muted-foreground);">{r.part}</span>}
                <span class="ttl">{readingLabel(r)}</span>
              </span>
              <span class="min">{r.minutes} min read</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {wb.frontMatter.length > 0 && (
      <section class="mt-14 pt-8 border-t max-w-3xl" style="border-color:var(--color-border);" aria-labelledby="fm-heading">
        <details>
          <summary id="fm-heading" class="cursor-pointer font-semibold" style="color:var(--color-structure);">Front matter, copyright and permissions</summary>
          <div class="rd-body mt-4 text-sm leading-relaxed" style="color:var(--color-muted-foreground);">
            <BookBlocks blocks={wb.frontMatter} />
          </div>
        </details>
      </section>
    )}
  </div>

  <script>
    import { initResume } from "@/components/adventure-book/reader-client";
    const run = () => { const el = document.getElementById("adv-intro"); if (el) initResume(el); };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run); else run();
  </script>
</Layout>
