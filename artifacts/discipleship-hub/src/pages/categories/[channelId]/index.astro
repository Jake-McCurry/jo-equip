---
import Layout from "@/layouts/Layout.astro";
import ChannelArt from "@/components/ChannelArt.astro";
import { channels, getChannel, getSubTopicsByChannel, subTopics } from "@/data/channels";
import { ArrowRight, ChevronRight } from "lucide-react";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

export function getStaticPaths() {
  return channels.map(c => ({ params: { channelId: c.id } }));
}

const { channelId } = Astro.params;
const channel = getChannel(channelId!);
if (!channel) return Astro.redirect(join("/categories"));

const subs = getSubTopicsByChannel(channel.id).map(sub => ({
  ...sub,
  href: `/categories/${channel.id}/${sub.id}`,
}));
// Link to the existing library without generating a duplicate sub-topic page.
if (channel.id === "church") {
  const newsletterIndex = subs.findIndex(sub => sub.id === "make-multiply-disciples-newsletter");
  subs.splice(newsletterIndex + 1, 0, {
    id: "this-sunday-leader-kit",
    channelId: "church",
    name: "This Sunday Leader Kit",
    description: "5-minute ready-to-use Discipleship Moments for heart transformation",
    href: "/leader-kits",
  });
}

const accent = channel.accentColor;
const heroGradient = channel.gradient;

/* Channel statement shown under the hero (per user's topics-page mockup). */
const statements: Record<string, string> = {
  evidence: "Reach skeptics with strong evidence for Christ, God, and the Bible.",
  growth:
    "Disciple believers to become all that God created them to be, so they may do all that He has created them to do.",
  church:
    "Build fruitful, Spirit-led ministries that multiply disciples and plant churches in obedience to Christ and His Word.",
};
const statement = statements[channel.id] ?? channel.description;

/* "Explore N Topics" line per sub-topic (uniform "Topics" wording per user). */
function exploreLabel(subId: string): string {
  const children = subTopics.filter(s => s.parentId === subId);
  const sub = subTopics.find(s => s.id === subId);
  const listed = (sub?.items ?? []).filter((i: { unlisted?: boolean }) => !i.unlisted);
  // Total Life Discipleship also presents the featured Identity-Centered
  // Heart Transformation card alongside its two child-topic cards.
  const featuredCount = subId === "total-life-discipleship-principles" ? 1 : 0;
  const count = children.length > 0 ? children.length + featuredCount : listed.length;
  if (count > 0) return `Explore ${count} ${count === 1 ? "Topic" : "Topics"}`;
  return "Explore";
}
---
<Layout title={`${channel.name} · JO EQUIP`} description={channel.description}>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "Categories", url: "/categories" },
      { name: channel.shortName, url: `/categories/${channel.id}` },
    ]} />
  </Fragment>
  {/* Channel hero */}
  <div class="relative overflow-hidden" style={`background:${heroGradient};`}>
    <div class="absolute inset-0 opacity-30">
      <ChannelArt channel={channel.id} class="absolute inset-0 w-full h-full" />
    </div>
    <div class="container mx-auto px-4 py-7 md:py-9 relative">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl mb-2" style="color:#ffffff;font-weight:600;">{channel.name}</h1>
        <p class="text-base md:text-lg" style="color:#ffffff;">{statement}</p>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 pt-8 md:pt-10 pb-12 md:pb-16">
    {/* Breadcrumbs — below the hero, matching the article-page style. */}
    <nav class="flex items-center text-sm font-medium flex-wrap gap-1 mb-8" style="color:var(--color-muted-foreground);">
      <a href={join("/categories")} class="transition-colors hover:text-primary">Categories</a>
      <ChevronRight className="w-3 h-3" />
      <span>{channel.shortName}</span>
    </nav>
    <div class="mb-8 pb-4 border-b" style="border-color:var(--color-border);">
      <h2 class="text-2xl" style="color:var(--color-structure);">{subs.length} Topics in this Category</h2>
      <div class="mt-2 h-0.5 w-12" style="background-color:var(--color-accent);"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {subs.map(sub => {
        const href = join(sub.href);
        return (
          <div
            class="flex flex-col bg-white border rounded p-5 hover:shadow-md transition-all"
            style={`border-color:var(--color-border);border-left:4px solid ${accent};`}
          >
            <h3 class="text-base font-semibold leading-snug mb-2">
              <a href={href} class="hover:underline" style="color:var(--color-text);">{sub.name}</a>
            </h3>
            {sub.description && (
              <p class="text-base leading-relaxed mb-4" style="color:var(--color-muted-foreground);">{sub.description}</p>
            )}
            {sub.id === "this-sunday-leader-kit" && (
              <ul class="space-y-3 mb-4 text-sm" style={`color:${accent};`}>
                <li>
                  <a href={join("/leader-kits/adventure-of-living-with-jesus-leader-kit.pdf")} class="font-semibold underline underline-offset-2">
                    The Adventure of Living with Jesus <span class="whitespace-nowrap">(PDF)</span>
                  </a>
                </li>
                <li>
                  <a href={join("/leader-kits/a-heart-after-god-leader-kit.pdf")} class="font-semibold underline underline-offset-2">
                    A Heart After God <span class="whitespace-nowrap">(PDF)</span>
                  </a>
                </li>
              </ul>
            )}
            <a
              href={href}
              class="group inline-flex items-center gap-1.5 mt-auto text-sm font-semibold hover:underline"
              style={`color:${accent};`}
            >
              {exploreLabel(sub.id)}
              <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
            </a>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
