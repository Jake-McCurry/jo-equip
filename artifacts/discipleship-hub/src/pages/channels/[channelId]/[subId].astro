---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import { subTopics, getChannel, getSubTopic, getSubTopicChildren, getNextSubTopic } from "@/data/channels";
import { getBookCover } from "@/data/bookCovers";
import { extractAppSlug, hasArticlePdf } from "@/data/articles";
import { hasBcgArticlePdf } from "@/data/bcgArticlePdfs";
import { hasBsmArticlePdf } from "@/data/bsmArticlePdfs";
import { FileText, Video, Smartphone, ArrowRight, ChevronRight } from "lucide-react";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";
import MakeMultiplyNewsletter from "@/components/MakeMultiplyNewsletter.astro";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

export function getStaticPaths() {
  return subTopics.map(s => ({
    params: { channelId: s.channelId, subId: s.id },
  }));
}

const { channelId, subId } = Astro.params;
const channel = getChannel(channelId!);
const sub = getSubTopic(channelId!, subId!);
if (!channel || !sub) return Astro.redirect(join("/channels"));

const next = getNextSubTopic(channelId!, subId!);
const children = getSubTopicChildren(sub.id);
const hasChildren = children.length > 0;
const hasItems = (sub.items?.length ?? 0) > 0;

/* The Make & Multiply Disciples Newsletter sub-topic renders a dedicated
 * landing page (intro + "each issue features" + Mailchimp signup form)
 * instead of the standard items/empty layout. */
const isNewsletter = sub.id === "make-multiply-disciples-newsletter";

/* For child sub-topics, surface the parent in the breadcrumb (Channels > Church > Share Jesus > Year 1). */
const parent = sub.parentId ? getSubTopic(channelId!, sub.parentId) : undefined;

/* Listed article count for a child card: its own non-unlisted items, or the
 * sum across its children when it is itself a parent. */
function childArticleCount(child: (typeof children)[number]): number {
  const grandchildren = getSubTopicChildren(child.id);
  if (grandchildren.length > 0) {
    return grandchildren.reduce((n, g) => n + (g.items?.filter(i => !i.unlisted).length ?? 0), 0);
  }
  return child.items?.filter(i => !i.unlisted).length ?? 0;
}

/* JSON-LD: CollectionPage with an ItemList of the sub-topic's lesson titles.
   Note: we deliberately do NOT use FAQPage schema here — Google requires
   the full answer text be visible on the page for FAQ rich snippets, and
   our "answers" live in linked PDFs/videos/app pages instead of inline.
   ItemList is the honest, valid choice and still helps Google understand
   what each sub-topic page contains. */
const SITE = "https://equip.jesusonline.com";
const subTopicJsonLd = hasItems ? {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE}/channels/${channel.id}/${sub.id}#page`,
  "name": `${sub.name} · ${channel.shortName} · JO EQUIP`,
  "url": `${SITE}/channels/${channel.id}/${sub.id}`,
  "isPartOf": { "@id": `${SITE}/#website` },
  "about": sub.name,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": sub.items!.filter(item => !item.unlisted).length,
    "itemListElement": sub.items!.filter(item => !item.unlisted).map(item => ({
      "@type": "ListItem",
      "position": item.number,
      "name": item.title,
      ...(item.articleId
        ? { url: `${SITE}/channels/${channel.id}/${sub.id}/${item.articleId}` }
        : {}),
    })),
  },
} : null;

const topicCoverId = sub.coverId || sub.bookId;
const topicBookCover = topicCoverId ? getBookCover(topicCoverId) : undefined;
const topicBookHref = sub.bookId
  ? join(`/books?download=${encodeURIComponent(sub.bookId)}#${encodeURIComponent(sub.bookId)}`)
  : undefined;
const topicPlaylistHref = sub.playlistId
  ? join(`/playlist/${encodeURIComponent(sub.playlistId)}`)
  : undefined;
const topicAppHref = sub.appUrl;
const showTopicButtons = !!(sub.formats && sub.formats.length > 0);

function btnClass(enabled: boolean) {
  return "inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-semibold uppercase tracking-wider transition-all" + (enabled ? " hover:shadow-sm" : " cursor-not-allowed");
}

/* Titles like "New Life in Christ (Intermediate Discipleship)" — render the
   parenthetical smaller so it supplements rather than competes with the title. */
function splitTitle(t: string): { main: string; paren: string | null } {
  const m = t.match(/^(.*?)\s*(\([^)]*\))\s*$/);
  return m ? { main: m[1], paren: m[2] } : { main: t, paren: null };
}

const heroTitle = splitTitle(sub.name);
---
<Layout title={`${sub.name} · ${channel.shortName} · JO EQUIP`} description={`${sub.name} — ${channel.tagline}`}>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "Channels", url: "/channels" },
      { name: channel.shortName, url: `/channels/${channel.id}` },
      ...(parent ? [{ name: parent.name, url: `/channels/${channel.id}/${parent.id}` }] : []),
      { name: sub.name, url: `/channels/${channel.id}/${sub.id}` },
    ]} />
    {subTopicJsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(subTopicJsonLd)} />
    )}
  </Fragment>
  {/* Hero */}
  <div class="relative overflow-hidden" style={`background:${channel.gradient};`}>
    <div class="absolute inset-0 pointer-events-none" style="background-image:repeating-linear-gradient(45deg, rgba(255,255,255,0.05) 0, rgba(255,255,255,0.05) 1px, transparent 1px, transparent 18px);"></div>
    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full pointer-events-none" style="background-color:rgba(255,255,255,0.08);filter:blur(20px);"></div>
    <div class="container mx-auto px-4 py-7 md:py-9 relative max-w-5xl">
      <nav class="flex items-center text-base mb-3 flex-wrap gap-1" style="color:#ffffff;">
        <a href={join("/channels")} class="hover:text-white transition-colors">Channels</a>
        <ChevronRight className="w-3 h-3" />
        <a href={join(`/channels/${channel.id}`)} class="hover:text-white transition-colors">{channel.shortName}</a>
        {parent && (
          <>
            <ChevronRight className="w-3 h-3" />
            <a href={join(`/channels/${channel.id}/${parent.id}`)} class="hover:text-white transition-colors">{parent.name}</a>
          </>
        )}
        <ChevronRight className="w-3 h-3" />
        <span style="color:rgba(255,255,255,0.95);">{heroTitle.main}</span>
      </nav>

      <h1 class="text-3xl md:text-5xl mb-2" style="color:#ffffff;font-weight:500;">{heroTitle.main}</h1>
      {sub.description && (
        <p class="text-base md:text-lg max-w-3xl" style="color:#ffffff;">{sub.description}</p>
      )}
    </div>
  </div>

  <div class="container mx-auto px-4 py-12 md:py-16 max-w-5xl">
    {isNewsletter ? (
      <MakeMultiplyNewsletter accent={channel.accentColor} />
    ) : hasChildren ? (
      <>
        <div class="mb-6 pb-4 border-b" style="border-color:var(--color-border);">
          <h2 class="text-2xl" style="color:#0b3c5d;">Topics</h2>
          <div class="mt-2 h-0.5 w-12" style="background-color:#de5b00;"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {children.map((child) => {
            const count = childArticleCount(child);
            return (
              <a
                href={join(`/channels/${channel.id}/${child.id}`)}
                class="flex flex-col bg-white border rounded p-5 hover:shadow-md transition-all"
                style={`border-color:var(--color-border);border-left:4px solid ${channel.accentColor};`}
              >
                <h3 class="text-base font-semibold leading-snug mb-2" style="color:#0b3c5d;">{child.name}</h3>
                {child.description && (
                  <p class="text-sm leading-relaxed" style="color:var(--color-muted-foreground);">{child.description}</p>
                )}
                <span class="mt-auto pt-3 inline-flex items-center gap-1.5 text-sm font-semibold" style={`color:${channel.accentColor};`}>
                  {count > 0 ? `Explore ${count} ${count === 1 ? "Article" : "Articles"}` : "Explore"} <ArrowRight className="w-4 h-4" />
                </span>
              </a>
            );
          })}
        </div>
      </>
    ) : null}

    {/* A parent topic can carry BOTH child topics and its own direct
        articles (e.g. Sermon Toolbox: "Bible Study Tools" plus the
        Sermon Communication Planning child) — render the item list
        after the children grid instead of hiding it. */}
    {!isNewsletter && hasItems ? (
      <div class={hasChildren ? "mt-12" : ""}>
      <>
        {topicBookCover && (
          <div class="mb-8 flex flex-col items-start">
            <div class="max-w-[240px] w-full">
              <Image
                src={topicBookCover}
                alt={sub.name}
                widths={[240, 480]}
                sizes="240px"
                class="w-full h-auto rounded shadow-md"
                loading="eager"
              />
            </div>
          </div>
        )}

        {showTopicButtons && (
          <div class="mb-8 -mt-2 flex justify-start">
            <div class="flex flex-wrap gap-2">
                {sub.formats!.includes("book") && (
                  topicBookHref
                    ? <a href={topicBookHref} class={btnClass(true)} style="background-color:#de5b0014;color:#de5b00;border:1px solid #de5b0040;"><FileText className="w-3 h-3" />Book</a>
                    : <span class={btnClass(false)} style="background-color:rgba(0,0,0,0.04);color:#9ca3af;border:1px solid rgba(0,0,0,0.06);" title="Book coming soon"><FileText className="w-3 h-3" />Book</span>
                )}
                {sub.formats!.includes("playlist") && (
                  topicPlaylistHref
                    ? <a href={topicPlaylistHref} class={btnClass(true)} style="background-color:#de5b0014;color:#de5b00;border:1px solid #de5b0040;"><Video className="w-3 h-3" />Playlist</a>
                    : <span class={btnClass(false)} style="background-color:rgba(0,0,0,0.04);color:#9ca3af;border:1px solid rgba(0,0,0,0.06);" title="Playlist coming soon"><Video className="w-3 h-3" />Playlist</span>
                )}
                {sub.formats!.includes("app") && (
                  topicAppHref
                    ? <a href={topicAppHref} target="_blank" rel="noopener noreferrer" class={btnClass(true)} style="background-color:#de5b0014;color:#de5b00;border:1px solid #de5b0040;"><Smartphone className="w-3 h-3" />App</a>
                    : <span class={btnClass(false)} style="background-color:rgba(0,0,0,0.04);color:#9ca3af;border:1px solid rgba(0,0,0,0.06);" title="App coming soon"><Smartphone className="w-3 h-3" />App</span>
                )}
            </div>
          </div>
        )}

        <div class="mb-6 pb-4 border-b" style="border-color:var(--color-border);">
          <h2 class="text-2xl" style="color:#0b3c5d;">Articles</h2>
          <div class="mt-2 h-0.5 w-12" style="background-color:#de5b00;"></div>
        </div>
        <ol class="space-y-2">
          {sub.items!.filter(item => !item.unlisted).map((item, idx, visible) => {
            /* Section subheading — rendered above the first item of each
               labelled section (e.g. "Core Principles" / "Kingdom Impact"). */
            const sectionHeading =
              item.section && item.section !== visible[idx - 1]?.section
                ? item.section
                : undefined;
            // PDF resolution order (per-item):
            //   1. item.bookId  → curated EQUIP book (with email gate)
            //   2. item.links.pdf  → explicit external override
            //   3. item.links.app  → if the app slug has a generated article
            //      PDF in /articles/, link to it directly (no email gate)
            // Article PDFs are auto-generated from app.jesusonline.com source
            // by @workspace/scripts articles:build — see src/data/articles.ts.
            const appArticleSlug = extractAppSlug(item.links?.app);
            const articlePdfHref = hasArticlePdf(appArticleSlug)
              ? join(`/articles/${appArticleSlug}.pdf`)
              : undefined;
            // BCG article items link to their locally generated PDF at
            // /articles/bcg/<articleId>.pdf (see scripts bcg:pdf).
            const bcgPdfHref = hasBcgArticlePdf(item.articleId)
              ? join(`/articles/bcg/${item.articleId}.pdf`)
              : undefined;
            // Bible Study Methods article items link to their locally generated
            // PDF at /articles/bsm/<articleId>.pdf (see scripts bsm:pdf).
            const bsmPdfHref = hasBsmArticlePdf(item.articleId)
              ? join(`/articles/bsm/${item.articleId}.pdf`)
              : undefined;
            // Items with an on-site article (articleId) link the PDF button
            // straight to the article's PDF — even when a same-titled book
            // exists (the Book chip/covers still lead to the gated book page).
            const directPdfHref = item.links?.pdf ?? bcgPdfHref ?? bsmPdfHref ?? articlePdfHref;
            const bookPdfHref = item.bookId
              ? join(`/books?download=${encodeURIComponent(item.bookId)}#${encodeURIComponent(item.bookId)}`)
              : undefined;
            const pdfHref = item.articleId
              ? (directPdfHref ?? bookPdfHref)
              : (bookPdfHref ?? directPdfHref);
            const pdfInternal = pdfHref !== item.links?.pdf;

            // Video: enabled only when this item has a matching video inside a
            // playlist — the sub-topic's own `playlistId`, or a per-item
            // `videoPlaylistId` override when the video lives in another playlist.
            // Falls back to an explicit external `links.video` override.
            const videoPlaylistId = item.videoPlaylistId ?? sub.playlistId;
            const videoHref = item.videoId && videoPlaylistId
              ? join(`/playlist/${encodeURIComponent(videoPlaylistId)}?play=${encodeURIComponent(item.videoId)}`)
              : item.links?.video;
            const videoInternal = !!(item.videoId && videoPlaylistId);

            const appHref = item.links?.app;

            // Button order: Read, Video, PDF (App last when shown).
            const buttons: { label: string; icon: any; href?: string; internal?: boolean }[] = [
              { label: "Video", icon: Video, href: videoHref, internal: videoInternal },
              { label: "PDF", icon: FileText, href: pdfHref, internal: pdfInternal },
              // App button is omitted for BCG article items (those with an articleId).
              ...(item.articleId ? [] : [{ label: "App", icon: Smartphone, href: appHref, internal: false }]),
            ];
            // Article: when an item has an articleId, its title is a link
            // to /channels/<channelId>/<subId>/<articleId> (the per-article page).
            const articleHref = item.articleId
              ? join(`/channels/${channel.id}/${sub.id}/${item.articleId}`)
              : undefined;
            return (
              <>
              {sectionHeading && (
                <li class={"list-none" + (idx > 0 ? " pt-6" : "")} id={sectionHeading.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}>
                  <h3 class="text-lg font-semibold" style="color:#0b3c5d;">{sectionHeading}</h3>
                  <div class="mt-1.5 h-0.5 w-10" style={`background-color:${channel.accentColor};`}></div>
                </li>
              )}
              <li class="flex items-start gap-4 p-4 bg-white border rounded hover:shadow-sm transition-all" style="border-color:var(--color-border);">
                {!sub.hideNumbers && (
                  <span class="shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-mono font-semibold text-sm" style={`background-color:${channel.accentColor}15;color:${channel.accentColor};`}>
                    {item.number}
                  </span>
                )}
                <div class="flex-grow min-w-0">
                  <h3 class="text-base leading-snug mb-2.5" style="color:#0b3c5d;">
                    {articleHref
                      ? <a href={articleHref} class="hover:underline" style="color:#0b3c5d;">{item.title}</a>
                      : item.title}
                  </h3>
                  <div class="flex flex-wrap gap-1.5">
                    {articleHref && (
                      <a href={articleHref} class={btnClass(true)} style="background-color:#de5b0014;color:#de5b00;border:1px solid #de5b0040;">
                        <FileText className="w-3 h-3" />Read
                      </a>
                    )}
                    {buttons.map(b => {
                      const enabled = !!b.href && b.href !== "#";
                      const Icon = b.icon;
                      const enabledStyle = `background-color:#de5b0014;color:#de5b00;border:1px solid #de5b0040;`;
                      const disabledStyle = "background-color:rgba(0,0,0,0.04);color:#9ca3af;border:1px solid rgba(0,0,0,0.06);";
                      if (!enabled) {
                        return (
                          <span class={btnClass(false)} style={disabledStyle} title={`${b.label} coming soon`}>
                            <Icon className="w-3 h-3" />{b.label}
                          </span>
                        );
                      }
                      return b.internal ? (
                        <a href={b.href} class={btnClass(true)} style={enabledStyle}>
                          <Icon className="w-3 h-3" />{b.label}
                        </a>
                      ) : (
                        <a href={b.href} target="_blank" rel="noopener noreferrer" class={btnClass(true)} style={enabledStyle}>
                          <Icon className="w-3 h-3" />{b.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </li>
              </>
            );
          })}
        </ol>
      </>
      </div>
    ) : !isNewsletter && !hasChildren ? (
      <div class="py-16 text-center border border-dashed rounded bg-white" style="border-color:var(--color-border);">
        <p class="mb-2" style="color:var(--color-muted-foreground);">Resources for this topic are being prepared.</p>
        <p class="text-sm" style="color:var(--color-muted-foreground);opacity:0.7;">Check back soon for books, playlists, and app content.</p>
      </div>
    ) : null}

    {!isNewsletter && next && (
      <a href={join(`/channels/${channel.id}/${next.id}`)} class="group block mt-12 p-6 md:p-7 rounded border-2 hover:shadow-md transition-all" style={`border-color:${channel.accentColor};background-color:${channel.accentColor}06;`}>
        <div class="flex items-center justify-between gap-4">
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest mb-1" style={`color:${channel.accentColor};`}>Up Next</div>
            <h3 class="text-xl md:text-2xl font-semibold group-hover:underline" style="color:#0b3c5d;">{next.name}</h3>
            <p class="text-sm mt-1" style="color:var(--color-muted-foreground);">Continue exploring {channel.shortName} Resources</p>
          </div>
          <div class="shrink-0 w-12 h-12 rounded-full flex items-center justify-center transition-transform group-hover:translate-x-1" style={`background-color:${channel.accentColor};`}>
            <ArrowRight className="w-5 h-5" style={{ color: "#fff" }} />
          </div>
        </div>
      </a>
    )}
  </div>
</Layout>
