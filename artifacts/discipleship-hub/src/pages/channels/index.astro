---
import Layout from "@/layouts/Layout.astro";
import ChannelArt from "@/components/ChannelArt.astro";
import { channels, getSubTopicsByChannel } from "@/data/channels";
import { ArrowRight } from "lucide-react";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;
---
<Layout
  title="Resource Channels: Evidence, Growth & Church | JO EQUIP"
  description="Explore three free resource channels: Evidence (apologetics), Growth (discipleship) and Church (evangelism and church planting), designed to equip pastors and ministry leaders."
>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "Channels", url: "/channels" },
    ]} />
  </Fragment>
  <div class="container mx-auto px-4 py-12 md:py-16">
    <div class="max-w-3xl mb-12">
      <div class="text-xs font-semibold tracking-widest uppercase mb-3" style="color:#0083de;">JO EQUIP</div>
      <h1 class="text-4xl md:text-5xl mb-4" style="color:#0b3c5d;">Ministry Channels</h1>
      <div class="h-0.5 w-12 mb-5" style="background-color:#de5b00;"></div>
      <p class="leading-relaxed text-lg" style="color:var(--color-muted-foreground);">
        These free resources are grouped to help you serve with greater
        effectiveness and spiritual vitality in fulfilling Christ's Great Commission.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {channels.map(channel => {
        const subCount = getSubTopicsByChannel(channel.id).length;
        return (
          <a href={join(`/channels/${channel.id}`)} class="group flex flex-col">
            <h2 class="text-2xl font-semibold mb-2 group-hover:underline" style="color:#0b3c5d;">{channel.name}</h2>
            <div class="flex flex-col flex-grow bg-white border rounded overflow-hidden group-hover:shadow-lg transition-all" style={`border-color:var(--color-border);border-left:4px solid ${channel.accentColor};`}>
              <div style={`height:14px;background-color:${channel.accentColor};`}></div>
              <div class="relative aspect-[64/22] overflow-hidden" style={`background:${channel.gradient};`}>
                <ChannelArt channel={channel.id} class="absolute inset-0" />
              </div>
              <div style={`height:6px;background-color:${channel.accentColor};`}></div>
              <div class="p-6 flex flex-col flex-grow">
                <p class="text-sm font-medium mb-4" style={`color:${channel.accentColor};`}>{channel.tagline}</p>
                <p class="leading-relaxed text-sm mb-5 flex-grow" style="color:var(--color-muted-foreground);">{channel.description}</p>
                <div class="pt-4 border-t" style="border-color:rgba(229,231,235,0.6);">
                  <span class="inline-flex items-center justify-center w-full text-sm font-semibold text-white rounded px-4 py-2.5 transition-opacity group-hover:opacity-90" style={`background-color:${channel.accentColor};`}>
                    Explore {subCount} {channel.shortName} Topics <ArrowRight className="w-4 h-4 ml-1.5" />
                  </span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
