---
import Layout from "@/layouts/Layout.astro";
import PersonaPage from "@/components/PersonaPage.astro";
---
<Layout
  title="Free Resources for Chaplains | JO EQUIP"
  description="JO EQUIP provides chaplains with free, transformational resources to support spiritual care in hospitals, military settings, prisons, hospice, and other places of need."
>
  <PersonaPage
    heading="Helping Chaplains Bring Hope and Christ-Centered Transformation"
    intro={[
      "<strong style=\"color:#0b3c5d;\">JO EQUIP</strong> provides chaplains with free, transformational resources designed to support spiritual care in hospitals, military settings, prisons, hospice, and other places of need.",
      "These tools equip chaplains to offer more than temporary comfort\u2014fostering genuine heart change, secure identity in Christ, and lasting hope that anchors people through crisis, suffering, and transition.",
      "All resources are available at no cost and are carefully crafted to strengthen the chaplain\u2019s ministry of presence, listening, and Spirit-led guidance.",
    ]}
    articles={[
      {
        title: "God in Times of Crisis",
        text: "Biblical anchors that steady hearts facing illness, loss, trauma, or uncertainty\u2014equipping chaplains to speak lasting hope.",
        href: "/categories/growth/hope-times-crisis/god-in-times-of-crisis",
      },
      {
        title: "Embracing Your New Identity in Christ",
        text: "Helping people rediscover who they are as children of God, saints with a new nature, and citizens of His Kingdom\u2014especially when circumstances seek to redefine them.",
        href: "/categories/growth/identity-in-christ/embracing-your-new-identity-in-christ",
      },
      {
        title: "Empowered for Supernatural Living",
        text: "Practical guidance for depending on the Holy Spirit\u2019s presence and power in the midst of caregiving and personal ministry.",
        href: "/categories/growth/ministry-holy-spirit/empowered-for-supernatural-living",
      },
    ]}
    booksNote="Free PDF downloads suitable for personal reading, quiet reflection with those you serve, or distribution in care settings."
    bookIds={[
      "your-new-identity-in-christ",
      "walking-in-the-spirit",
      "adventure-of-living-with-jesus",
      "who-is-the-real-jesus",
      "soul-prescription",
      "from-coping-to-cure",
      "struggle-for-inner-peace",
      "5-steps-to-break-destructive-behavior",
    ]}
    topics={[
      { name: "Hope in Times of Crisis", href: "/categories/growth/hope-times-crisis" },
      { name: "Your Identity in Christ", href: "/categories/growth/identity-in-christ" },
      { name: "Walking in the Spirit", href: "/categories/growth/ministry-holy-spirit" },
      { name: "Inner Peace", href: "/categories/growth/inner-peace" },
      { name: "Forever Loved", href: "/categories/growth/forever-loved" },
      { name: "Prayer", href: "/categories/growth/prayer" },
      { name: "Attributes of God", href: "/categories/growth/attributes-of-god" },
      { name: "Biblical Counseling Insights", href: "/categories/church/biblical-counseling-insights" },
    ]}
    playlistsNote="Video series suitable for personal equipping, quiet moments of ministry preparation, or sharing selected clips that speak hope and truth."
    playlistIds={[
      "hope-in-times-of-crisis",
      "life-in-the-spirit",
      "who-is-the-real-jesus",
      "7-habits-deeper-relationship-with-god",
      "experience-gods-love",
      "facts-for-faith",
    ]}
    closing={[
      "All resources are free and designed to guide people from basic faith to secure identity in Christ, Spirit-empowered living, and resilient hope\u2014even in the most challenging seasons of life.",
      "These tools strengthen the chaplain\u2019s calling to walk alongside others with presence, truth, and compassion, pointing always to the One who is our ultimate Hope and Peace.",
    ]}
  />
</Layout>
