---
import ResourceLanding from "@/components/ResourceLanding.astro";
import DiscipleshipResourcesContent from "@/components/DiscipleshipResourcesContent.astro";
import type { Section } from "@/components/resourceLandingTypes";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

const sections: Section[] = [
  {
    kind: "links",
    heading: "Read Key Discipleship Articles",
    items: [
      { lead: "Total Life Discipleship Church", href: join("/categories/church/become-growing-church/a-total-life-discipleship-church") },
      { lead: "Transformational Teaching Church", href: join("/categories/church/become-growing-church/a-transformational-teaching-church") },
      { lead: "Making & Multiplying Disciples Newsletter", href: join("/categories/church/make-multiply-disciples-newsletter") },
    ],
  },
  {
    kind: "links",
    heading: "Explore Discipleship Topics",
    items: [
      { lead: "The Adventure of Living with Jesus", rest: "(Basic Discipleship)", href: join("/categories/growth/adventure-living-jesus") },
      { lead: "New Life in Christ", rest: "(Intermediate Discipleship)", href: join("/categories/growth/new-life-christ") },
      { lead: "Total Life Discipleship", rest: "(holistic, Kingdom perspective)", href: join("/categories/church/total-life-discipleship-principles") },
    ],
  },
  {
    kind: "playlists",
    heading: "Watch Discipleship Videos",
    ids: ["total-life-discipleship-core-principles", "total-life-discipleship-kingdom-perspective"],
    seeAll: true,
  },
  {
    kind: "books",
    heading: "Download Free Discipleship Books",
    ids: ["beholding-the-majesty-of-god", "your-new-identity-in-christ", "walking-in-the-spirit"],
    seeAll: true,
  },
];
const headings = [
  "Read Key Discipleship Articles",
  "Explore Discipleship Topics",
  "Watch Discipleship Videos",
  "Download Free Discipleship Books",
  "What Are Discipleship Resources?",
  "How Do Discipleship Resources Help Believers Grow in Faith?",
  "Discipleship Resources for Different Ministry Roles",
  "How to Choose the Right Discipleship Resources",
  "Why Choose JO EQUIP Discipleship Resources?",
  "FAQs",
];
const contents = headings.map(label => ({
  label,
  id: label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
}));
---
<ResourceLanding
  title="Discipleship Resources & Training Materials | JO EQUIP"
  description="Get free discipleship resources and training materials to strengthen faith, grow mature disciples and equip Christians to disciple others."
  heroTitle="Discipleship Resources"
  heroIntro="Explore a collection of discipleship resources to help pastors, home church leaders, missionaries, chaplains & believers deepen their walk with Christ and equip them to be fruitful followers."
  sections={sections}
  contents={contents}
>
  <DiscipleshipResourcesContent />
</ResourceLanding>
