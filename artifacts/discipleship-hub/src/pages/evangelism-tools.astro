---
import ResourceLanding from "@/components/ResourceLanding.astro";
import type { Section } from "@/components/resourceLandingTypes";
import content from "@/data/evangelismToolsContent.json";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

const sections: Section[] = [
  {
    kind: "links",
    heading: "Read Key Evangelism Articles",
    items: [
      { lead: "Reasons Why Believers Should Witness", href: join("/categories/church/understanding-evangelism/reasons-why-believers-should-witness") },
      { lead: "The Power", href: join("/categories/church/sharing-your-faith/the-power") },
      { lead: "Next Steps for New Believers", href: join("/categories/church/next-steps-new-believers/next-steps-for-new-believers") },
    ],
  },
  {
    kind: "links",
    heading: "Explore Evangelism Topics",
    items: [
      { lead: "Share Jesus", href: join("/categories/church/share-jesus") },
    ],
  },
  {
    kind: "playlists",
    heading: "Watch Evangelism Videos",
    ids: ["meet-jesus", "who-is-the-real-jesus", "facts-for-faith"],
  },
  {
    kind: "books",
    heading: "Download Free Evangelism Books",
    ids: [
      "extraordinary-evangelism",
      "extraordinary-evangelism-student-guide",
      "who-is-the-real-jesus",
      "has-science-discovered-god",
    ],
  },
];
const headingId = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const contents = [
  ...sections.map(s => ({ id: headingId(s.heading), label: s.heading })),
  ...content.filter(b => b.type === "h2").map(b => ({ id: headingId(b.text!), label: b.text! })),
];
const withBaseLinks = (html: string) => html.replace(/href="(\/[^"]*)"/g, (_, path) => `href="${join(path)}"`);
---
<ResourceLanding
  title="Evangelism Tools & Resources for Ministry Leaders | JO EQUIP"
  description="Find practical evangelism tools and resources for sharing the Gospel, reaching communities, and supporting ministry. Explore free resources from JO EQUIP."
  heroTitle="Evangelism Tools to Support Outreach and Discipleship"
  heroIntro="Find practical evangelism tools, prayerfully designed to equip pastors, home church leaders, chaplains, missionaries, and believers to share the Gospel with clarity, courage, and compassion."
  sections={sections}
  contents={contents}
>
  <div class="evangelism-copy container mx-auto max-w-3xl px-4 py-10 md:py-14">
    {content.map(b => b.type === "h2"
      ? <h2 id={headingId(b.text!)}>{b.text}</h2>
      : b.type === "h3" ? <h3>{b.text}</h3>
      : b.type === "ul" ? <ul>{b.items!.map(item => <li set:html={withBaseLinks(item)} />)}</ul>
      : <p set:html={withBaseLinks(b.html!)} />)}
  </div>
</ResourceLanding>

<style>
  .evangelism-copy { color: var(--color-text); font-size: 1.0625rem; line-height: 1.8; }
  .evangelism-copy h2 { color: var(--color-structure); font-size: 1.75rem; font-weight: 600; margin: 2.5rem 0 1rem; scroll-margin-top: 7rem; line-height: 1.3; }
  .evangelism-copy h2:first-child { margin-top: 0; }
  .evangelism-copy h3 { color: var(--color-structure); font-size: 1.25rem; font-weight: 600; margin: 1.75rem 0 .75rem; line-height: 1.4; }
  .evangelism-copy p { margin-bottom: 1rem; }
  .evangelism-copy ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1rem; }
  .evangelism-copy li { margin-bottom: .5rem; }
  .evangelism-copy :global(a) { color: var(--color-action-warm); text-decoration: underline; overflow-wrap: anywhere; }
</style>
