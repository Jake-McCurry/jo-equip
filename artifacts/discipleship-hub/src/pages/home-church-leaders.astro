---
import Layout from "@/layouts/Layout.astro";
import PersonaPage from "@/components/PersonaPage.astro";
import PersonaPageLd from "@/components/PersonaPageLd.astro";

const description = "Equip your home church with free Bible studies, discipleship tools and small group ministry resources designed to help leaders grow and multiply mature disciples.";
---
<Layout
  title="Home Church Resources for Leaders & Discipleship | JO EQUIP"
  description={description}
>
  <PersonaPageLd slot="head" pageName="Home Church Leaders" pageUrl="https://equip.jesusonline.com/home-church-leaders" pageDescription={description} />
  <PersonaPage
    heading="Helping Home Church Leaders Multiply Mature Disciples"
    linkIntroHome={true}
    linkLeadVideos={true}
    intro={[
      "<strong style=\"color:var(--color-text);\">JO EQUIP</strong> provides home church leaders with free, transformational resources designed to help form mature, Christlike disciples within simple, relational gatherings.",
      "These practical tools support leaders who gather in homes and neighborhoods, offering a clear framework for spiritual growth that produces genuine heart change rather than mere transfer of knowledge\u2014equipping ordinary believers to live as disciples who make disciples.",
      "All resources are available at no cost and are crafted to strengthen Spirit-led community, intentional discipleship, and lasting Kingdom impact through the home church.",
    ]}
    articles={[
      {
        title: "Total Life Discipleship",
        text: "Holistic discipleship with a Kingdom perspective that leads to lasting transformation and eternal impact within the home church setting.",
        href: "/categories/church/become-growing-church/a-total-life-discipleship-church",
      },
      {
        title: "Embracing Your New Identity in Christ",
        text: "Helping people rediscover who they are as children of God, saints with a new nature, and citizens of His Kingdom\u2014especially when circumstances seek to redefine them.",
        href: "/categories/growth/identity-in-christ/embracing-your-new-identity-in-christ",
      },
      {
        title: "God's Unique Vision for Kingdom-focused Growth",
        text: "It fits your people perfectly and releases fresh growth, life, and lasting Kingdom impact.",
        href: "/categories/church/become-growing-church/gods-unique-vision-for-your-church",
      },
    ]}
    booksNote="Free PDF downloads suitable for personal reading, shared study in home gatherings, or distribution among emerging leaders."
    bookIds={[
      "adventure-of-living-with-jesus",
      "your-new-identity-in-christ",
      "walking-in-the-spirit",
      "extraordinary-evangelism",
      "who-is-the-real-jesus",
      "the-abiding-room",
      "5-steps-to-break-destructive-behavior",
    ]}
    topics={[
      { name: "Total Life Discipleship", href: "/categories/church/total-life-discipleship-principles" },
      { name: "Making & Multiplying Disciples", href: "/categories/church" },
      { name: "Become a Growing Church", href: "/categories/church/become-growing-church" },
      { name: "Walking in the Spirit", href: "/categories/growth/ministry-holy-spirit" },
      { name: "Your Identity in Christ", href: "/categories/growth/identity-in-christ" },
      { name: "Building Blocks for Maturity", href: "/categories/growth/building-blocks" },
      { name: "Prayer", href: "/categories/growth/prayer" },
      { name: "Share Jesus / Extraordinary Evangelism", href: "/categories/church/share-jesus" },
    ]}
    playlistsNote="Video series ideal for home gatherings, leadership training, small-group discussion, or personal equipping of emerging disciple-makers."
    playlistIds={[
      "total-life-discipleship-core-principles",
      "total-life-discipleship-kingdom-perspective",
      "life-in-the-spirit",
      "who-is-the-real-jesus",
      "7-habits-deeper-relationship-with-god",
      "hope-in-times-of-crisis",
    ]}
    closing={[
      "All resources are free and designed to guide people from basic faith to secure identity in Christ, Spirit-empowered living, and fruitful multiplication\u2014enabling home churches to grow in depth and to multiply for the sake of the Kingdom.",
      "These tools strengthen leaders who gather simply and intentionally, cultivating communities where every believer is equipped to walk with Jesus and to help others do the same.",
    ]}
    faqIntro="Answers to common questions about free discipleship resources for home church leaders."
    faqs={[
      {
        question: "What are the free resources for home church leaders?",
        answer: [
          "The free resources for home church leaders include ministry training materials, disciple-making resources, Christian books, video series, and practical discipleship tools. JO EQUIP from JesusOnline Ministries provides free articles, books, playlists, videos, and discipleship resources to help leaders teach, mentor, equip believers, and develop mature, Christlike disciples. Total Life Discipleship provides holistic guidance with a Kingdom perspective to help home churches grow mature disciples and create lasting spiritual impact.",
          "JO EQUIP also offers an insightful resource (Become a Growing Church), which provides practical guidance to help church leaders build a Kingdom-centered vision and encourage spiritual growth.",
        ],
      },
      {
        question: "Where can home church leaders find free discipleship resources?",
        answer: [
          "Home church leaders can get free discipleship resources at JO EQUIP. It provides Bible-centered books, articles, & video playlists for individual study, home churches, small groups, leadership development, and disciple-making. The resources include Total Life Discipleship and Become a Growing Church can also help leaders develop spiritually mature communities and multiply disciples.",
        ],
      },
      {
        question: "Where can home church leaders find free discipleship materials?",
        answer: [
          "Home church leaders can find free discipleship resources through JO EQUIP, the ministry resources hub from JesusOnline Ministries. Its resources include books, articles, videos, and playlists that can be used for personal growth, home gatherings, small groups, and developing mature disciples.",
          "JO EQUIP also provides a valuable resource, (Become a Growing Church) to assist home church leaders cultivate spiritually mature communities and multiply disciples.",
        ],
      },
      {
        question: "What resources can help leaders teach discipleship?",
        answer: [
          "Some useful resources that can help leaders teach discipleship include Building Blocks for Maturity, and Extraordinary Evangelism. Total Life Discipleship offers home church leaders a holistic, Kingdom centered practice to help believers grow in Christ and become mature disciples. JO EQUIP also provides video playlists and practical articles that home church leaders can use for personal study, home gatherings, small groups, and discipleship.",
          "JO EQUIP also offers a more comprehensive resource, (Become a Growing Church) to help home church leaders develop mature disciples and encourage spiritual multiplication.",
        ],
      },
      {
        question: "Where can home church leaders find free Christian leadership books?",
        answer: [
          "Home church leaders can find free Christian leadership books through JO EQUIP. These resources help leaders grow in their relationship with Christ and learn to lead others according to God’s Word. Books on Extraordinary Evangelism, The Abiding Room can provide biblical guidance for leading home gatherings, helping believers mature in Christ, and making disciples.",
        ],
      },
      {
        question: "Where can home church leaders find free discipleship videos?",
        answer: [
          "Home church leaders can find free discipleship videos through JO EQUIP. These resources are designed to help leaders shepherd believers toward a deeper walk with Christ and faithfully make disciples. Total Life Discipleship – Core Principles and Kingdom Perspective help leaders cultivate a Kingdom-centered vision for discipleship. Life in the Spirit, Who Is the Real Jesus?, and 7 Habits for a Deeper Relationship with God encourage believers to know Jesus, walk by the Spirit, and grow in their relationship with God. These videos can serve as a foundation for Christ-centered teaching, prayer, fellowship, and discipleship within home churches.",
        ],
      },
      {
        question: "Where can home church leaders find free resources for spiritual maturity?",
        answer: [
          "Home church leaders can find free resources for spiritual maturity through JO EQUIP. Total Life Discipleship helps leaders encourage believers in their walk with Christ and grow in a Kingdom-centered faith. Become a Growing Church, the biblically grounded resource encourages leaders to build a Christ-rooted community where believers grow together and make disciples. These resources can help home church leaders shepherd God’s people with love, truth, & a desire to see Christ formed in their lives.",
        ],
      },
    ]}
  />
</Layout>
