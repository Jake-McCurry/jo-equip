---
import Layout from "@/layouts/Layout.astro";
import HomeContent from "@/components/HomeContent.astro";

// JSON-LD structured data — Organization + WebSite. Helps search engines
// build a knowledge panel and display the site name correctly in results.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://jesusonlineministries.org/#org",
      "name": "JesusOnline Ministries",
      "url": "https://jesusonlineministries.org",
      "logo": "https://equip.jesusonline.com/favicon.svg",
      "email": "equip@jesusonline.com",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "equip@jesusonline.com",
        "availableLanguage": ["English"],
      },
      /* `sameAs` is how Google links this Organization to its other web
         presences — strengthens Knowledge Panel signals. Add any official
         social profile URLs here when available (YouTube, Facebook, etc.). */
      "sameAs": [
        "https://app.jesusonline.com",
        "https://equip.jesusonline.com",
        "https://www.youtube.com/@jesusonlineministries",
        "https://www.facebook.com/jesusonlineministries/",
        "https://www.facebook.com/Jesusonlinecom/",
        "https://www.facebook.com/yjesusonline/",
        "https://www.instagram.com/jesusonlineministries/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://equip.jesusonline.com/#website",
      "name": "JO EQUIP | Free Discipleship & Ministry Resources",
      "url": "https://equip.jesusonline.com",
      "description": "Access free discipleship resources for pastors and ministry leaders, including books, videos and playlists to help make and multiply disciples of Christ.",
      "publisher": { "@id": "https://jesusonlineministries.org/#org" },
      "inLanguage": "en-US",
    },
  ],
};
---
<Layout
  title="JO EQUIP | Free Discipleship & Ministry Resources"
  description="Access free discipleship resources for pastors and ministry leaders, including books, videos and playlists to help make and multiply disciples of Christ."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <HomeContent />
</Layout>
