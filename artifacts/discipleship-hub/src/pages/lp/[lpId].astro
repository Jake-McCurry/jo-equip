---
import Layout from "@/layouts/Layout.astro";
import HomeContent from "@/components/HomeContent.astro";

/* Ad-campaign landing pages — exact duplicates of the home page on two URLs
   so each campaign gets its own trackable path (Aug 2026 request). Content
   lives in HomeContent.astro, shared with the real home page. Both stay
   noindex (duplicate content + paid-traffic pages) and are excluded from
   the sitemap by scripts/build-sitemaps.mjs. */
export function getStaticPaths() {
  return [
    { params: { lpId: "ENG-1-resources" } },
    { params: { lpId: "ENG-2-resources" } },
  ];
}
---
<Layout
  title="JO EQUIP | Free Discipleship & Ministry Resources"
  description="Access free discipleship resources for pastors and ministry leaders, including books, videos and playlists to help make and multiply disciples of Christ."
>
  <Fragment slot="head">
    {/* Paid-campaign landing page: two identical URLs, keep both out of the index. */}
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <HomeContent />
</Layout>
