---
import Layout from "@/layouts/Layout.astro";
import { Image, Picture, getImage } from "astro:assets";
import { channels } from "@/data/channels";
import { ArrowRight, Users2, BookOpen, Play, Smartphone, Star } from "lucide-react";
import { books } from "@/data/books";
import { getBookCover } from "@/data/bookCovers";
import { playlists, playlistThumbnail } from "@/data/playlists";
import evidenceImg from "@/assets/channels/evidence.jpg";
import heroCollage from "@/assets/home-hero-collage.png";
import growthImg from "@/assets/channels/growth.jpg";
import churchImg from "@/assets/channels/church.jpg";

/* Ad-campaign landing pages — started as an exact copy of the home page
   (Aug 2026 request) but intentionally maintained as a SEPARATE copy so the
   home page and the LPs can evolve independently. Two identical pages on two
   URLs so each campaign gets its own trackable path. Both are noindex
   (duplicate content + paid-traffic pages) and excluded from the sitemap by
   scripts/build-sitemaps.mjs. */
export function getStaticPaths() {
  return [
    { params: { lpId: "ENG-1-resources" } },
    { params: { lpId: "ENG-2-resources" } },
  ];
}

// Hero background — optimized once at build time, used as a CSS background.
const heroBg = await getImage({
  src: heroCollage,
  format: "webp",
  quality: 70,
  width: 2172,
});

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

const channelImages: Record<string, ImageMetadata> = {
  evidence: evidenceImg,
  growth: growthImg,
  church: churchImg,
};

const channelImageAlts: Record<string, string> = {
  evidence: "A gavel and scales of justice resting on old books",
  growth: "Hands holding an open Bible",
  church: "A congregation seated in church pews",
};

interface QuickLink {
  title: string;
  subtitle: string;
  href: string;
  icon: any;
  external?: boolean;
}

const quickLinks: QuickLink[] = [
  { title: "Reviews", subtitle: "From Pastors and Leaders", href: join("/reviews"), icon: Star },
  { title: "About", subtitle: "JesusOnline Ministries", href: join("/about"), icon: Users2 },
  { title: "Beliefs", subtitle: "Statement of Faith", href: join("/beliefs"), icon: BookOpen },
  { title: "JO APP", subtitle: "Growing in Christ", href: "https://app.jesusonline.com", icon: Smartphone, external: true },
];

const personaLinks = [
  { title: "Pastors", href: join("/pastors") },
  { title: "Home Church Leaders", href: join("/home-church-leaders") },
  { title: "Chaplains", href: join("/chaplains") },
  { title: "Missionaries", href: join("/missionaries") },
];

// Match the featured Books and Playlists used on the Pastors landing page.
const featuredBooks = [
  "adventure-of-living-with-jesus",
  "who-is-the-real-jesus",
  "walking-in-the-spirit",
  "extraordinary-evangelism",
  "extraordinary-evangelism-student-guide",
  "your-new-identity-in-christ",
  "5-steps-to-break-destructive-behavior",
]
  .map(id => books.find(book => book.id === id))
  .filter((book): book is (typeof books)[number] => Boolean(book));

const featuredPlaylists = [
  "who-is-the-real-jesus",
  "total-life-discipleship-core-principles",
  "total-life-discipleship-kingdom-perspective",
  "life-in-the-spirit",
  "7-habits-deeper-relationship-with-god",
  "hope-in-times-of-crisis",
]
  .map(id => playlists.find(playlist => playlist.id === id))
  .filter((playlist): playlist is (typeof playlists)[number] => Boolean(playlist));
---
<Layout
  title="JO EQUIP | Free Discipleship & Ministry Resources"
  description="Access free discipleship resources for pastors and ministry leaders, including books, videos and playlists to help make and multiply disciples of Christ."
>
  <Fragment slot="head">
    {/* Paid-campaign landing page: two identical URLs, keep both out of the index. */}
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  {/* Hero — same as the home page at time of copy. */}
  <section class="relative py-10 md:py-16 px-4 text-center overflow-hidden" style="background-color:#0b3c5d;">
    <div
      class="pointer-events-none absolute inset-0"
      style={`background-image:url('${heroBg.src}');background-size:cover;background-position:center;`}
      aria-hidden="true"
    ></div>
    {/* Light navy wash so the white text stays readable while the collage shows through. */}
    <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom, rgba(11,60,93,0.35), rgba(11,60,93,0.25));"></div>

    <div class="relative container mx-auto max-w-4xl">
      <h1 class="text-2xl sm:text-4xl md:text-5xl leading-tight" style="color:#ffffff;font-weight:500;text-shadow:0 1px 12px rgba(11,60,93,0.6);">Reach people. Grow disciples.<br />Multiply churches.</h1>
    </div>
  </section>

  {/* Tagline + persona links */}
  <section class="py-8 md:py-10 px-4 text-center bg-white">
    <div class="container mx-auto max-w-4xl">
      <p class="text-base md:text-lg max-w-3xl mx-auto leading-relaxed" style="color:#374151;">
        Apologetics, identity-centered discipleship, and church vibrancy&mdash;united in one accessible free resource hub.
        <a href={join("/equip")} class="text-sm md:text-base whitespace-nowrap font-medium underline underline-offset-2" style="color:#de5b00;">Find out more</a>
      </p>
      <div class="mt-5 text-sm md:text-base flex flex-col items-center justify-center gap-1.5 sm:flex-row sm:flex-wrap sm:gap-0" style="color:#0b3c5d;">
        <span class="font-medium">Explore Free Resources for</span>
        <span class="flex flex-wrap items-center justify-center">
          {personaLinks.map(link => (
            <Fragment>
              <span aria-hidden="true" class="mx-1.5" style="color:#de5b00;">&bull;</span>
              <a href={link.href} class="underline underline-offset-2 whitespace-nowrap hover:opacity-90" style="color:#de5b00;">{link.title}</a>
            </Fragment>
          ))}
        </span>
      </div>
    </div>
  </section>

  {/* Featured books — same collection and mobile carousel as the Pastors page. */}
  <section class="py-10 md:py-14 bg-white border-t" style="border-color:var(--color-border);">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-semibold mb-2" style="color:#0b3c5d;">Books</h2>
      <p class="text-[15px] md:text-base leading-relaxed mb-6" style="color:#374151;">
        Free PDF downloads suitable for personal reading, leadership teams, or distribution.
      </p>
      <div class="flex gap-4 md:gap-5 overflow-x-auto pb-2 md:grid md:overflow-visible md:grid-cols-4 lg:grid-cols-8">
        {featuredBooks.map(book => {
          const cover = getBookCover(book.id);
          return (
            <a href={join(`/books/${book.id}`)} class="group shrink-0 w-[calc((100vw-5rem)/3.5)] max-w-[130px] md:w-auto md:max-w-none">
              <div class="border rounded overflow-hidden bg-white transition-shadow group-hover:shadow-md" style="border-color:var(--color-border);">
                {cover ? (
                  <Image src={cover} alt={book.title} width={260} class="w-full aspect-[3/4] object-cover" />
                ) : (
                  <div class="aspect-[3/4] flex items-center justify-center" style="background-color:#e6f2fa;">
                    <BookOpen className="w-8 h-8" style={{ color: "#94a3b8" }} />
                  </div>
                )}
              </div>
              <p class="mt-2 text-xs leading-snug font-medium group-hover:underline" style="color:#0b3c5d;">{book.title}</p>
            </a>
          );
        })}
        <a href={join("/books")} class="group shrink-0 w-[calc((100vw-5rem)/3.5)] max-w-[130px] md:w-auto md:max-w-none">
          <div class="aspect-[3/4] border-2 border-dashed rounded flex flex-col items-center justify-center gap-2 transition-colors group-hover:border-solid" style="border-color:#0083de;background-color:#e6f2fa;">
            <ArrowRight className="w-6 h-6" style={{ color: "#0083de" }} />
            <span class="text-sm font-semibold" style="color:#0083de;">More</span>
          </div>
          <p class="mt-2 text-xs leading-snug font-medium group-hover:underline" style="color:#0b3c5d;">All free books</p>
        </a>
      </div>
    </div>
  </section>

  {/* Featured playlists — same collection and mobile carousel as the Pastors page. */}
  <section class="py-10 md:py-14 bg-white border-t" style="border-color:var(--color-border);">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-semibold mb-2" style="color:#0b3c5d;">Playlists</h2>
      <p class="text-[15px] md:text-base leading-relaxed mb-6" style="color:#374151;">
        Sermon resources for pastors: video series for sermon starters, small groups, or personal equipping.
      </p>
      <div class="flex gap-4 md:gap-5 overflow-x-auto pb-2 md:grid md:overflow-visible md:grid-cols-3 lg:grid-cols-4">
        {featuredPlaylists.map(playlist => {
          const thumb = playlistThumbnail(playlist);
          return (
            <a href={join(`/playlist/${playlist.id}`)} class="group shrink-0 w-[calc((100vw-4rem)/2.5)] max-w-[220px] md:w-auto md:max-w-none">
              <div class="relative border rounded overflow-hidden bg-white transition-shadow group-hover:shadow-md" style="border-color:var(--color-border);">
                <div class="relative aspect-video bg-slate-100 overflow-hidden">
                  {thumb && (
                    <img src={thumb} alt={playlist.title} loading="lazy" width="320" height="180" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
                  )}
                  <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/15 transition-colors">
                    <div class="w-11 h-11 rounded-full flex items-center justify-center transition-all duration-200 scale-90 opacity-0 group-hover:opacity-100 group-hover:scale-100" style="background-color:rgba(255,255,255,0.95);">
                      <Play className="w-5 h-5 ml-0.5" style={{ color: "#de5b00", fill: "#de5b00" }} />
                    </div>
                  </div>
                </div>
              </div>
              <p class="mt-2 text-xs leading-snug font-medium group-hover:underline" style="color:#0b3c5d;">{playlist.title}</p>
            </a>
          );
        })}
        <a href={join("/playlists")} class="group shrink-0 w-[calc((100vw-4rem)/2.5)] max-w-[220px] md:w-auto md:max-w-none">
          <div class="aspect-video border-2 border-dashed rounded flex flex-col items-center justify-center gap-1.5 transition-colors group-hover:border-solid" style="border-color:#0083de;background-color:#e6f2fa;">
            <ArrowRight className="w-6 h-6" style={{ color: "#0083de" }} />
            <span class="text-sm font-semibold" style="color:#0083de;">More</span>
          </div>
          <p class="mt-2 text-xs leading-snug font-medium group-hover:underline" style="color:#0b3c5d;">All playlists</p>
        </a>
      </div>
    </div>
  </section>

  {/* Three Categories — photo cards */}
  <section class="py-10 md:py-14" style="background-color:#e6f2fa;">
    <div class="container mx-auto px-4">
      <h2 class="sr-only">Explore the three categories</h2>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-md sm:max-w-lg lg:max-w-none mx-auto">
        {channels.map(channel => {
          const accent = channel.accentColor;
          return (
          <a href={join(`/categories/${channel.id}`)} class="group flex flex-col">
            <h3 class="text-2xl font-semibold mb-2 group-hover:underline" style="color:#0b3c5d;">{channel.name}</h3>
            <div
              class="flex flex-col flex-grow bg-white border rounded overflow-hidden group-hover:shadow-lg transition-all"
              style={`border-color:var(--color-border);border-left:4px solid ${accent};`}
            >
              <div style={`height:8px;background-color:${accent};`}></div>
              <div class="relative aspect-[5/2] overflow-hidden">
                <Picture
                  src={channelImages[channel.id]}
                  alt={channelImageAlts[channel.id]}
                  widths={[480, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 512px, 100vw"
                  formats={["avif", "webp"]}
                  quality={75}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
              </div>
              <div style={`height:4px;background-color:${accent};`}></div>
              <div class="p-6 md:p-7 flex flex-col flex-grow">
                <p class="text-[15px] leading-snug mb-4 flex-grow" style="color:var(--color-muted-foreground);">{channel.tagline}</p>
                <span class="inline-flex items-center justify-center w-full text-sm font-semibold text-white rounded px-4 py-2.5 mt-auto transition-opacity group-hover:opacity-90" style={`background-color:${accent};`}>
                  Explore {channel.shortName}
                  <ArrowRight className="w-4 h-4 ml-1.5" />
                </span>
              </div>
            </div>
          </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* Quick links — Reviews · About · Beliefs · JO APP */}
  <section style="background-color:#0083de;">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 divide-white/15 sm:gap-y-px lg:divide-x lg:divide-white/15">
        {quickLinks.map(link => {
          const Icon = link.icon;
          return (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="group flex items-center justify-start lg:justify-center gap-4 py-5 px-6 transition-colors hover:bg-white/5"
            >
              <div class="w-11 h-11 rounded shrink-0 flex items-center justify-center" style="background-color:rgba(255,255,255,0.18);">
                <Icon className="w-5 h-5" style={{ color: "#ffffff" }} />
              </div>
              <div class="text-left">
                <div class="text-lg md:text-xl font-semibold text-white leading-tight tracking-wide group-hover:underline" style='font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'>{link.title}</div>
                <div class="text-[11px] mt-1 font-medium tracking-widest uppercase" style="color:rgba(255,255,255,0.8);">{link.subtitle}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
