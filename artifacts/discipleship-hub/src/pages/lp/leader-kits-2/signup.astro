---
import Layout from "@/layouts/Layout.astro";
import LeaderKitSignup from "@/components/LeaderKitSignup.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="Receive Your Free Leader Kit | JO EQUIP"
  description="Receive the free Adventure of Living with Jesus Leader Kit for pastors and home church leaders."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <section class="signup-page">
    <div class="signup-wrap">
      <p class="eyebrow">Free Ministry Resources</p>
      <h1>The Adventure of Living with Jesus</h1>
      <p class="intro">Receive the free Leader Kit with Ten Discipleship Moments — all ready to teach.</p>
      <LeaderKitSignup />
      <a class="back-link" href={`${baseUrl}/lp/leader-kits-2`}>Back to the Leader Kit</a>
    </div>
  </section>
</Layout>

<style>
  .signup-page { padding: 36px 20px 56px; background: #e8f3fc; }
  .signup-wrap { max-width: 480px; margin: 0 auto; }
  .eyebrow { color: #147bd1; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
  h1 { margin: 12px 0 16px; color: #0e2f60; font-size: 32px; line-height: 1.2; }
  .intro { margin-bottom: 24px; color: #29415b; font-size: 18px; line-height: 1.6; }
  .back-link { display: inline-block; margin-top: 20px; color: #0e2f60; text-decoration: underline; text-underline-offset: 3px; }
  .back-link:focus-visible { outline: 3px solid #c4a35a; outline-offset: 4px; }
</style>