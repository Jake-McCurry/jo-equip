---
import Layout from "@/layouts/Layout.astro";
import PersonaPage from "@/components/PersonaPage.astro";
---
<Layout
  title="Missionary Resources - Free Training, Discipleship & Ministry Resources | JO EQUIP"
  description="Explore free missionary resources for training, discipleship, Bible study, leadership, church planting, and disciple making across cultures and among the unreached."
>
  <PersonaPage
    heading="Helping Missionaries Multiply Disciples Among the Nations"
    intro={[
      "<strong style=\"color:#0b3c5d;\">JO EQUIP</strong> provides missionaries with free, transformational resources designed to help form mature, Christlike disciples across cultures and among the unreached.",
      "These practical tools support those serving on the field by offering a clear framework for spiritual growth that produces genuine heart change rather than mere transfer of knowledge\u2014equipping local believers and teams to live as disciples who make disciples.",
      "All resources are available at no cost and are crafted for easy sharing, translation readiness, and lasting Kingdom impact in challenging and diverse contexts.",
    ]}
    articles={[
      {
        title: "Total Life Discipleship",
        text: "Holistic discipleship with a Kingdom perspective that leads to lasting transformation and eternal impact among the nations.",
        href: "/categories/church/become-growing-church/a-total-life-discipleship-church",
      },
      {
        title: "Empowered for Supernatural Living",
        text: "Practical guidance for depending on the Holy Spirit\u2019s presence and power in the midst of caregiving and personal ministry.",
        href: "/categories/growth/ministry-holy-spirit/empowered-for-supernatural-living",
      },
      {
        title: "Embracing Your New Identity in Christ",
        text: "Helping people rediscover who they are as children of God, saints with a new nature, and citizens of His Kingdom\u2014especially when circumstances seek to redefine them.",
        href: "/categories/growth/identity-in-christ/embracing-your-new-identity-in-christ",
      },
    ]}
    booksNote="Free PDF downloads suitable for personal reading, team equipping, local leader training, or distribution in field settings."
    bookIds={[
      "adventure-of-living-with-jesus",
      "who-is-the-real-jesus",
      "extraordinary-evangelism",
      "extraordinary-evangelism-student-guide",
      "your-new-identity-in-christ",
      "walking-in-the-spirit",
      "the-abiding-room",
    ]}
    topics={[
      { name: "Making & Multiplying Disciples", href: "/categories/church" },
      { name: "Total Life Discipleship", href: "/categories/church/total-life-discipleship-principles" },
      { name: "Disciple Making Movement", href: "/categories/church/disciple-making-movement" },
      { name: "Rapid Church Planting", href: "/categories/church/rapid-church-planting" },
      { name: "Share Jesus / Extraordinary Evangelism", href: "/categories/church/share-jesus" },
      { name: "Walking in the Spirit", href: "/categories/growth/ministry-holy-spirit" },
      { name: "Your Identity in Christ", href: "/categories/growth/identity-in-christ" },
      { name: "Hope in Times of Crisis", href: "/categories/growth/hope-times-crisis" },
    ]}
    playlistsNote="Video series suitable for team training, local leader development, personal equipping, or sharing with emerging disciples on the field."
    playlistIds={[
      "who-is-the-real-jesus",
      "total-life-discipleship-core-principles",
      "total-life-discipleship-kingdom-perspective",
      "life-in-the-spirit",
      "facts-for-faith",
      "hope-in-times-of-crisis",
    ]}
    closing={[
      "All resources are free and designed to guide people from basic faith to secure identity in Christ, Spirit-empowered living, and fruitful multiplication\u2014enabling missionaries and local disciples to advance the Great Commission among the nations.",
      "These tools strengthen those who serve cross-culturally, cultivating resilient workers and multiplying communities where every believer is equipped to walk with Jesus and to help others do the same.",
    ]}
  />
</Layout>
