---
import Layout from "@/layouts/Layout.astro";
import PersonaPage from "@/components/PersonaPage.astro";
import PersonaPageLd from "@/components/PersonaPageLd.astro";

const description = "Explore free missionary resources for discipleship, training and church planting, with practical books, videos and ministry tools to equip and multiply disciples.";
---
<Layout
  title="Missionary Resources for Discipleship & Training | JO EQUIP"
  description={description}
>
  <PersonaPageLd slot="head" pageName="Missionaries" pageUrl="https://equip.jesusonline.com/missionaries" pageDescription={description} />
  <PersonaPage
    heading="Helping Missionaries Multiply Disciples Among the Nations"
    intro={[
      "<strong style=\"color:var(--color-text);\">JO EQUIP</strong> provides missionaries with free, transformational resources designed to help form mature, Christlike disciples across cultures and among the unreached.",
      "These practical tools support those serving on the field by offering a clear framework for spiritual growth that produces genuine heart change rather than mere transfer of knowledge\u2014equipping local believers and teams to live as disciples who make disciples.",
      "All resources are available at no cost and are crafted for easy sharing, translation readiness, and lasting Kingdom impact in challenging and diverse contexts.",
    ]}
    articles={[
      {
        title: "Total Life Discipleship",
        text: "Holistic discipleship with a Kingdom perspective that leads to lasting transformation and eternal impact among the nations.",
        href: "/categories/church/become-growing-church/a-total-life-discipleship-church",
      },
      {
        title: "Empowered for Supernatural Living",
        text: "Practical guidance for depending on the Holy Spirit\u2019s presence and power in the midst of caregiving and personal ministry.",
        href: "/categories/growth/ministry-holy-spirit/empowered-for-supernatural-living",
      },
      {
        title: "Embracing Your New Identity in Christ",
        text: "Helping people rediscover who they are as children of God, saints with a new nature, and citizens of His Kingdom\u2014especially when circumstances seek to redefine them.",
        href: "/categories/growth/identity-in-christ/embracing-your-new-identity-in-christ",
      },
    ]}
    booksNote="Free PDF downloads suitable for personal reading, team equipping, local leader training, or distribution in field settings."
    bookIds={[
      "adventure-of-living-with-jesus",
      "who-is-the-real-jesus",
      "extraordinary-evangelism",
      "extraordinary-evangelism-student-guide",
      "your-new-identity-in-christ",
      "walking-in-the-spirit",
      "the-abiding-room",
    ]}
    topics={[
      { name: "Making & Multiplying Disciples", href: "/categories/church" },
      { name: "Total Life Discipleship", href: "/categories/church/total-life-discipleship-principles" },
      { name: "Disciple Making Movement", href: "/categories/church/disciple-making-movement" },
      { name: "Rapid Church Planting", href: "/categories/church/rapid-church-planting" },
      { name: "Share Jesus / Extraordinary Evangelism", href: "/categories/church/share-jesus" },
      { name: "Walking in the Spirit", href: "/categories/growth/ministry-holy-spirit" },
      { name: "Your Identity in Christ", href: "/categories/growth/identity-in-christ" },
      { name: "Hope in Times of Crisis", href: "/categories/growth/hope-times-crisis" },
    ]}
    playlistsNote="Video series suitable for team training, local leader development, personal equipping, or sharing with emerging disciples on the field."
    playlistIds={[
      "who-is-the-real-jesus",
      "total-life-discipleship-core-principles",
      "total-life-discipleship-kingdom-perspective",
      "life-in-the-spirit",
      "facts-for-faith",
      "hope-in-times-of-crisis",
    ]}
    closing={[
      "All resources are free and designed to guide people from basic faith to secure identity in Christ, Spirit-empowered living, and fruitful multiplication\u2014enabling missionaries and local disciples to advance the Great Commission among the nations.",
      "These tools strengthen those who serve cross-culturally, cultivating resilient workers and multiplying communities where every believer is equipped to walk with Jesus and to help others do the same.",
    ]}
    faqIntro="Answers to common questions about free Christian resources for missionaries, field ministry, and making disciples."
    faqLinks={[
      { sentence: "Disciple Making Movement", text: "Disciple Making Movement", href: "/categories/church/disciple-making-movement" },
      { sentence: "Rapid Church Planting", text: "Rapid Church Planting", href: "/categories/church/rapid-church-planting" },
      { sentence: "Making & Multiplying Disciples collection", text: "Making & Multiplying Disciples collection", href: "/categories/church" },
    ]}
    faqs={[
      {
        question: "Where can missionaries find free Christian ministry resources?",
        answer: [
          "Missionaries can find free Christian resources through JO EQUIP, the ministry resource hub from JesusOnline Ministries. Its library includes practical articles, books, topic collections, and video playlists for personal equipping, evangelism, discipleship, and local leader development.",
          "Resources such as The Adventure of Living with Jesus, Who Is the Real Jesus?, Extraordinary Evangelism, and Total Life Discipleship can help missionaries share the gospel and guide believers toward maturity in Christ.",
        ],
      },
      {
        question: "What ministry resources can missionaries use on the field?",
        answer: [
          "Missionaries can use JO EQUIP articles, books, and videos for personal study, team discussions, local leader development, and conversations with emerging disciples. Total Life Discipleship offers a holistic, Kingdom-centered perspective, while Extraordinary Evangelism provides practical guidance for sharing the gospel.",
          "Choose materials that fit the local language, culture, literacy level, and available technology. Adapt how you teach and share them with input from local believers, and follow relevant permissions and local requirements when translating or distributing resources.",
        ],
      },
      {
        question: "What resources can support missionary preparation and team training?",
        answer: [
          "Walking in the Spirit, Empowered for Supernatural Living, The Abiding Room, and Total Life Discipleship can support biblical preparation, personal discipleship, and team reflection. Extraordinary Evangelism can also help missionaries prepare to share the gospel and equip others.",
          "These resources supplement ministry preparation; they are not a comprehensive missionary training program. Missionaries should also seek appropriate cross-cultural, language, security, and role-specific training through their sending organization or qualified providers.",
        ],
      },
      {
        question: "What discipleship resources can missionaries use to help new believers grow?",
        answer: [
          "The Adventure of Living with Jesus and Who Is the Real Jesus? can support conversations about Jesus and the foundations of Christian faith. Your New Identity in Christ and Walking in the Spirit help believers explore their identity in Christ and dependence on the Holy Spirit.",
          "Total Life Discipleship and the Making & Multiplying Disciples collection provide further materials for guiding believers toward spiritual maturity. Use relevant resources alongside Scripture, prayer, personal relationships, and opportunities to put faith into practice.",
        ],
      },
      {
        question: "What resources can help missionaries make and multiply disciples?",
        answer: [
          "Missionaries can explore JO EQUIP's Making & Multiplying Disciples collection for articles and topics on discipleship and ministry. Disciple Making Movement and Rapid Church Planting provide additional guidance for developing disciples, equipping local leaders, and establishing communities of believers.",
          "These collections can support thoughtful discussion and planning with local believers. Apply their guidance in ways that respect the local context and nurture faithful, mature disciples rather than treating multiplication as a guaranteed outcome.",
        ],
      },
      {
        question: "What resources can missionaries use for personal spiritual growth and maturity?",
        answer: [
          "The Abiding Room, Walking in the Spirit, Your New Identity in Christ, and Total Life Discipleship offer biblical guidance on abiding in Christ, depending on the Holy Spirit, understanding identity in Christ, and growing toward maturity.",
          "Missionaries can use these resources for personal reflection, prayer, or study with trusted teammates and local believers. They can complement ongoing fellowship, pastoral support, and a daily walk with Jesus.",
        ],
      },
    ]}
  />
</Layout>
