---
import Layout from "@/layouts/Layout.astro";
import { Users2, BookOpen, Mail, ExternalLink, ArrowRight, Send, Hand } from "lucide-react";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

interface Section {
  title: string;
  icon: any;
  description: string;
  href: string;
  accent: string;
  external?: boolean;
}

const SECTIONS: Section[] = [
  {
    title: "Tour JO Equip",
    icon: Hand,
    description: "New to JO EQUIP? Start here for an introduction to the Ministry Resources Hub.",
    href: "/tour",
    accent: "var(--color-accent)",
  },
  {
    title: "About",
    icon: Users2,
    description: "Learn about JesusOnline Ministries — our mission, beliefs, strategy, history, and reviews.",
    href: "/about",
    accent: "var(--color-brand)",
  },
  {
    title: "Newsletter",
    icon: Send,
    description: "Subscribe to the Make and Multiply Disciples newsletter for updates and new resources.",
    href: "/newsletter",
    accent: "var(--color-brand)",
  },
  {
    title: "Knowing God / Topical Concordance",
    icon: BookOpen,
    description: "Explore the Knowing God Topical Bible and its biblical guide to the nature and character of God.",
    href: "/knowing-god",
    accent: "#0f4c5c",
  },
  {
    title: "JO App",
    icon: ExternalLink,
    description: "Access the JesusOnline web app: Grow in Christ, anywhere, anytime.",
    href: "https://app.jesusonline.com",
    accent: "#2E7D32",
    external: true,
  },
  {
    title: "Contact",
    icon: Mail,
    description: "Email us directly at equip@jesusonline.com with comments or questions.",
    href: "mailto:equip@jesusonline.com",
    accent: "var(--color-accent)",
    external: true,
  },
];
---
<Layout
  title="About Us and More Resources | JO EQUIP"
  description="Tour JO EQUIP, learn about our ministry, subscribe to the newsletter, explore Knowing God and the JO App, or contact our team."
>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "More", url: "/more" },
    ]} />
  </Fragment>
  <div class="container mx-auto px-4 py-7 md:py-10">
    <div class="max-w-3xl mb-7 md:mb-8">
      <div class="text-xs font-semibold tracking-widest uppercase mb-1.5" style="color:var(--color-hero);">More</div>
      <h1 class="text-3xl md:text-4xl mb-2" style="color:var(--color-structure);">About Us and More Resources</h1>
      <div class="h-0.5 w-12 mb-3" style="background-color:var(--color-accent);"></div>
      <p class="leading-snug text-base" style="color:var(--color-muted-foreground);">
        Information about JesusOnline Ministries, our beliefs, and how to get in touch.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2.5 md:gap-3">
      {SECTIONS.map(s => {
        const Icon = s.icon;
        const href = s.external ? s.href : join(s.href);
        return (
          <a
            href={href}
            target={s.external ? "_blank" : undefined}
            rel={s.external ? "noopener noreferrer" : undefined}
            class="group flex min-h-16 items-center gap-3 bg-white border rounded px-4 py-3 hover:shadow-md transition-all"
            style={`border-color:var(--color-border);border-left:4px solid ${s.accent};`}
          >
            <div class="w-9 h-9 rounded flex items-center justify-center shrink-0" style={`background-color:${s.accent}15;`}>
              <Icon className="w-4.5 h-4.5" style={{ color: s.accent }} />
            </div>
            <h2 class="flex-1 text-base font-semibold leading-tight group-hover:text-primary transition-colors" style="color:var(--color-text);">{s.title}</h2>
            <span class="inline-flex shrink-0 items-center text-sm font-medium" style={`color:${s.accent};`}>
              {s.external ? (<>Open <ExternalLink className="w-4 h-4 ml-1" /></>) : (<>Open <ArrowRight className="w-4 h-4 ml-1" /></>)}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
