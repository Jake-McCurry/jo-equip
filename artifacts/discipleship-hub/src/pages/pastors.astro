---
import Layout from "@/layouts/Layout.astro";
import PersonaPage from "@/components/PersonaPage.astro";
---
<Layout
  title="Free Discipleship Resources for Pastors | JO EQUIP"
  description="JO EQUIP provides pastors with free, transformational resources — articles, books, topics, and video playlists — designed to help form mature, Christlike disciples."
>
  <PersonaPage
    heading="Helping Pastors Cultivate Mature Disciples"
    intro={[
      "<strong style=\"color:#0b3c5d;\">JO EQUIP</strong> provides pastors with free, transformational resources designed to help form mature, Christlike disciples.",
      "We offer a clear framework and practical tools that foster lasting spiritual growth\u2014enabling genuine heart change rather than the mere transfer of knowledge.",
      "JO EQUIP provides free ministry resources to help pastors make and multiply disciples for lasting impact, available at no cost.",
    ]}
    articles={[
      {
        title: "God's Unique Vision for Your Church",
        text: "It fits your people perfectly and releases fresh growth, life, and lasting Kingdom impact.",
        href: "/channels/church/become-growing-church/gods-unique-vision-for-your-church",
      },
      {
        title: "JO Equipped Church",
        text: "Use JO EQUIP\u2019s videos, articles, and the JO App to save time and promote lasting transformation.",
        href: "/channels/church/become-growing-church/a-jesusonline-equipped-church",
      },
      {
        title: "Total Life Discipleship Church",
        text: "Holistic discipleship with a kingdom perspective leading to eternal impact.",
        href: "/channels/church/become-growing-church/a-total-life-discipleship-church",
      },
    ]}
    booksNote="Free PDF downloads suitable for personal reading, leadership teams, or distribution."
    bookIds={[
      "adventure-of-living-with-jesus",
      "who-is-the-real-jesus",
      "walking-in-the-spirit",
      "extraordinary-evangelism",
      "extraordinary-evangelism-student-guide",
      "your-new-identity-in-christ",
      "5-steps-to-break-destructive-behavior",
    ]}
    topics={[
      { name: "Become a Growing Church", href: "/channels/church/become-growing-church" },
      { name: "Walking in the Spirit", href: "/channels/growth/ministry-holy-spirit" },
      { name: "Your Identity in Christ", href: "/channels/growth/identity-in-christ" },
      { name: "Attributes of God", href: "/channels/growth/attributes-of-god" },
      { name: "Building Blocks for Maturity", href: "/channels/growth/building-blocks" },
      { name: "Hope in Times of Crisis", href: "/channels/growth/hope-times-crisis" },
      { name: "Biblical Counseling Insights", href: "/channels/church/biblical-counseling-insights" },
    ]}
    playlistsNote="Video series for sermon series starters, small groups, or personal equipping."
    playlistIds={[
      "who-is-the-real-jesus",
      "total-life-discipleship-core-principles",
      "total-life-discipleship-kingdom-perspective",
      "life-in-the-spirit",
      "7-habits-deeper-relationship-with-god",
      "hope-in-times-of-crisis",
    ]}
    closing={[
      "All resources are free and designed to guide people from basic faith to secure identity, Spirit-empowered living, and fruitful multiplication.",
    ]}
  />
</Layout>
