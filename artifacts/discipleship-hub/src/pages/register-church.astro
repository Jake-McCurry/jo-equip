---
import Layout from "@/layouts/Layout.astro";
import { Church } from "lucide-react";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";

/* JO Equipped Church registration — Mailchimp audience jesusonline.us1
 * (same audience as the newsletter but a distinct form: f_id=00bf87e5f0).
 * Submits via Mailchimp's JSONP endpoint so we can confirm the signup
 * succeeded before redirecting to the dedicated thank-you page. */
const MC_POST_JSON =
  "https://jesusonline.us1.list-manage.com/subscribe/post-json?u=c02949f5de137184b156da9bc&id=e06ba0649d&f_id=00bf87e5f0";
const MC_HONEYPOT = "b_c02949f5de137184b156da9bc_e06ba0649d";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;
const THANK_YOU = join("/register-church-thank-you");
---
<Layout
  title="Register Your Church · JO EQUIP"
  description="Register today to become a FREE JO Equipped Church — free, unrestricted access to the JO EQUIP library of practical, biblically grounded discipleship tools."
>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "Register Your Church", url: "/register-church" },
    ]} />
  </Fragment>

  <section class="bg-white">
    <div class="container mx-auto px-4 py-14 md:py-20 max-w-2xl">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-6" style="background-color:rgba(122,58,138,0.1);color:#6B2D7B;">
          <Church className="w-3.5 h-3.5" />
          JO Equipped Church
        </div>
        <h1 class="text-3xl md:text-4xl mb-4" style="color:#0b3c5d;">
          Become a Free JO&nbsp;Equipped Church
        </h1>
        <div class="h-0.5 w-12 mx-auto mb-8" style="background-color:#de5b00;"></div>
      </div>

      <div class="space-y-5 text-lg leading-relaxed mb-10" style="color:#374151;">
        <p>
          Register your church for free, unrestricted access to the full JO EQUIP library of
          practical discipleship tools.
        </p>
        <p class="text-base" style="color:var(--color-muted-foreground);">
          Completely free. No obligation. We respect your privacy and will only use your
          information to provide these resources.
        </p>
      </div>

      <div
        class="bg-white border rounded p-6 md:p-8"
        style="border-color:var(--color-border);border-top:4px solid #6B2D7B;"
      >
        <form id="rc-form" class="space-y-4" novalidate>

          <div>
            <label for="rc-email" class="block text-sm font-medium mb-1.5" style="color:#0b3c5d;">
              Email <span style="color:#de5b00;">*</span>
            </label>
            <input
              type="email"
              name="EMAIL"
              id="rc-email"
              required
              autocomplete="email"
              class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
              style="border-color:var(--color-border);color:#0b3c5d;"
            />
          </div>

          <div>
            <label for="rc-fname" class="block text-sm font-medium mb-1.5" style="color:#0b3c5d;">
              First Name <span style="color:#de5b00;">*</span>
            </label>
            <input
              type="text"
              name="FNAME"
              id="rc-fname"
              required
              autocomplete="given-name"
              class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
              style="border-color:var(--color-border);color:#0b3c5d;"
            />
          </div>

          <div>
            <label for="rc-church" class="block text-sm font-medium mb-1.5" style="color:#0b3c5d;">
              Church <span style="color:#de5b00;">*</span>
            </label>
            <input
              type="text"
              name="CHURCH"
              id="rc-church"
              required
              autocomplete="organization"
              class="w-full rounded border px-3 py-2.5 text-sm outline-none focus-visible:ring-2"
              style="border-color:var(--color-border);color:#0b3c5d;"
            />
          </div>

          {/* COUNTRY is reported automatically from the visitor's IP (Cloudflare
              geolocation via /api/geo) — no visible field. Empty if unavailable. */}
          <input type="hidden" name="COUNTRY" id="rc-country" value="" />

          {/* Mailchimp audience tag (from the provided embed code) */}
          <input type="hidden" name="tags" value="5798233" />

          {/* Bot-prevention honeypot — do not remove */}
          <div aria-hidden="true" style="position:absolute;left:-5000px;">
            <input type="text" name={MC_HONEYPOT} tabindex="-1" value="" />
          </div>

          <p id="rc-error" class="hidden text-sm font-medium" style="color:#b91c1c;" role="alert"></p>

          <button
            type="submit"
            id="rc-submit"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded font-semibold text-sm transition-all hover:shadow-md"
            style="background-color:#6B2D7B;color:#ffffff;"
          >
            Register My Church Free
          </button>
        </form>
      </div>
    </div>
  </section>

  <script define:vars={{ MC_POST_JSON, THANK_YOU }}>
    const form = document.getElementById("rc-form");

    /* Fill hidden COUNTRY from the visitor's IP (Cloudflare geolocation).
     * Only works on the live site (the Worker serves /api/geo); anywhere
     * else this fails silently and COUNTRY is submitted empty. */
    (async () => {
      try {
        const res = await fetch("/api/geo", { signal: AbortSignal.timeout(4000) });
        if (!res.ok) return;
        const { country } = await res.json();
        if (!country) return;
        let name = country;
        try {
          name = new Intl.DisplayNames(["en"], { type: "region" }).of(country) || country;
        } catch {}
        document.getElementById("rc-country").value = name;
      } catch {}
    })();
    const submitBtn = document.getElementById("rc-submit");
    const errorEl = document.getElementById("rc-error");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");

      if (!form.reportValidity()) return;

      submitBtn.disabled = true;
      submitBtn.style.opacity = "0.6";

      /* Mailchimp only accepts cross-origin signups via JSONP. */
      const params = new URLSearchParams(new FormData(form));
      const cb = "rcMailchimpCb" + Date.now();
      const script = document.createElement("script");
      let settled = false;

      function finish() {
        settled = true;
        delete window[cb];
        script.remove();
        submitBtn.disabled = false;
        submitBtn.style.opacity = "";
      }

      window[cb] = (res) => {
        finish();
        if (res && res.result === "success") {
          form.reset();
          // Send the newly registered church to the dedicated thank-you page.
          window.location.href = THANK_YOU;
        } else {
          const msg = (res && res.msg ? String(res.msg) : "Something went wrong. Please try again.")
            .replace(/<[^>]*>/g, "")
            .replace(/^\d+\s*-\s*/, "");
          errorEl.textContent = msg;
          errorEl.classList.remove("hidden");
        }
      };

      script.src = MC_POST_JSON + "&" + params.toString() + "&c=" + cb;
      script.onerror = () => {
        if (settled) return;
        finish();
        errorEl.textContent = "Something went wrong. Please check your connection and try again.";
        errorEl.classList.remove("hidden");
      };
      document.body.appendChild(script);
    });
  </script>
</Layout>
