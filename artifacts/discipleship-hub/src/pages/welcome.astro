---
import Layout from "@/layouts/Layout.astro";
import { Picture, Image } from "astro:assets";
import { ArrowRight, Users2, BookOpen, Smartphone, Star } from "lucide-react";
import { channels } from "@/data/channels";
import { playlists } from "@/data/playlists";
import { books } from "@/data/books";
import { getBookCover } from "@/data/bookCovers";
import evidenceImg from "@/assets/channels/evidence.jpg";
import growthImg from "@/assets/channels/growth.jpg";
import churchImg from "@/assets/channels/church.jpg";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

/* Welcome page — July 2026 revision: reuses the ad landing-page layout
   (/lp/ENG-1-resources) with the blue campaign banner replaced by the
   "Welcome" heading + intro copy. Linked from the top menu ("Welcome");
   the logo continues to link to the home page (/). */

/* "What Do You Need Most Right Now?" — the four indexable destination pages. */
const needs = [
  { lead: "Discipleship Resources", rest: "to help believers mature in Christ", href: join("/discipleship-resources") },
  { lead: "Church Growth", rest: "strategies to build a thriving church", href: join("/church-strategies") },
  { lead: "Sermon Helps", rest: "with practical teaching aids and message outlines", href: join("/sermon-helps") },
  { lead: "Evangelism Tools", rest: "to reach skeptics and seekers for Jesus", href: join("/evangelism-tools") },
];

const channelImages: Record<string, ImageMetadata> = {
  evidence: evidenceImg,
  growth: growthImg,
  church: churchImg,
};
const channelBlurbs: Record<string, { lead: string; rest: string }> = {
  evidence: { lead: "Evidence Resources", rest: "– to help you reach skeptics and seekers with solid reasons to believe" },
  growth: { lead: "Growth Resources", rest: "– to provide you with transformational teaching content for sermons and bible studies to help your members grow" },
  church: { lead: "Church Resources", rest: "– to equip you personally with tools and concepts that are foundational for a healthy and vibrant church life" },
};

/* Featured playlists — thumbnail = playlist's thumbnailVideoId or first video. */
const featuredPlaylistIds = [
  "hope-in-times-of-crisis",
  "7-habits-deeper-relationship-with-god",
  "experience-gods-love",
];
const featuredPlaylists = featuredPlaylistIds.map(id => {
  const p = playlists.find(pl => pl.id === id);
  if (!p) throw new Error(`Welcome: unknown playlist id ${id}`);
  const thumb = (p as { thumbnailVideoId?: string }).thumbnailVideoId ?? p.videos[0]?.videoId;
  return { id: p.id, title: p.title, thumb };
});

/* Featured books — covers link to each book's detail page. */
const featuredBookIds = [
  "walking-in-the-spirit",
  "5-steps-to-break-destructive-behavior",
  "extraordinary-evangelism",
];
const featuredBooks = featuredBookIds.map(id => {
  const b = books.find(bk => bk.id === id);
  if (!b) throw new Error(`Welcome: unknown book id ${id}`);
  return { id: b.id, title: b.title, cover: getBookCover(b.id) };
});

const quickLinks = [
  { title: "Reviews", subtitle: "From Pastors and Leaders", href: join("/reviews"), icon: Star, external: false },
  { title: "About", subtitle: "JesusOnline Ministries", href: join("/about"), icon: Users2, external: false },
  { title: "Beliefs", subtitle: "Statement of Faith", href: join("/beliefs"), icon: BookOpen, external: false },
  { title: "JO APP", subtitle: "Growing in Christ", href: "https://app.jesusonline.com", icon: Smartphone, external: true },
];
---
<Layout
  title="Welcome | JO EQUIP"
  description="Welcome to JO EQUIP — a free digital library of practical discipleship tools to equip pastors and ministry leaders for greater ministry impact."
>
  {/* Welcome banner — replaces the LP's blue campaign hero. */}
  <section class="bg-white">
    <div class="container mx-auto px-4 py-12 md:py-16 max-w-4xl">
      <h1 class="text-4xl md:text-5xl mb-4" style="color:#0b3c5d;">Welcome</h1>
      <div class="h-0.5 w-12 mb-7" style="background-color:#de5b00;"></div>
      <p class="text-lg leading-relaxed" style="color:#374151;">
        Welcome to <strong style="color:#0b3c5d;">JO EQUIP</strong> — a free digital library of practical
        discipleship tools created specifically to help better equip pastors and ministry leaders for a greater
        ministry impact and fruitful discipleship multiplication.
      </p>
    </div>
  </section>

  {/* What Do You Need Most Right Now? */}
  <section class="py-10 md:py-14" style="background-color:#e6f2fa;">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-semibold mb-6 text-center" style="color:#0b3c5d;">What Do You Need Most Right Now?</h2>
      <ul class="flex flex-col gap-3">
        {needs.map(n => (
          <li>
            <a href={n.href} class="group flex items-center justify-between gap-4 bg-white border rounded px-5 py-4 transition-all hover:shadow-md" style="border-color:var(--color-border);border-left:4px solid #de5b00;">
              <span class="text-[15px] md:text-base leading-snug" style="color:#0b3c5d;">
                <strong class="font-semibold group-hover:underline" style="color:#de5b00;">{n.lead}</strong>{" "}{n.rest}
              </span>
              <ArrowRight className="w-5 h-5 shrink-0 transition-transform group-hover:translate-x-1" style={{ color: "#de5b00" }} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Pastors & Leaders Love JO EQUIP */}
  <section class="py-10 md:py-14 bg-white">
    <div class="container mx-auto px-4 max-w-3xl text-center">
      <h2 class="text-2xl md:text-3xl font-semibold mb-4" style="color:#0b3c5d;">Pastors &amp; Leaders Love JO EQUIP</h2>
      <p class="text-[15px] md:text-base leading-relaxed" style="color:var(--color-muted-foreground);">
        For 20 years, JesusOnline Ministries has provided resources to pastors of evangelical Christian churches, small group leaders, and missionaries.
        <a href={join("/reviews")} class="inline-flex items-center gap-1 hover:underline" style="color:#de5b00;">
          Read the reviews here<ArrowRight className="w-4 h-4" />
        </a>
      </p>
    </div>
  </section>

  {/* Explore 3 Ministry Categories */}
  <section class="py-10 md:py-14" style="background-color:#e6f2fa;">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-semibold mb-6 text-center" style="color:#0b3c5d;">Explore 3 Ministry Categories</h2>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-md sm:max-w-lg lg:max-w-none mx-auto">
        {channels.map(channel => (
          <a href={join(`/categories/${channel.id}`)} class="group flex flex-col bg-white border rounded overflow-hidden hover:shadow-lg transition-all" style={`border-color:var(--color-border);border-top:6px solid ${channel.accentColor};`}>
            <div class="relative aspect-[5/2] overflow-hidden">
              <Picture
                src={channelImages[channel.id]}
                alt={channel.name}
                widths={[480, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 512px, 100vw"
                formats={["avif", "webp"]}
                quality={75}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </div>
            <div class="p-5 flex items-start justify-between gap-3 flex-grow">
              <p class="text-[15px] leading-snug" style="color:#0b3c5d;">
                <strong class="font-semibold group-hover:underline" style={`color:${channel.accentColor};`}>{channelBlurbs[channel.id].lead}</strong>{" "}
                <span style="color:var(--color-muted-foreground);">{channelBlurbs[channel.id].rest}</span>
              </p>
              <ArrowRight className="w-5 h-5 shrink-0 mt-0.5 transition-transform group-hover:translate-x-1" style={{ color: channel.accentColor }} />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Watch Encouraging Video Playlists */}
  <section class="py-10 md:py-14 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-semibold mb-6 text-center" style="color:#0b3c5d;">Watch Encouraging Video Playlists</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-md sm:max-w-4xl mx-auto">
        {featuredPlaylists.map(p => (
          <a href={join(`/playlist/${p.id}`)} class="group flex flex-col border rounded overflow-hidden hover:shadow-lg transition-all" style="border-color:var(--color-border);">
            <div class="relative aspect-video overflow-hidden" style="background-color:#0b3c5d;">
              <img
                src={`https://i.ytimg.com/vi/${p.thumb}/hqdefault.jpg`}
                alt={`${p.title} playlist`}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </div>
            <div class="p-4 flex items-center justify-between gap-3">
              <span class="text-[15px] font-semibold leading-snug group-hover:underline" style="color:#0b3c5d;">{p.title}</span>
              <ArrowRight className="w-5 h-5 shrink-0" style={{ color: "#de5b00" }} />
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-7">
        <a href={join("/playlists")} class="inline-flex items-center gap-1.5 font-semibold text-white rounded px-6 py-3 transition-opacity hover:opacity-90" style="background-color:#0083de;">
          See all Playlists<ArrowRight className="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  {/* Download Free Ministry Books */}
  <section class="py-10 md:py-14" style="background-color:#e6f2fa;">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-semibold mb-6 text-center" style="color:#0b3c5d;">Download Free Ministry Books</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-md sm:max-w-4xl mx-auto">
        {featuredBooks.map(b => (
          <a href={join(`/books/${b.id}`)} class="group flex flex-col items-center bg-white border rounded p-6 hover:shadow-lg transition-all" style="border-color:var(--color-border);">
            {b.cover && (
              <Image
                src={b.cover}
                alt={`${b.title} book cover`}
                widths={[240, 480]}
                sizes="240px"
                format="webp"
                quality={80}
                class="h-56 w-auto rounded shadow-md transition-transform duration-300 group-hover:scale-[1.03]"
                loading="lazy"
              />
            )}
            <span class="mt-4 inline-flex items-center gap-1.5 text-[15px] font-semibold text-center leading-snug group-hover:underline" style="color:#0b3c5d;">
              {b.title}<ArrowRight className="w-4 h-4 shrink-0" style={{ color: "#de5b00" }} />
            </span>
          </a>
        ))}
      </div>
      <div class="text-center mt-7">
        <a href={join("/books")} class="inline-flex items-center gap-1.5 font-semibold text-white rounded px-6 py-3 transition-opacity hover:opacity-90" style="background-color:#0083de;">
          See all Books<ArrowRight className="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  {/* Quick links — Reviews · About · Beliefs · JO APP */}
  <section style="background-color:#0083de;">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 divide-white/15 sm:gap-y-px lg:divide-x lg:divide-white/15">
        {quickLinks.map(link => {
          const Icon = link.icon;
          return (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="group flex items-center justify-start lg:justify-center gap-4 py-5 px-6 transition-colors hover:bg-white/5"
            >
              <div class="w-11 h-11 rounded shrink-0 flex items-center justify-center" style="background-color:rgba(255,255,255,0.18);">
                <Icon className="w-5 h-5" style={{ color: "#ffffff" }} />
              </div>
              <div class="text-left">
                <div class="text-lg md:text-xl font-semibold text-white leading-tight tracking-wide group-hover:underline" style='font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'>{link.title}</div>
                <div class="text-[11px] mt-1 font-medium tracking-widest uppercase" style="color:rgba(255,255,255,0.8);">{link.subtitle}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
