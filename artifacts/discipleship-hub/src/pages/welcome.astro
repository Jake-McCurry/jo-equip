---
import Layout from "@/layouts/Layout.astro";
import { Picture } from "astro:assets";
import { channels, subTopics } from "@/data/channels";
import { ArrowRight } from "lucide-react";
import BreadcrumbsLd from "@/components/BreadcrumbsLd.astro";
import evidenceImg from "@/assets/channels/evidence.jpg";
import growthImg from "@/assets/channels/growth.jpg";
import churchImg from "@/assets/channels/church.jpg";

const baseUrl = import.meta.env.BASE_URL;
const join = (p: string) =>
  (baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl) + p;

const channelImages: Record<string, ImageMetadata> = {
  evidence: evidenceImg,
  growth: growthImg,
  church: churchImg,
};

const channelImageAlts: Record<string, string> = {
  evidence: "A gavel and scales of justice resting on old books",
  growth: "Hands holding an open Bible",
  church: "A congregation seated in church pews",
};

/* Top-level topic counts per channel (children with parentId are hidden from
   the channel index, so they don't count). */
const topicCounts: Record<string, number> = {};
for (const s of subTopics) {
  if (!s.parentId) topicCounts[s.channelId] = (topicCounts[s.channelId] ?? 0) + 1;
}

const reviewLinks = [
  { label: "General Testimonials", hash: "#general" },
  { label: "Evidence for Faith Reviews", hash: "#evidence" },
  { label: "Discipleship & Growth Reviews", hash: "#growth" },
  { label: "Church Equipping Reviews", hash: "#church" },
];
---
<Layout
  title="Welcome · JO EQUIP"
  description="Welcome to JO EQUIP — a free digital library of discipleship tools across three channels: Evidence, Growth, and Church Resources."
>
  <Fragment slot="head">
    <BreadcrumbsLd items={[
      { name: "Home", url: "/" },
      { name: "Welcome", url: "/welcome" },
    ]} />
  </Fragment>

  <section class="bg-white">
    <div class="container mx-auto px-4 py-14 md:py-20 max-w-4xl">
      <div class="text-xs font-semibold tracking-widest uppercase mb-3" style="color:#0083de;">JO EQUIP</div>
      <h1 class="text-4xl md:text-5xl mb-4" style="color:#002f55;">Welcome</h1>
      <div class="h-0.5 w-12 mb-7" style="background-color:#de5b00;"></div>
      <div class="space-y-5 text-lg leading-relaxed" style="color:#374151;">
        <p>
          Welcome to <strong style="color:#002f55;">JO EQUIP</strong> — a free digital library of practical
          discipleship tools created specifically to help better equip pastors and ministry leaders for a greater
          ministry impact and fruitful discipleship multiplication.
        </p>
        <p>
          If you are a disciple-maker passionate about seeing God's Kingdom expand through spiritual multiplication,
          JO EQUIP is your free, trusted resource to help you strengthen His Church and advance His Kingdom.
        </p>
        <p>
          These carefully selected resources, grouped in the following channels, are designed to help you serve with
          greater effectiveness and spiritual vitality in fulfilling Christ's Great Commission.
        </p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 border-t" style="background-color:#f4f7fb;border-color:var(--color-border);">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl" style="color:#002f55;">3 Channels for Your Ministry Needs</h2>
        <div class="mt-2 h-0.5 w-12 mx-auto" style="background-color:#de5b00;"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-md sm:max-w-lg lg:max-w-none mx-auto">
        {channels.map(channel => (
          <a
            href={join(`/channels/${channel.id}`)}
            class="group flex flex-col bg-white border rounded overflow-hidden hover:shadow-lg transition-all"
            style="border-color:var(--color-border);"
          >
            <div style={`height:8px;background-color:${channel.accentColor};`}></div>
            <div class="relative aspect-[5/2] overflow-hidden">
              <Picture
                src={channelImages[channel.id]}
                alt={channelImageAlts[channel.id]}
                widths={[480, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 512px, 100vw"
                formats={["avif", "webp"]}
                quality={75}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </div>
            <div style={`height:4px;background-color:${channel.accentColor};`}></div>
            <div class="p-6 md:p-7 flex flex-col flex-grow">
              <h3 class="text-2xl mb-3 transition-colors" style="color:#002f55;">{channel.name}</h3>
              <p class="leading-relaxed text-[15px] mb-5 flex-grow" style="color:var(--color-muted-foreground);">{channel.description}</p>
              <span class="inline-flex items-center text-sm font-semibold mt-auto group-hover:underline" style={`color:${channel.accentColor};`}>
                Explore {topicCounts[channel.id]} {channel.shortName} Topics
                <ArrowRight className="w-4 h-4 ml-1.5" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Read the Reviews */}
  <section class="py-14 md:py-20 border-t bg-white" style="border-color:var(--color-border);">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-8">
        <h2 class="text-3xl md:text-4xl" style="color:#002f55;">Read the Reviews</h2>
        <div class="mt-2 h-0.5 w-12 mx-auto" style="background-color:#de5b00;"></div>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-center max-w-3xl mx-auto mb-10" style="color:#374151;">
        <p>
          For many years, pastors, evangelists, and missionaries around the world have used these JesusOnline
          articles and videos to clearly present the Gospel, answer tough questions, and disciple people into a
          vibrant relationship with Christ.
        </p>
        <p>Hear what they're saying — read their reviews.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
        {reviewLinks.map(link => (
          <a
            href={join(`/reviews${link.hash}`)}
            class="group flex items-center justify-between bg-white border rounded px-5 py-4 hover:shadow-md transition-all"
            style="border-color:var(--color-border);border-left:4px solid #de5b00;"
          >
            <span class="text-base font-semibold" style="color:#002f55;">{link.label}</span>
            <ArrowRight className="w-4 h-4 shrink-0 ml-3 transition-transform group-hover:translate-x-0.5" style={{ color: "#de5b00" }} />
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
