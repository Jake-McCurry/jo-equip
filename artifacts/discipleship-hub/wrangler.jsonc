{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jo-equip",
  "compatibility_date": "2026-04-23",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
