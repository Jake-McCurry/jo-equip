{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jo-equip",
  "compatibility_date": "2026-04-23",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    /* Serve pages at their no-trailing-slash URL and 301 "/page/" → "/page"
       so the served URL always matches the self-referencing canonical tags,
       sitemap entries, and internal links (site-wide no-slash convention;
       the root "/" is unaffected). Default "auto-trailing-slash" would do
       the OPPOSITE — redirect "/page" → "/page/" for directory-index assets
       — making every canonical point at a redirecting URL. */
    "html_handling": "drop-trailing-slash",
    /* robots.txt and sitemaps must hit the Worker so non-production hosts
       (staging-equip, *.workers.dev, previews) get the blocking robots.txt
       and 404'd sitemaps instead of the production static files. Without
       these entries, matching static assets are served BEFORE the Worker
       and the crawl protection in worker/index.js never runs. */
    "run_worker_first": ["/api/*", "/robots.txt", "/sitemap*"]
  },
  "observability": {
    "enabled": true
  }
}
